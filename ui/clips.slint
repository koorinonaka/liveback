// The クリップ screen (task2980, rebuilt as a tile grid by task3020).
//
// Round18 §1-3 (user ruling, 2026-09-06) threw out the 56px row this file
// opened with: a clip is a finished piece of video, so the thumbnail is the
// thing and everything else rides on top of it. There are no length and size
// columns any more -- neither told two clips apart at a glance -- and the
// comment and the date moved into an overlay burned onto the picture.
//
// Which tiles exist, what every string on them says, and *where each one sits*
// come from Rust (`clips::list` + `ui_state::clips`); this side only places
// them. The placement in particular: a date heading spans the grid's full
// width and pushes everything under it down, and neither running count a tile
// needs for its y -- how many grid lines and how many headings are above it --
// is something a slint `for` can carry.

import { Dark, Tokens } from "tokens.slint";
import { Icons, AppIcon } from "icons.slint";
import { EmptyState, ContextMenu, MenuEntry, AppScroll, InlineEdit, SearchField, ConfirmDialog } from "controls.slint";
import { ClipVm } from "clip_vm.slint";
import { ClipStage } from "clip_stage.slint";

export struct ClipRow {
    // The file name as Explorer shows it -- the export allocator already put
    // the game and the timestamp in it, so there is nothing to rebuild here.
    // Only on hover, in the top overlay: it is how you tell two clips of the
    // same game apart, and not what you look at first.
    name: string,
    // The modification time in the history list's own relative wording
    // (`21:04`, `昨日 23:41`, `8/13 22:05`).
    date: string,
    // What was typed into 「クリップに保存」, read back out of the mp4 itself.
    // Empty means none was written, and the overlay offers to add one.
    comment: string,
    thumbnail: image,
    has-thumbnail: bool,
    // Grid placement, decided by `ui_state::clips::place`.
    column: int,
    line: int,
    // How many date headings stand above this tile, its own included -- so it
    // is 1 on the first group and never 0.
    heading-offset: int,
    // The group's heading, on the group's first tile only.
    heading: string,
    // How many columns and lines this tile covers (task3880, round20 §2-1
    // B案). 1 for every tile but the expanded one.
    span: int,
    // In the selection (t260916-5568). Per tile rather than a list of indices
    // on the pane, so a marquee step rewrites only the tiles it changed.
    selected: bool,
}

// One clip. A 16:9 picture with two gradient overlays on it and no caption
// band: §1-3 is explicit that the band is gone, because a band under every
// tile is a second grid of text competing with the pictures.
component ClipTile inherits Rectangle {
    in property <ClipRow> entry;
    // The pointer is on the tile *or* on the pencil. One flag for both, because
    // the pencil's own TouchArea takes the hover away from the tile's -- the
    // trap task184 hit on the history row, where an `if hovered` deleted the
    // pencil exactly as the pointer reached it.
    in property <bool> hovered;
    in property <bool> editing;
    // "This is the tile you are acting on": the context menu is open over it,
    // or its comment editor is (task3350). Since t260916-5568 the clip screen
    // does have a selection model -- marquee, Ctrl/Shift+click and Ctrl+A,
    // feeding a bulk delete and a bulk 「フォルダで表示」 -- and that state is
    // `selected` below, not this one: a menu or an editor is one tile being
    // acted on right now, a selection is a pile. Both draw the 2px primary
    // edge.
    in property <bool> highlighted;
    // In the selection (t260916-5568). The history tile's look after
    // t260916-a2a3: the 2px primary edge, a 0.20 primary wash and the check
    // badge in the top-right corner.
    in property <bool> selected;
    // Written by the pencil's own TouchArea rather than read off it: the
    // pencil lives inside an `if` subtree, and slint gives no name to an
    // element in one from outside. The pane feeds this back in as `hovered`.
    out property <bool> pen-hovered;
    // Opening the editor destroys the subtree the pencil lives in, and a
    // destroyed element fires no `changed` -- so without this the flag would
    // stay stuck at true and the tile would keep its white edge and its name
    // overlay long after the pointer had left.
    changed editing => {
        root.pen-hovered = false;
    }
    callback edit-requested();
    callback comment-committed(string);
    callback edit-cancelled();

    // `shape-m`, matching the history tile (`sessions_tile.slint`). Round18
    // §4-3 and the mock's `.ctile` (mock/liveback-mock.html:692) both say 4px
    // here; the user's 2026-09-07 report asked for the clip tile to be rounded
    // like the history tile instead, and that instruction wins (task3350).
    // The 4px→6px divergence from the design goes out on task3370's design
    // letter, the same way task3320 handled its own.
    border-radius: Tokens.shape-m;
    background: Tokens.chrome-inset;
    // So the picture takes the tile's rounding.
    clip: true;

    if root.entry.has-thumbnail: Image {
        width: 100%;
        height: 100%;
        source: root.entry.thumbnail;
        // `contain`, not `cover` (user, 2026-09-15): a clip is not 16:9 --
        // the two shapes this app records are 1920x1032 and 1922x1112 (a
        // window's client area, not a screen) -- so cropping to the tile's
        // 16:9 `cell-height` cut the top and bottom off the thumbnail while
        // `ClipStage` drew the same picture letterboxed (`image-fit: contain`
        // there). The expansion animates this thumbnail into that stage, so
        // the two framings have to agree or the handover jumps. The tile's
        // `chrome-inset` ground is the letterbox.
        image-fit: contain;
    }

    // No thumbnail is the ordinary case for a file the shell has not got round
    // to, and for one it cannot read at all. The glyph says "a clip" rather
    // than "an error", because it is not one.
    if !root.entry.has-thumbnail: AppIcon {
        commands: Icons.clips;
        stroke-color: Tokens.color-on-surface-variant;
        size: 22px;
    }

    // The selection wash (t260916-5568). The history tile keeps its 0.20 on
    // the caption band rather than over the picture (task1330: a scrim dims
    // the very thing you are looking at), but a clip tile has no band -- the
    // comment and the date are burned onto the picture (round18 §1-3) -- so
    // the wash goes over the whole tile, under the overlays. At 0.20 it tints
    // rather than hides; the edge and the badge carry the rest of the signal.
    if root.selected: Rectangle {
        width: 100%;
        height: 100%;
        background: Tokens.color-primary.with-alpha(0.20);
    }

    // ---------- top overlay: the file name, on hover only ----------
    if root.hovered: Rectangle {
        y: 0;
        height: 28px;
        background: @linear-gradient(180deg, #000000a8 0%, #00000000 100%);

        Text {
            x: 8px;
            width: parent.width - 16px;
            height: 100%;
            vertical-alignment: center;
            text: root.entry.name;
            overflow: elide;
            font-size: 10.5px;
            // Burned onto the picture, so the dark set even in the light
            // theme -- the same island `sessions_tile.slint` paints its
            // badges on.
            color: Dark.color-on-surface;
        }
    }

    // ---------- bottom overlay: the comment and the date ----------
    Rectangle {
        y: parent.height - self.height;
        height: 30px;
        background: @linear-gradient(180deg, #00000000 0%, #000000c4 100%);

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            alignment: stretch;

            if !root.editing: Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                text: root.entry.comment == "" ? ClipLabels.add-comment : root.entry.comment;
                overflow: elide;
                font-size: 11.5px;
                color: root.entry.comment == ""
                    ? Dark.color-on-surface-variant
                    : Dark.color-on-surface;
            }

            // Mounted and faded rather than put behind an `if` (task184): an
            // `if` on hover deletes the pencil the moment its own TouchArea
            // takes the hover, and the click then falls through to the tile.
            // Since task3890 that stray click expands the tile rather than
            // being half of a double-click into an external player -- a
            // smaller misfire, collapsed by pressing again, but still the
            // wrong thing to do with a press aimed at the comment.
            if !root.editing: Rectangle {
                width: 18px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                border-radius: Tokens.shape-xs;
                opacity: (root.hovered || pen.has-hover) ? 1 : 0;
                background: pen.has-hover ? #ffffff2e : transparent;

                pen := TouchArea {
                    mouse-cursor: pointer;
                    changed has-hover => {
                        root.pen-hovered = self.has-hover;
                    }
                    clicked => {
                        root.edit-requested();
                    }
                }

                AppIcon {
                    commands: Icons.pencil;
                    stroke-color: Dark.color-on-surface;
                    size: 11px;
                }
            }

            // The history screen's editor, unchanged: Enter commits, and Esc
            // or a blur discards (task3430 -- the blur used to commit, see
            // `InlineEdit`). Empty is a legal commit -- it is how a comment is
            // removed.
            //
            // Declared *before* the date below, and that order is load-bearing
            // (task3850): a slint layout places its children in declaration
            // order, so with this block last the date would jump to the left
            // edge the moment the editor opened. Kept here, the date stays the
            // final child in both states and its x is `width - 8px - its own
            // width` either way -- the stretch above absorbs the pencil's 18px
            // and one 6px gap when they go.
            if root.editing: InlineEdit {
                horizontal-stretch: 1;
                // `InlineEdit`'s default 6px inset, i.e. task3850's
                // `text-inset: 0px` reverted (user, 2026-09-15: 「左端の
                // パディングがない」). task3850 spent the 6px to make the first
                // glyph land exactly where the comment `Text` had its own, so
                // opening the editor moved no text -- but with the field's
                // border drawn *inside* its bounds that put the text hard
                // against the stroke, which is what the user is seeing. The
                // trade is now the other way: the text steps 6px right when the
                // editor opens, and the field reads as a field.
                //
                // The third option stays closed. Keeping the glyph at 8px by
                // pulling the box to x = 2px (or trimming the band's padding)
                // puts `InlineEdit`'s 3px focus halo at x = -1px, where this
                // tile's `clip: true` rounding cuts it -- that is why task3850
                // landed on the inset rather than the position, and it is still
                // true.
                // 6px off the tile's bottom rather than centred in the 30px
                // band (task3350). `InlineEdit` draws its focus halo 3px
                // *outside* its own box on purpose, and this tile is the one
                // caller that clips (`clip: true`, for the picture's
                // rounding), so a centred field left the halo 1px of room
                // under it -- flush with the tile's own edge. The 6px puts the
                // halo's lower stroke 3px clear of the edge, and clear of the
                // 2px `highlighted` border as well. The 8px side padding above
                // already leaves 5px, so only this axis was tight.
                //
                // 6px was the mock's number when this was written; it is not any
                // more. task3790's refresh rewrote `.ctile .memoedit.cedit`
                // (`mock/liveback-mock.html:709`) from `bottom:6px` to
                // `bottom:0` with `padding:16px 8px 3px` -- 3px off the tile
                // bottom, not 6. What keeps 6px here is task3350's halo
                // clearance above, not the mock. The 6px-vs-3px divergence is
                // now an open request to the design side rather than an
                // unasked question: `.agents/docs/design/round22-repo-followup.md`
                // §2-(2) (2026-09-09) states that this repo keeps 6px (user
                // decision, same day) and asks the mock to move, with the halo
                // clearance as the reason -- so a bare "make it 3px" would
                // silently break the physics above. The 4px->6px corner one at
                // the top of this file is still unasked.
                y: parent.height - self.height - 6px;
                text: root.entry.comment;
                hint: "Enter";
                init => {
                    self.begin-edit();
                }
                committed(value) => {
                    root.comment-committed(value);
                }
                // Guarded on this tile's own edit state (task3430): a blur
                // cancels now, and the teardown that follows `root.editing`
                // going false delivers one -- by which time the pane may have
                // opened another tile's editor, whose row an unguarded forward
                // would close again.
                cancelled => {
                    if (root.editing) {
                        root.edit-cancelled();
                    }
                }
            }

            // Shown while editing too (task3850). The design side's 2026-09-08
            // correction to round20 §4-(10) is that opening this editor must
            // shift nothing on the tile: the band and the date stay, and only
            // the comment `Text` is swapped for the field above. The pencil is
            // the one thing that goes -- it is the control that opened the
            // editor, and it has nothing left to do while one is open.
            Text {
                vertical-alignment: center;
                text: root.entry.date;
                font-size: 10px;
                color: Dark.color-on-surface-variant;
            }
        }
    }

    // The tile's edge, drawn *over* its contents -- task1330's lesson on the
    // history tile: the picture runs to the tile's own edges and a child paints
    // over its parent's border, so a `border-width` on the root above would be
    // set correctly and invisible. Fill-less, so it takes no clicks.
    Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        // Same `shape-m` as the root above -- both have to move together or
        // the edge stops following the picture's corner.
        border-radius: Tokens.shape-m;
        // The history tile's rule, borrowed whole (`sessions_tile.slint`,
        // task1130): 2px when the tile is the one being acted on, because at
        // 1px it weighed the same as the neutral white hover edge and a tile
        // you had opened a menu on looked like a tile the pointer happened to
        // be over. `highlighted` beats hover, in that order.
        border-width: (root.highlighted || root.selected) ? 2px : 1px;
        border-color: (root.highlighted || root.selected)
            ? Tokens.color-primary
            : (root.hovered ? #ffffff8c : Tokens.chrome-hairline);
    }

    // The check badge (t260916-5568), `sessions_tile.slint`'s own: an 18px
    // primary disc 6px in from the top-right corner. Last, so it sits over the
    // picture, the name overlay and the edge.
    if root.selected: Rectangle {
        x: root.width - self.width - 6px;
        y: 6px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: Tokens.color-primary;

        AppIcon {
            commands: Icons.check;
            stroke-color: Tokens.color-on-primary;
            size: 14px;
            weight: 2.5px;
        }
    }
}

// The strings this pane needs that are not per-row. Pushed from Rust like
// every other label global.
export global ClipLabels {
    in property <string> add-comment;
    in property <string> week;
    in property <string> month;
    in property <string> search-placeholder;
    // The bulk delete's cancel button (t260916-5568), the history dialog's word.
    in property <string> confirm-cancel;
}

// One cell of the 週 / 月 pair. `sessions.slint`'s view toggle in words rather
// than glyphs -- two calendar spans have no icons that read faster than the
// words do.
component GroupToggleCell inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked;

    width: 34px;
    height: 100%;
    background: root.on
        ? Tokens.chrome-selected
        : touch.has-hover ? Tokens.chrome-hover : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Text {
        text: root.label;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 11px;
        color: root.on ? Tokens.color-on-surface : Tokens.color-on-surface-variant;
    }
}

export component ClipsPane inherits Rectangle {
    in property <[ClipRow]> rows;
    // Non-empty replaces the grid with the single 「クリップがありません」 wording
    // (`ui_state::clips::empty`, task3030) -- the missing-folder sentence was
    // dropped since `livia::clips::list` creates the folder itself.
    in property <string> empty-text;
    // The other nothing (task3820): there are clips, and the search box matches
    // none of them. A separate property from `empty-text` on purpose -- the
    // toolbar is gated on that one, so sharing it would take the search field
    // off screen the moment a query stopped matching and leave the text that
    // emptied the grid with no way to be cleared.
    in property <string> filter-empty-text;
    in property <[MenuEntry]> menu-entries;
    in property <bool> menu-open;
    // Which tile the menu belongs to, or -1 (task3350). `menu-open` alone says
    // there is a menu but not what it is acting on, and Rust already holds the
    // index (`Clips::menu`) -- so this is that answer coming back. The
    // selection (t260916-5568) is a separate thing, carried per tile on
    // `ClipRow.selected`.
    in property <int> menu-row: -1;
    // Which tile has its comment editor open, or -1. Same shape as the history
    // pane's `editing-row`; there is only one editable field on a clip, so
    // there is no companion "which field" flag.
    in property <int> editing-row: -1;
    // Whether the headings group by month rather than by week. Week is the
    // default (§1-3), and this is not a setting -- it is which way you are
    // looking at the folder right now.
    in property <bool> month-grouping;
    // ---- the in-grid expansion (task3880, round20 §2-1 B案) ----
    //
    // Which tile is drawn large, or -1. Task3490 held these three on the
    // `ClipLabels` global to keep its own diff to three files; they belong on
    // the pane, and `app.slint` forwards them like every other `clips-*`.
    //
    // Raised by a single click on a tile since task3890, and closed by the
    // same click, by a click on another tile, or by Esc. A tile index, not an
    // entry index: Rust maps its own `Clips::expanded` through the filter on
    // the way out (`clips.rs::render`), so what arrives here is a row of the
    // grid actually on screen.
    in property <int> expanded-row: -1;
    // How many grid lines the placement uses, footprint included
    // (`ui_state::clips::line_count`). Pushed from Rust rather than derived
    // from the last tile: with a footprint the last tile usually is not on the
    // bottom line -- it fills a hole beside the expanded one -- and a
    // `content-height` counted from it would refuse to scroll to the bottom.
    in property <int> grid-lines: 0;
    // ---- the selection (t260916-5568) ----
    //
    // Whether a marquee is being dragged. Rust decides it: a press on a tile
    // becomes one only past `clips_ui::DRAG_THRESHOLD`, and below it the
    // release is a click. Rust sees the press, every move and the release, so
    // telling the two apart does not depend on the order slint fires
    // `pointer-event(up)` and `clicked` in.
    in property <bool> marquee-active;
    // How many clips are selected: Esc clears a selection (after the menu and
    // the expansion have had their turn), and Delete only speaks with one.
    in property <int> selection-count;
    // The delete's confirmation. A non-empty title mounts the dialog --
    // `sessions.slint`'s `confirm-title` rule.
    in property <string> confirm-title;
    in property <string> confirm-lead;
    in property <string> confirm-ok;

    // Tile index, straight from the `for` -- no hit test. The history screen
    // needs one because a marquee drag has to resolve arbitrary coordinates to
    // rows; a grid whose tiles each own their TouchArea already knows.
    callback row-menu-requested(int);
    callback row-edit-requested(int);
    callback menu-selected(int);
    callback menu-dismissed();
    callback grouping-changed(bool);
    // A press that should expand or collapse one tile (task3880). Raised by
    // the tile's own click, by the raised copy's, and by Esc (task3890); the
    // state transition behind it is `ui_state::clips::toggle_expanded`, which
    // is why all three send a tile index rather than each deciding the new
    // state for itself.
    callback row-expand-toggled(int);
    // Every keystroke: the filter runs in Rust over the list already in hand,
    // so there is nothing to debounce (task3820).
    callback search-changed(string);
    // No row index: Rust already holds which file the editor was opened on and
    // commits to *that*, because a re-scan can have moved the tile underneath
    // (task2990). An index sent from here would only be a second, staler
    // answer to a question already settled.
    callback comment-committed(string);
    callback edit-cancelled();
    // (first row, count) for the tiles on screen, so the worker fetches a
    // comment and a thumbnail for those and not for all of them (the same rule
    // task188 set for session thumbnails).
    callback visible-range-changed(int, int);
    // The press, the drag and the release behind the selection
    // (t260916-5568). Coordinates are the grid's own content space -- the one
    // `ui_state::clips::tile_rects` builds its rectangles in -- and the cell
    // size goes along because it is derived here, from the pane's width.
    //   tile-pressed(tile, x, y, cell-width, cell-height, shift, ctrl)
    //   ground-pressed(x, y, cell-width, cell-height, shift, ctrl)
    callback tile-pressed(int, length, length, length, length, bool, bool);
    callback ground-pressed(length, length, length, length, bool, bool);
    callback pointer-moved(length, length);
    callback pointer-released();
    callback delete-selected();
    callback select-all();
    callback selection-cleared();
    callback confirm-accepted();
    callback confirm-cancelled();

    // Where the marquee started and where the pointer is now, in the grid's
    // content space. Written by whichever TouchArea took the press.
    property <length> marquee-x0;
    property <length> marquee-y0;
    property <length> marquee-x1;
    property <length> marquee-y1;

    // The content face in app.slint is this pane's ground; a second
    // 85 % layer here would make it opaque (t260916-ebdb).
    background: transparent;

    // §1-3: four columns, 14x12 gaps, 12px of padding.
    property <int> columns: 4;
    property <length> gap-x: 14px;
    property <length> gap-y: 12px;
    // The grid's side padding, and the two vertical ones it no longer shares
    // with them (task3820, design 2026-09-08).
    property <length> pad: 12px;
    // Zero, because the air under the 週/月 bar now belongs to the *bar*: it
    // was the grid's own top padding, which scrolls away with the grid -- so
    // scrolling brought the first row up flush against a bar that does not
    // move. The mock spells the same total out as 10px on `.cliptools` plus
    // 2px on `.cliptiles`; this is 12px on the toolbar and none here, which
    // keeps the toolbar's geometry identical to the history screen's.
    property <length> pad-top: 0px;
    // 24px under the last row (`.cliptiles`'s `padding: 2px 12px 24px`): a grid
    // whose last line ends exactly at the panel's bottom edge reads as cut
    // off (the footer that used to sit there left the pane in t260919-ee8c).
    property <length> pad-bottom: 24px;
    // The extra 12px is `AppScroll.lane`, which the scroll view reserves for
    // its own track whether or not there is anything to scroll. Deriving the
    // cell width from the pane's width without taking it off puts the fourth
    // column's right edge exactly on the track (`sessions.slint:124` subtracts
    // the same three twelves for the same reason).
    property <length> cell-width:
        (root.width - 2 * root.pad - 12px - (root.columns - 1) * root.gap-x) / root.columns;
    property <length> cell-height: Math.max(0px, root.cell-width * 9 / 16);
    property <length> row-pitch: root.cell-height + root.gap-y;
    // A heading is 18px of text with 8px of air under it.
    property <length> heading-height: 18px;
    property <length> heading-pitch: root.heading-height + 8px;

    // The last tile carries the heading total: its heading-offset is how many
    // groups there are, and it is in the last group whatever the footprint
    // does to the lines.
    property <int> last: Math.max(0, root.rows.length - 1);
    // The line total is *not* read off it any more (task3880). It used to be
    // `rows[last].line + 1`, which holds only while every tile is 1x1: with a
    // footprint the last tile fills a hole beside the expanded one and sits
    // above the bottom line, so that expression undercounts and the grid stops
    // scrolling short of its own end. `line-count` now comes from Rust, where
    // `ui_state::clips::line_count` takes the max of `line + span`.
    property <int> line-count: root.grid-lines;
    property <int> heading-count:
        root.rows.length == 0 ? 0 : root.rows[root.last].heading-offset;
    property <length> content-height: root.pad-top + root.pad-bottom
        + root.line-count * root.row-pitch - (root.line-count > 0 ? root.gap-y : 0px)
        + root.heading-count * root.heading-pitch;

    // How long a cell takes to reach its new rectangle (task3880). 260ms is
    // round20 §1's 0.26s; the animation itself is the whole of B案's motion,
    // since `place` moves every neighbour and the cells simply follow.
    //
    // A property rather than a literal on each `animate`, because the duration
    // has to be *zero* when nothing is expanding. A cell's x and width come off
    // `root.cell-width`, which comes off the pane's width, so an unconditional
    // tween would make the tiles slide on every window resize and on every
    // 週/月 switch -- both of which snap today and must keep snapping. This is
    // the trap task3490 recorded: it does not need an expansion to show up, so
    // "the placement is identical" alone would not have caught it.
    //
    // `settling` is what keeps the *collapse* animated. On the frame
    // `expanded-row` goes back to -1 the placement has already changed, so a
    // gate reading `expanded-row >= 0` alone would evaluate 0ms and snap the
    // tiles home while the raised copy was still fading -- round20 §1 asks for
    // 「閉じるときは逆再生」. `settling` runs 1 -> 0 across the same 260ms, so
    // it is still non-zero on that frame and 0 whenever nothing has been
    // expanded at all.
    property <float> settling: root.expanded-row >= 0 ? 1 : 0;
    animate settling {
        duration: 260ms;
        easing: ease-in-out;
    }
    // `settling` is read *first* on purpose. With `expanded-row >= 0` in front,
    // `||` short-circuits and nothing reads `settling` while a tile is open --
    // and in that shape the collapse snapped on the real app (2026-09-13:
    // 1091px -> 706px inside 36ms, while the expansion took the full 260ms),
    // which is exactly what task3880 added `settling` to prevent. Reading it on
    // every evaluation of `tween` fixes it (same measurement: ~280ms). The
    // *why* is consistent with what t260916-fa85 pinned down for the raised
    // copy below (KNOWLEDGE.md, "an animated property nobody reads"): an
    // `animate`d binding that is not read when its input changes stays armed
    // from that first change and skips every later one, so read for the first
    // time on the collapse it compares against the value it last computed
    // (still 0, from before the open), sees no change, and answers 0.
    //
    // Asymmetric since 2026-09-13 (user ruling「立ち上がり速く、終わり長く」):
    // opening takes `expand-ms` and closing `collapse-ms`, because a collapse
    // that takes as long as the expansion reads as the app being slow to let
    // go. `settling` stays read first for the reason above -- the `||` is what
    // keeps it evaluated on every frame, and the inner branch only picks the
    // number.
    property <duration> tween:
        (root.settling > 0.001 || root.expanded-row >= 0)
            ? (root.expanded-row >= 0 ? root.expand-ms : root.collapse-ms)
            : 0ms;
    property <duration> expand-ms: 300ms;
    // Shorter than `settling`'s own 260ms on purpose: the gate has to outlast
    // the motion it is gating, or `tween` would fall to 0ms mid-collapse and
    // snap the tiles home.
    property <duration> collapse-ms: 220ms;

    // Which tile the pointer is over -- latched, rather than read straight off
    // a TouchArea's `has-hover` (2026-09-13 report: the tile's name band blinks
    // out when the tile is expanded, and again the instant it collapses).
    //
    // slint settles `has-hover` on pointer *movement*. An expansion swaps the
    // tile the cursor is over for a different element (the raised copy below,
    // and back again on the collapse) without the pointer moving a pixel, so on
    // each swap the element that is now under the cursor reads false and the
    // band disappears until the mouse is jogged. The latch survives the swap:
    // an entry claims it, and a leave only clears it while nothing is moving --
    // so the last thing the pointer actually moved onto keeps the band, and the
    // next real movement corrects it.
    //
    // t260916-0a58 widened it from "the tiles moved" to "something was put
    // under the pointer", because three things do that and all three read as a
    // leave: the context menu (mounted with its corner *on* the press point),
    // the comment editor (it replaces the pencil the pointer is on), and the
    // pencil itself (a TouchArea above the tile's own). The release branch in
    // each tile's `touch` below carries the terms. What that costs is a latch
    // nothing can release: after a menu episode the tile's `has-hover` is
    // false, so walking off the tile fires no `changed` at all -- hence the
    // ground TouchArea inside the scroll view doubles as the "the pointer is on
    // bare ground now" sensor, and is kept mounted while this latch holds.
    property <int> hover-row: -1;
    // The gate on that clearing: true from the press until the collapse has
    // finished settling, which is exactly when a `has-hover` going false says
    // "the tiles moved" rather than "the pointer left".
    property <bool> tile-motion: root.settling > 0.001 || root.expanded-row >= 0;
    // The curve every tile moves on is `Tokens.motion-curve`, read by the two
    // `animate` blocks below (the third, `animate raise`, is `ease-in-out` and
    // stays there). It lives in `tokens.slint` since t260914-f561: `easing` is
    // a property type, at the cost of one build warning because it cannot be
    // exposed as public API -- see the comment on the token.
    //
    // It is the mock's own curve, already carrying the titlebar slide
    // (`app.slint`, round22 / task4370). `ease-in-out` (cubic-bezier(0.42, 0,
    // 0.58, 1)) is what read as 「気持ちよくない」: it spends its first third
    // barely moving, so the grid looks like it is deciding whether to answer
    // the press. This one is off the mark at once and takes its time at the
    // end instead.

    // Where the right-click menu goes, in the pane's own coordinates. Written
    // by the tile that was pressed, because only inside the scroll view are the
    // two offsets that turn a tile-local press into pane coordinates in scope
    // (task1400 learned this on the history screen).
    property <length> menu-px;
    property <length> menu-py;

    // Esc closes the expansion (round20 §3, task3890). A `FocusScope` because
    // only a focusable element is handed key events and this pane had none.
    //
    // Declared first of all, so it sits under every other hit target: a
    // `FocusScope` with `focus-on-click` *consumes* the press it focuses on,
    // so mounted any later it would eat the ground TouchArea's menu dismiss
    // below. Down here it takes the presses nothing else wanted, which is
    // exactly when the key focus should come back to the pane.
    //
    // It writes nothing itself -- `expanded-row` is an `in` property -- so Esc
    // leaves through the same `row-expand-toggled` a click does, and
    // `ui_state::clips::toggle_expanded` collapses it because the row pressed
    // equals the row already open. One scope for the pane, not one per
    // purpose: task3520 needs Esc for the same expansion and extends this
    // rather than adding a second.
    keys := FocusScope {
        width: 100%;
        height: 100%;

        // Nothing else hands a fresh FocusScope the key focus, and the pane is
        // instantiated on every entry to クリップ (`app.slint` gates it on
        // `active-pane`), so without this Esc stays dead until the user
        // happens to click the background.
        init => {
            self.focus();
        }

        // The comment editor takes the focus and slint hands it to nobody when
        // the field tears down -- task4190 measured that exact hole on the
        // review pane, where the shortcuts stayed dead until the stage was
        // clicked. The false edge only: on the true edge this would take back
        // the focus the field has just claimed and blur it in the same frame.
        property <bool> editing: root.editing-row >= 0;
        changed editing => {
            if (!self.editing) {
                self.focus();
            }
        }

        // And claim it whenever something actually expands, because the search
        // field keeps the focus once it has been typed in: a `TouchArea` takes
        // none, so clicking a tile would leave the field holding it, and
        // slint's `TextInput` swallows Esc rather than letting an ancestor see
        // it (`controls.slint`'s task4130 note measured exactly that). True
        // edge only -- on the collapse there is nothing left for Esc to close.
        property <bool> expanded: root.expanded-row >= 0;
        changed expanded => {
            if (self.expanded) {
                self.focus();
            }
        }

        key-pressed(event) => {
            // The menu first, as on the history screen: Esc is the one key
            // every menu answers to. The order t260916-5568 needs is menu,
            // editor, expansion, selection -- and the editor needs no branch
            // here, because `InlineEdit` holds the focus and answers Esc
            // itself.
            if (event.text == Key.Escape && root.menu-open) {
                root.menu-dismissed();
                return EventResult.accept;
            }
            if (event.text == Key.Escape && root.expanded-row >= 0) {
                root.row-expand-toggled(root.expanded-row);
                return EventResult.accept;
            }
            if (event.text == Key.Escape && root.selection-count > 0) {
                root.selection-cleared();
                return EventResult.accept;
            }
            // Before the transport keys below, which have no use for either.
            if (event.text == Key.Delete && root.selection-count > 0) {
                root.delete-selected();
                return EventResult.accept;
            }
            // Every clip the search leaves on the grid.
            if (event.modifiers.control && (event.text == "a" || event.text == "A")) {
                root.select-all();
                return EventResult.accept;
            }
            // The transport keys, after Esc so closing the expansion keeps
            // priority (t260916-956e). Rust answers false for a key it has no
            // operation for, and that press stays rejected -- the gate on
            // `ClipVm.open` is the engine's own, so nothing is asked while the
            // grid is merely scrolled.
            if (ClipVm.open && ClipVm.key-pressed-cb(event.text)) {
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }

    // Declared under everything but the key scope above, so only the bare
    // ground between the controls falls through to here and closes the menu -- and, since
    // task3430, ends an open comment edit as well. Both on the same area
    // because both are "the click landed somewhere that is not this popup /
    // this field"; the gate carries both so no hit target sits here when
    // neither is up.
    if root.menu-open || root.editing-row >= 0 || root.expanded-row >= 0: TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (root.menu-open) {
                    root.menu-dismissed();
                }
                if (root.editing-row >= 0) {
                    root.edit-cancelled();
                }
                // The collapse only when the press was not already spoken for:
                // a click that closes a menu or ends an edit has said what it
                // came to say, and taking the expansion down with it would
                // make one click do two things (user ruling 2026-09-13:
                // 「領域外をクリックしたら拡大を戻す」).
                if (!root.menu-open && root.editing-row < 0 && root.expanded-row >= 0) {
                    root.row-expand-toggled(root.expanded-row);
                }
            }
        }
    }

    VerticalLayout {
        // ---------- the toolbar: search left, 週 / 月 right ----------
        //
        // The mock's `.cliptools` (round20 §9, and the design's 2026-09-08
        // note on it): a fixed bar that carries its own bottom padding, so
        // that the gap between it and the first row does not scroll away.
        //
        // Gated on `empty-text`, not on `filter-empty-text`: a folder with no
        // clips has nothing to search, but a query that matched none of them
        // has to keep the field that holds the query.
        if root.empty-text == "": HorizontalLayout {
            padding: 12px;
            // 24px, not the mock's 12 (ユーザー指摘 2026-09-13). round22
            // (task4370) took the 32px title bar out of the vertical stack, so
            // this field, which used to sit 12px *below the bar*, now sits 12px
            // below the window's own top edge -- which is where the bar slides
            // back over it on the way to the hot zone. 24 is the user's own
            // number: it does not clear the 33px the revealed bar covers and is
            // not meant to, it buys back the breathing room the bar used to give.
            padding-top: Tokens.space-6;
            spacing: Tokens.space-2;

            // The history screen's field, the same one the target picker uses
            // -- task3810's shared `SearchField`, whose whole point is that a
            // third copy is not written. No `plate`: that is the picker's
            // light-theme-only override (round16 §3-1). It carries
            // `horizontal-stretch: 1` itself, which is what keeps the 68px
            // switch beside it from being pushed anywhere as the window grows.
            SearchField {
                placeholder: ClipLabels.search-placeholder;
                search-changed(text) => {
                    root.search-changed(text);
                }
            }

            Rectangle {
                width: 68px;
                // 26px, not `control-height-s`: the mock's `.viewtg` is 26
                // against a 30px `.search`, and history's toggle already
                // carries that (`sessions.slint`). Matching the field's height
                // here made this switch 2px taller than history's -- an
                // unlisted third deviation from `.cliptools`, on top of the
                // two round22-repo-report §3 owns. The `y` is the same
                // centering history needs: a fixed-height child of a
                // HorizontalLayout sits at the top of the row otherwise.
                height: 26px;
                y: (parent.height - self.height) / 2;
                // Stays `shape-s` on purpose: this is the 週/月 switch, a
                // control, not a tile. Task3350 moved the *tiles* to `shape-m`
                // to match the history grid; chrome controls keep the small
                // radius the rest of the app's buttons use.
                border-radius: Tokens.shape-s;
                border-width: 1px;
                border-color: Tokens.chrome-hairline;
                clip: true;

                HorizontalLayout {
                    GroupToggleCell {
                        label: ClipLabels.week;
                        on: !root.month-grouping;
                        clicked => {
                            root.grouping-changed(false);
                        }
                    }

                    GroupToggleCell {
                        label: ClipLabels.month;
                        on: root.month-grouping;
                        clicked => {
                            root.grouping-changed(true);
                        }
                    }
                }
            }
        }

        // `.clipempty` (`mock/liveback-mock.html:719-724`, 1106-1109) is what
        // `EmptyState` now draws for everyone (task3800), so there is nothing
        // to opt into here any more -- task3330's `plain` flag is gone with
        // the frame it used to turn off. One line and no `sub`: the mock's
        // clips entry is a title alone.
        if root.empty-text != "": EmptyState {
            vertical-stretch: 1;
            icon: Icons.clips;
            label: root.empty-text;
        }

        // The search found nothing (task3820). Same `EmptyState` as above --
        // task3800's whole point -- with the picker's own choice of glyph for
        // this case (`empty-is-filter` in `picker_modal.slint`): the magnifier
        // says "your query", where the clip glyph would say "your folder" and
        // send the user to look for missing files. No `action` to clear it
        // with, because unlike the picker's modal the field itself is still on
        // screen right above this, with its own X on it.
        if root.empty-text == "" && root.filter-empty-text != "": EmptyState {
            vertical-stretch: 1;
            icon: Icons.search;
            label: root.filter-empty-text;
        }

        if root.empty-text == "" && root.filter-empty-text == "": scroll := AppScroll {
            vertical-stretch: 1;
            // Flush against the client's right edge -- see `settings.slint`
            // (task4320). `cell-width` above keeps its bare 12px for the same
            // reason the history grid does: the tiles stay where they are, and
            // only the padding that trailed them narrows.
            right-inset: Tokens.resize-band-inset;
            viewport-width: scroll.visible-width;
            viewport-height: Math.max(root.content-height, scroll.visible-height);
            // Only for the nudge below (task3880), which is why it carries the
            // same gate the cells do: at rest `tween` is 0ms, so the wheel
            // still moves the view on the frame it is turned -- `AppScroll`'s
            // own handler exists to keep that immediate, and an unconditional
            // animation here would put slint's easing back on top of it.
            //
            // Handed to `AppScroll` rather than written here as an `animate
            // viewport-y`, which is what this was until 2026-09-13 and never
            // fired: `viewport-y` on this element is a two-way alias (`<=>`) of
            // the inner Flickable's, and an `animate` on the alias is not the
            // animation of the property it names. Measured: the heading was
            // already at its final y 60ms after the press while the tile was a
            // third of the way open.
            scroll-tween: root.tween;

            grid := Rectangle {
                x: 0;
                y: 0;
                width: scroll.visible-width;
                height: Math.max(root.content-height, scroll.visible-height);
                background: transparent;
                // The mock's `.cliptiles { overflow-x: hidden }` (design's
                // 2026-09-08 note): nothing here is meant to reach past the
                // grid's own width, and a tile that did on some rounding of
                // `cell-width` would arm a horizontal scrollbar over a grid
                // whose columns are fixed at four.
                clip: true;

                // The window, reported so the detail queue can follow it.
                // `viewport-y` goes negative as the view scrolls down, hence
                // the sign.
                //
                // Headings push tiles *down*, so dividing the scroll offset by
                // the tile pitch alone overestimates which line is at the top
                // and the queue would miss rows the user is looking at. The
                // whole heading budget comes off first, which makes this a
                // lower bound: it over-fetches by at most one screenful of
                // groups, and never under-fetches.
                property <int> first-line: Math.max(
                    0,
                    Math.floor(
                        (-scroll.viewport-y - root.pad-top
                            - root.heading-count * root.heading-pitch) / root.row-pitch),
                );
                property <int> first-visible: self.first-line * root.columns;
                property <int> visible-count:
                    (Math.ceil(scroll.visible-height / root.row-pitch) + 2) * root.columns;

                // ---- scrolling an expansion into view (task3880) ----
                //
                // This arithmetic is in `.slint` rather than in
                // `src/ui_state/`, which is where the README puts UI logic,
                // and the exception is deliberate: every input is a pixel Rust
                // does not have. `cell-height` is derived here from the pane's
                // own width (see `cell-width` above), and Rust knows only
                // `COLUMNS` -- so answering this in `ui_state` would mean
                // pushing the pane's geometry out and the answer back, three
                // hops for a sum. What Rust *can* be tested on is the
                // placement, and it is (`ui_state::clips::place`).
                //
                // On `grid` rather than on `root`, because `scroll` lives
                // inside an `if` and slint gives no name to an element in one
                // from outside (task3800 measured the same wall). `expanded`
                // is the pane's property mirrored here so `changed` can be
                // declared where `scroll` is in scope.
                property <int> expanded: root.expanded-row;
                // Clamped so the model is never indexed out of range while
                // nothing is expanded; the handler below is what gates on the
                // real value.
                property <int> expanded-row-safe: Math.clamp(root.expanded-row, 0, root.last);
                property <length> expanded-top: root.pad-top
                    + root.rows[grid.expanded-row-safe].line * root.row-pitch
                    + root.rows[grid.expanded-row-safe].heading-offset * root.heading-pitch;
                property <length> expanded-bottom: grid.expanded-top
                    + root.rows[grid.expanded-row-safe].span * root.cell-height
                    + (root.rows[grid.expanded-row-safe].span - 1) * root.gap-y;

                changed expanded => {
                    if (grid.expanded >= 0) {
                        // Below the window: send the view down until the two
                        // bottom edges meet. `viewport-y` goes negative as the
                        // view scrolls down, hence the signs.
                        if (grid.expanded-bottom > -scroll.viewport-y + scroll.visible-height) {
                            scroll.viewport-y = Math.clamp(
                                scroll.visible-height - grid.expanded-bottom,
                                -scroll.overflow, 0px);
                        }
                        // Above the window: bring it back until the two top
                        // edges meet. Second, so that a footprint taller than
                        // the viewport ends up showing its head rather than
                        // its feet -- after the send above, the only way to
                        // still be over the top edge.
                        if (grid.expanded-top < -scroll.viewport-y) {
                            scroll.viewport-y = Math.clamp(
                                -grid.expanded-top, -scroll.overflow, 0px);
                        }
                        // A tile already inside the window is not moved: no
                        // assignment on either path leaves `viewport-y` alone.
                    }
                    // And neither is a *collapse* (`expanded` back to -1),
                    // which is round20 §3's 「閉じたときグリッドのスクロール
                    // 位置は保つ」.
                }

                changed first-visible => {
                    root.visible-range-changed(self.first-visible, self.visible-count);
                }
                changed visible-count => {
                    root.visible-range-changed(self.first-visible, self.visible-count);
                }

                // The menu's second closer, inside the scroll view. The pane's
                // own ground TouchArea (declared at the top of `root`) never
                // sees these presses: `AppScroll` is a Flickable and swallows
                // the pointer events over its own area, so only the chrome
                // *outside* it reached that one. This covers the rest -- the
                // grid's padding, the gaps between tiles, the date headings,
                // and the empty space below the last row.
                //
                // Declared *before* the `for` below, so it sits underneath
                // every tile: a press on a tile still goes to that tile's own
                // `touch`, which keeps the left-down close and the right-down
                // re-target working exactly as before.
                //
                // Gated on there being a menu to close or an edit to end, so no
                // extra hit target sits over the grid the rest of the time
                // (the `|| editing-row` half is task3430's). The
                // `|| hover-row >= 0` half is t260916-0a58's: this area is also
                // the hover sensor below, and the latch it corrects outlives
                // every one of the three states above. It means the area is
                // mounted whenever the pointer is over a tile, and that its own
                // `changed has-hover` unmounts it when nothing else holds it --
                // slint re-evaluates an `if` on the next update pass, not inside
                // the callback, the same way choosing a `ContextMenu` row
                // destroys the row's own TouchArea.
                //
                // Always mounted since t260916-5568: this is also where a
                // marquee starts from empty space, and a press cannot land on
                // an `if` that is not there. So the self-unmount described
                // above no longer happens. Nothing depended on it: the `changed
                // has-hover` sensor below reads the same whether the area was
                // just mounted or has been there all along, and a bare-ground
                // press with nothing open, which used to fall through to
                // nothing, now clears the selection or starts a marquee.
                ground := TouchArea {
                    width: 100%;
                    height: 100%;
                    // "The pointer is on bare ground now" (t260916-0a58). A
                    // tile cannot report its own leave once a menu or an editor
                    // has taken its `has-hover`: the flag is already false, so
                    // the pointer walking off fires no `changed` and the latch
                    // would sit on a tile the pointer has left. This area is
                    // under every tile and covers what is not one -- the grid's
                    // padding, the gaps, the headings, the space below the last
                    // row -- so its hover going *true* is that leave, reported
                    // by the only element that can see it.
                    //
                    // Gated on `tile-motion` for the same reason the tiles' own
                    // release is: while the grid animates, tiles slide out from
                    // under a pointer that never moved, and the ground taking
                    // the hover then says the tiles moved, not that the pointer
                    // left (the 2026-09-13 latch this all belongs to).
                    changed has-hover => {
                        if (self.has-hover && !root.tile-motion) {
                            root.hover-row = -1;
                        }
                    }
                    // `pointer-event`, not `clicked`: `clicked` is left-button
                    // only and fires on release, while the menu should go on
                    // the press -- the same reasoning as the pane's ground
                    // TouchArea and the `surface` one in `sessions.slint`.
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            if (root.menu-open) {
                                root.menu-dismissed();
                            }
                            if (root.editing-row >= 0) {
                                root.edit-cancelled();
                            }
                            // Same one-thing-per-click rule as the pane's own
                            // ground area above. This is the copy that matters
                            // for 「領域外をクリックしたら拡大を戻す」: the
                            // Flickable swallows every press over the grid, so
                            // the gaps, the headings and the space below the
                            // last tile only ever reach *this* one.
                            if (!root.menu-open && root.editing-row < 0 && root.expanded-row >= 0) {
                                root.row-expand-toggled(root.expanded-row);
                            }
                        }
                        // The selection (t260916-5568): a left press on bare
                        // ground clears it -- unless Ctrl adds to it -- and
                        // arms a marquee from this point.
                        if (event.kind == PointerEventKind.down
                            && event.button == PointerEventButton.left) {
                            keys.focus();
                            root.marquee-x0 = ground.mouse-x;
                            root.marquee-y0 = ground.mouse-y;
                            root.marquee-x1 = ground.mouse-x;
                            root.marquee-y1 = ground.mouse-y;
                            root.ground-pressed(
                                ground.mouse-x,
                                ground.mouse-y,
                                root.cell-width,
                                root.cell-height,
                                event.modifiers.shift,
                                event.modifiers.control,
                            );
                        }
                        if ((event.kind == PointerEventKind.up
                                && event.button == PointerEventButton.left)
                            || event.kind == PointerEventKind.cancel) {
                            root.pointer-released();
                        }
                    }
                    moved => {
                        if (ground.pressed) {
                            root.marquee-x1 = ground.mouse-x;
                            root.marquee-y1 = ground.mouse-y;
                            root.pointer-moved(ground.mouse-x, ground.mouse-y);
                        }
                    }
                }

                // ponytail: every tile is instantiated, unlike the history grid
                // (task181), because a clip folder is a handful of finished
                // files rather than the hundreds of sessions a ring buffer
                // accumulates. Port the windowed `for` from `sessions.slint` if
                // a folder ever gets big enough to feel it.
                for entry[index] in root.rows: cell := Rectangle {
                    // The two running counts Rust computed: grid lines above,
                    // and headings above.
                    property <length> top: root.pad-top
                        + entry.line * root.row-pitch
                        + entry.heading-offset * root.heading-pitch;

                    x: root.pad + entry.column * (root.cell-width + root.gap-x);
                    y: cell.top;
                    // task3880: a footprint of `span` cells plus the gaps it
                    // swallows, so an expanded tile lands exactly on the grid
                    // it displaced. `span` is 1 on every tile but the expanded
                    // one.
                    width: entry.span * root.cell-width + (entry.span - 1) * root.gap-x;
                    height: entry.span * root.cell-height + (entry.span - 1) * root.gap-y;
                    animate x, y, width, height {
                        duration: root.tween;
                        easing: Tokens.motion-curve;
                    }

                    // z-order, task3490's trap. A `for` draws later cells over
                    // earlier ones, so an expanded tile with a low index would
                    // grow *underneath* the tiles after it. `z: index ==
                    // root.expanded-row ? 1 : 0` is what this wants to be and
                    // slint 1.17 refuses it (`'z' must be an number literal`),
                    // so the raised copy in the second `for` below is what
                    // actually draws the expanded tile. This one keeps the
                    // geometry, the TouchArea and the heading.
                    //
                    // 1 while the expansion is on *and* for the 260ms of the
                    // collapse, so the hand-back to this cell happens after the
                    // motion rather than at its start -- a plain flag would
                    // drop the shrinking tile back under its neighbours for the
                    // whole way down.
                    property <float> raise: index == root.expanded-row ? 1 : 0;
                    animate raise {
                        duration: 260ms;
                        easing: ease-in-out;
                    }

                    // Declared *before* the tile, so it sits underneath it. A
                    // TouchArea on top would swallow every click aimed at the
                    // open comment editor and at the pencil. The layer is
                    // unchanged by task3890; what changed is the second half of
                    // the reason -- a press that leaked through used to open
                    // the mp4 in an external player, whose handle was then what
                    // the pending `write_comment` failed on (task3360), and
                    // nothing on this tile opens a player any more. (Same
                    // layering `sessions_tile.slint` uses.)
                    touch := TouchArea {
                        mouse-cursor: pointer;
                        // Claims the latch on the way in; releases it on the way
                        // out only when the pointer really left -- see
                        // `hover-row` at the top of the pane. The three terms
                        // past `tile-motion` are t260916-0a58's three thieves:
                        // the menu mounted on the press point, the comment
                        // editor, and the pencil above this area. Each takes
                        // `has-hover` while the pointer stands still, and slint
                        // settles it back on movement only -- so releasing here
                        // would blank the name band and the pencil until the
                        // mouse was jogged, which is exactly the 2026-09-16
                        // report.
                        changed has-hover => {
                            if (self.has-hover) {
                                root.hover-row = index;
                            } else if (!root.tile-motion && !root.menu-open
                                    && root.editing-row < 0 && !tile.pen-hovered
                                    && root.hover-row == index) {
                                root.hover-row = -1;
                            }
                        }
                        // A single click expands the tile -- which *is*
                        // playing it: in B案 the expanded tile is the playback
                        // surface (task3520 puts the stage in it). Round20
                        // design response §6, user ruling 2026-09-08:
                        // 「シングルクリックで再生に変えてよい」, with no
                        // second meaning (no selection) on the same click --
                        // which t260916-5568 keeps for the *plain* click.
                        // Ctrl and Shift select instead, and a press that
                        // travels past the drag threshold is a marquee.
                        //
                        // No `clicked` any more: it fires on any press and
                        // release inside the area however far the pointer went
                        // in between, so a marquee that began and ended on this
                        // tile would also have expanded it. Rust sees the
                        // press, every move and the release, and decides which
                        // of the three it was. The right button still opens the
                        // menu on its press, below.
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down
                                && event.button == PointerEventButton.left
                                && root.menu-open) {
                                root.menu-dismissed();
                            }
                            // task3430. The tile's picture is outside the
                            // comment field even on the tile being edited --
                            // the editor is a 22px strip in the bottom band and
                            // keeps its own presses -- so no index check here:
                            // any left press on any tile ends the edit.
                            if (event.kind == PointerEventKind.down
                                && event.button == PointerEventButton.left
                                && root.editing-row >= 0) {
                                root.edit-cancelled();
                            }
                            if (event.kind == PointerEventKind.down
                                && event.button == PointerEventButton.right) {
                                // Before the callback, not after: Rust answers
                                // it by setting `menu-open`, which is what
                                // instantiates the menu that reads these.
                                keys.focus();
                                root.menu-px = scroll.x + scroll.viewport-x + cell.x + touch.mouse-x;
                                root.menu-py = scroll.y + scroll.viewport-y + cell.y + touch.mouse-y;
                                root.row-menu-requested(index);
                            }
                            if (event.kind == PointerEventKind.down
                                && event.button == PointerEventButton.left) {
                                keys.focus();
                                root.marquee-x0 = cell.x + touch.mouse-x;
                                root.marquee-y0 = cell.y + touch.mouse-y;
                                root.marquee-x1 = root.marquee-x0;
                                root.marquee-y1 = root.marquee-y0;
                                root.tile-pressed(
                                    index,
                                    root.marquee-x0,
                                    root.marquee-y0,
                                    root.cell-width,
                                    root.cell-height,
                                    event.modifiers.shift,
                                    event.modifiers.control,
                                );
                            }
                            if ((event.kind == PointerEventKind.up
                                    && event.button == PointerEventButton.left)
                                || event.kind == PointerEventKind.cancel) {
                                root.pointer-released();
                            }
                        }
                        // A pressed TouchArea keeps the pointer: moves keep
                        // arriving after it leaves the tile, with `mouse-x/y`
                        // outside the tile's own bounds -- which `cell.x/y`
                        // turn back into grid coordinates.
                        moved => {
                            if (touch.pressed) {
                                root.marquee-x1 = cell.x + touch.mouse-x;
                                root.marquee-y1 = cell.y + touch.mouse-y;
                                root.pointer-moved(root.marquee-x1, root.marquee-y1);
                            }
                        }
                    }

                    tile := ClipTile {
                        width: 100%;
                        height: 100%;
                        // Handed over to the raised copy below for as long as
                        // the expansion lasts (task3880). The two are bound to
                        // the same geometry, so the swap is invisible.
                        visible: cell.raise < 0.001;
                        entry: entry;
                        hovered: touch.has-hover || tile.pen-hovered
                            || root.hover-row == index;
                        // Never while this tile is the one expanded: the
                        // playback surface draws the comment band then, with the
                        // same `InlineEdit` in it (task3520). `visible: false`
                        // does not stop an element from being *built*, so two
                        // fields would mount, both call `begin-edit()`, and both
                        // push their rect into `InlineEditVm` -- which is what
                        // the window overlay (task3640) cuts its hole from. The
                        // handover is clean at the edges: on the collapse
                        // `expanded-row` is already -1 while `ClipVm.open` has
                        // gone false, so exactly one of the two is ever mounted.
                        editing: root.editing-row == index && index != root.expanded-row;
                        highlighted: root.menu-row == index || root.editing-row == index;
                        selected: entry.selected;
                        edit-requested => {
                            root.row-edit-requested(index);
                        }
                        comment-committed(value) => {
                            root.comment-committed(value);
                        }
                        edit-cancelled => {
                            root.edit-cancelled();
                        }
                    }

                    // The pencil claims the latch too (t260916-0a58). It is a
                    // TouchArea above `touch`, so reaching it takes the body's
                    // `has-hover` away, and clicking it then destroys the pencil
                    // and resets `pen-hovered` (`ClipTile`'s `changed editing`,
                    // which has to, or the flag would stick true forever) --
                    // leaving `hovered` with nothing true and the band gone for
                    // the whole edit and after it. Latched here instead, the
                    // tile the pencil belongs to keeps it through the editor's
                    // mount and unmount.
                    //
                    // Mirrored into a property of `cell` because `changed` is
                    // declared on the element that owns the property, and
                    // `pen-hovered` is the child's. Claim only, no release: a
                    // pen exit always lands the pointer on something that owns
                    // the latch -- this tile's body, another tile, or the ground
                    // sensor above -- and `!tile.pen-hovered` in `touch`'s
                    // release is what makes the body-to-pencil crossing
                    // independent of which of the two `changed has-hover`
                    // handlers slint happens to run first.
                    property <bool> pen-hover: tile.pen-hovered;
                    changed pen-hover => {
                        if (cell.pen-hover) {
                            root.hover-row = index;
                        }
                    }

                    // The group's date heading, drawn in the gap this tile's
                    // own `heading-offset` opened above it. Full width, with
                    // the hairline running off to the right edge (§1-3).
                    if entry.heading != "": Rectangle {
                        x: 0;
                        y: -root.heading-pitch;
                        width: grid.width - 2 * root.pad;
                        height: root.heading-height;

                        HorizontalLayout {
                            spacing: 8px;

                            Text {
                                text: entry.heading;
                                vertical-alignment: center;
                                font-size: 11px;
                                font-weight: 700;
                                color: Tokens.color-outline;
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 1px;
                                y: (parent.height - self.height) / 2;
                                background: Tokens.chrome-hairline;
                            }
                        }
                    }
                }

                // The raised copy (task3880, from task3490's prototype). A
                // second `for` over the same model, declared after the first,
                // so *every* one of its cells draws over *every* cell of the
                // grid -- which is the whole point, and the only ordering
                // slint gives without the dynamic `z` it refuses. Only the
                // expanded row is ever visible in it.
                //
                // `visible`-gated rather than `if`-gated on purpose: an `if`
                // would instantiate the element at its final geometry and the
                // tile would appear at full size with no animation at all.
                // Mounted, it animates the same four numbers the cell below it
                // does, from the collapsed rectangle to the expanded one.
                //
                // The gate sits on `body`, *inside* this element, and never on
                // this element itself (t260916-fa85). A `visible: false`
                // element is lowered to a zero-size clip whose children the
                // renderer never visits, so nothing reads their geometry --
                // and an `animate`d property nobody reads does not follow its
                // input: it stays armed from the first unread change, with that
                // change's timestamp, and ignores every later one. Opening tile
                // 2 moves tile 3's hidden copy; opening tile 3 seconds later
                // read it for the first time, found its 300ms long over, and
                // drew it at full size at once (or sliding in from wherever it
                // was last drawn) -- the 2026-09-16 report. This element has no
                // fill, so the renderer reads its x/y/width/height every frame
                // it draws and the copy tracks its tile while hidden, the way
                // the cell below it does. Measured in the standalone harness
                // under `.agents/tasks/evidence/t260916-fa85-expand-from-tile/`.
                for entry[index] in root.rows: raised := Rectangle {
                    property <float> raise: index == root.expanded-row ? 1 : 0;
                    animate raise {
                        duration: 260ms;
                        easing: ease-in-out;
                    }

                    property <length> top: root.pad-top
                        + entry.line * root.row-pitch
                        + entry.heading-offset * root.heading-pitch;

                    x: root.pad + entry.column * (root.cell-width + root.gap-x);
                    y: raised.top;
                    width: entry.span * root.cell-width + (entry.span - 1) * root.gap-x;
                    height: entry.span * root.cell-height + (entry.span - 1) * root.gap-y;
                    animate x, y, width, height {
                        duration: root.tween;
                        easing: Tokens.motion-curve;
                    }

                    // Everything the copy draws or hit-tests, behind the gate
                    // the comment above the `for` explains.
                    body := Rectangle {
                        width: 100%;
                        height: 100%;
                        visible: raised.raise >= 0.001;

                        // Its own, because the cell underneath is covered while
                        // this is up -- so this is the TouchArea a press on the
                        // *expanded* tile reaches while no player is mounted over
                        // it (task3890).
                        //
                        // It used to collapse on `clicked`. Task3520 took that off:
                        // the expanded tile **is** the playback surface, so a click
                        // on it is play/pause and the three ways out are Esc, the
                        // click outside, and the ✕ on the surface itself (round20
                        // §2-3). What stays is the hover latch -- `ClipTile.hovered`
                        // below reads it, and it is what keeps the name band up
                        // while the tiles are moving.
                        rtouch := TouchArea {
                            mouse-cursor: pointer;
                            // The same latch as the cell's below it: this copy is
                            // what the pointer is really over while the tile is
                            // open.
                            changed has-hover => {
                                if (self.has-hover) {
                                    root.hover-row = index;
                                } else if (!root.tile-motion && root.hover-row == index) {
                                    root.hover-row = -1;
                                }
                            }
                        }

                        ClipTile {
                            width: 100%;
                            height: 100%;
                            entry: entry;
                            // `expanded-row` and not only `rtouch.has-hover`
                            // (2026-09-13 report: 「アニメーション中、左上のタイトルが
                            // 隠れる、マウスを少しでも動かすとまた現れる」). The press
                            // lands on the *cell's* TouchArea, this copy is a
                            // different element, and slint settles `has-hover` on
                            // pointer movement -- so through the whole expansion
                            // this one reads false under a cursor that never left
                            // the tile, and the name band blinks out and back. The
                            // expanded tile simply keeps its name up.
                            hovered: rtouch.has-hover || index == root.expanded-row
                                || root.hover-row == index;
                            editing: false;
                            highlighted: false;
                        }

                        // The playback surface (task3520), over the tile rather
                        // than instead of it. Two things fall out of that order:
                        // the thumbnail is what the expansion animates until the
                        // first decoded frame arrives (`ClipStage` is transparent
                        // until then), and the 220ms *collapse* -- during which
                        // `ClipVm.open` is already false and this is gone -- shrinks
                        // the tile, not a dead black rectangle.
                        //
                        // `ClipVm.row` is a tile index on the filtered grid, the
                        // same number `expanded-row` and this `for`'s `index` are;
                        // the entry index behind it never leaves Rust
                        // (`Clips::expanded`).
                        //
                        // An `if`, not a `visible:` gate, unlike the raised copy's
                        // body: exactly one of these may exist, or every row's
                        // copy would ring `stage-size-changed` and the engine would
                        // be resampling to whichever answered last.
                        //
                        // `!ClipVm.fullscreen` is the other half of that invariant
                        // since t260916-8c14: full screen mounts a second copy at
                        // the pane's root (below the `VerticalLayout`), and the two
                        // gates are complementary on the same flag so exactly one
                        // is ever up. `set_clip_fullscreen` writes the window and
                        // the flag in one call, so the swap happens in one frame.
                        if ClipVm.open && ClipVm.row == index && !ClipVm.fullscreen: ClipStage {
                            width: 100%;
                            height: 100%;
                            comment: entry.comment;
                            date: entry.date;
                            add-comment: ClipLabels.add-comment;
                            editing: root.editing-row == index;
                            edit-requested => {
                                root.row-edit-requested(index);
                            }
                            comment-committed(value) => {
                                root.comment-committed(value);
                            }
                            edit-cancelled => {
                                root.edit-cancelled();
                            }
                        }
                    }
                }

                // ---------- marquee band (t260916-5568) ----------
                // The history screen's band (`sessions.slint`, round7 §2-12):
                // primary at 0.08 with a 1px edge at 0.55. After the raised
                // copy so it draws over every tile, and with no TouchArea so it
                // cannot take the drag it is drawing.
                if root.marquee-active: Rectangle {
                    x: Math.min(root.marquee-x0, root.marquee-x1);
                    y: Math.min(root.marquee-y0, root.marquee-y1);
                    width: Math.abs(root.marquee-x1 - root.marquee-x0);
                    height: Math.abs(root.marquee-y1 - root.marquee-y0);
                    background: Tokens.color-primary.with-alpha(0.08);
                    border-width: 1px;
                    border-color: Tokens.color-primary.with-alpha(0.55);
                }
            }
        }
    }

    // ---------- the full screen playback surface (t260916-8c14) ----------
    //
    // Full screen takes the rail and the title bar with it (`app.slint`'s
    // `any-fullscreen`) but nothing in `app.slint` reaches inside a pane, so
    // until this existed the picture stayed the 3-column tile it was in the
    // grid -- other tiles to its left and ~300px of nothing under it
    // (root/3520's `Verification` item 11). The user's 2026-09-16 ruling was
    // (b): full screen fills the pane.
    //
    // Mounted **here**, at the pane's root, rather than anywhere inside the
    // grid: the tile lives under `scroll := AppScroll` -> `grid := Rectangle`,
    // and no size given to it there can cover the search row. (The count line
    // left the pane for `app.slint` in t260919-ee8c.) Declaration order is the only z-order slint gives without the
    // dynamic `z` it refuses, so this sits after the `VerticalLayout` (over the
    // toolbar and the grid) and after the ground `TouchArea` at the
    // top of this component -- which would otherwise eat the stage's presses
    // and collapse the expansion.
    //
    // The grid keeps laying itself out underneath, untouched: leaving full
    // screen re-mounts the in-grid copy at the tile it was already animating
    // to, so the scroll position and the expansion survive.
    //
    // The row data comes from `root.rows[...]` rather than `ClipVm`, for both
    // mounts: the in-grid copy gets it from the `for`'s `entry`, and this one
    // indexes `root.rows` by hand. `ClipVm` carried `comment` / `date` /
    // `editing` ports for a while and never grew a writer on the Rust side, so
    // t260916-8c14 deleted them -- `clip_stage.slint`'s own header argues
    // against making the global a second answer to "what is this clip's
    // comment". `ClipVm.row` is an index on the filtered grid, the same space
    // `root.rows` is in. The `>= 0` is not redundant with the clamp: without it
    // a stale `-1` would read row 0's comment.
    if ClipVm.open && ClipVm.fullscreen && ClipVm.row >= 0: ClipStage {
        property <int> row-safe: Math.clamp(ClipVm.row, 0, root.last);

        width: 100%;
        height: 100%;
        // Both overridden because both exist for the in-grid mount only. The
        // radius is the tile's corner, and it would leave the pane's four
        // corners showing `chrome-content`. The background is `ClipStage`'s
        // own `#05070a` since t260916-ebdb (it used to be transparent until the
        // first frame) and is restated here so this mount never depends on it:
        // there is no tile underneath -- only the grid, which the acceptance
        // criterion says must not be visible.
        border-radius: 0px;
        background: #05070a;
        comment: root.rows[self.row-safe].comment;
        date: root.rows[self.row-safe].date;
        add-comment: ClipLabels.add-comment;
        editing: root.editing-row == ClipVm.row;
        edit-requested => {
            root.row-edit-requested(ClipVm.row);
        }
        comment-committed(value) => {
            root.comment-committed(value);
        }
        edit-cancelled => {
            root.edit-cancelled();
        }
    }

    if root.menu-open: ContextMenu {
        x: Math.clamp(root.menu-px, 4px, root.width - self.width - 4px);
        y: Math.clamp(root.menu-py, 4px, root.height - self.height - 4px);
        entries: root.menu-entries;
        chosen(index) => {
            root.menu-selected(index);
        }
    }

    // ---------- the delete's confirmation (t260916-5568) ----------
    // The history screen's discard dialog: the same frame, and the same order
    // -- cancel first and on the safe side, the destructive button red. Every
    // delete comes here, one clip or many (the user's 2026-09-19 ruling).
    if root.confirm-title != "": ConfirmDialog {
        cancel-label: ClipLabels.confirm-cancel;
        ok-label: root.confirm-ok;
        ok-icon: Icons.discard;
        danger: true;
        cancelled => {
            root.confirm-cancelled();
        }
        accepted => {
            root.confirm-accepted();
        }

        Text {
            text: root.confirm-title;
            wrap: word-wrap;
            font-size: 14.5px;
            font-weight: 600;
            color: Tokens.color-on-surface;
        }

        Text {
            text: root.confirm-lead;
            wrap: word-wrap;
            font-size: 12px;
            color: Tokens.color-on-surface-variant;
        }
    }
}
