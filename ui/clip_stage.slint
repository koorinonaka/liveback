// The clip player's playback surface (task3520, round20 §2-1 B案 / §2-2).
//
// In B案 the *expanded tile is the player*: there is no overlay and no second
// window, so this component is mounted inside the grid's raised copy
// (`clips.slint`) at exactly the rectangle the tile grew into. It draws the
// picture, takes the stage gestures, and carries the one bottom overlay round20
// §2-2 fixes -- comment band, seek bar, control row -- plus the ✕ the same
// section moved off that row and onto the surface's top right corner.
//
// Everything it shows comes off `ClipVm`, which the bin side fills from the
// engine; the comment band is the exception and comes in as properties, because
// it belongs to the *grid row* (the same `entry`, the same `editing-row` and the
// same three callbacks `ClipTile` uses) and not to the player. Reusing the
// pane's editor wiring rather than a second copy on the global is what makes
// 「再生中にコメントを書ける」 fall out of what task2990 already built.
//
// Deliberately not copied from `ReviewStage`: the tap circle, the outcome
// marks, the hold band and the loading ring. They are a second vocabulary to
// keep in step and round20 §2-2 does not ask for them here.

import { Dark, Motion, Tokens } from "tokens.slint";
import { Icons, AppIcon } from "icons.slint";
import { ControlSize, IconBtn, IconBtnVariant, InlineEdit, PressFocus, Timecode, Tooltip, TransportBtn, VolumeSlider } from "controls.slint";
import { ClipVm } from "clip_vm.slint";

export component ClipStage inherits Rectangle {
    // The grid row's own comment strip, passed through rather than read off
    // `ClipVm`: the pane already owns `editing-row` and the three editor
    // callbacks, and a second copy on the global would be a second answer to
    // "what is this clip's comment" that has to be invalidated by the worker.
    in property <string> comment;
    in property <string> add-comment;
    in property <bool> editing;
    callback edit-requested();
    callback comment-committed(string);
    callback edit-cancelled();

    // Same corner as the tile it replaces, so the swap moves no edge.
    border-radius: Tokens.radius-md;
    clip: true;
    // The review stage's own ground (`ReviewStage`: the DS's pure-black
    // `stage`, DS principle 1, user ruling 2026-09-28), always -- including the
    // few frames before the engine publishes the first picture. It used to be
    // transparent until then so the tile's thumbnail showed through the
    // expansion, but the window's ground is see-through now (t260916-ebdb),
    // so a transparent stage would show the desktop behind the window; the
    // user ruled the stage stays opaque, and the cost is that the expansion
    // shows this ground rather than the thumbnail until the first frame.
    background: Tokens.stage;

    // The picture's drawn box inside this surface. `image-fit: contain` grows
    // it until whichever axis runs out first, so this is that same min -- and
    // the gestures are confined to it (task1010's rule, inherited whole): the
    // black either side is not the video.
    property <length> video-width: min(root.width, root.height * ClipVm.stage-aspect);
    property <length> video-height: min(root.height, root.width / ClipVm.stage-aspect);
    property <length> video-x: (root.width - root.video-width) / 2;
    property <length> video-y: (root.height - root.video-height) / 2;

    // How big the picture is really being drawn, so the engine resamples to it
    // instead of handing skia a 1440p frame to minify (task990's rule). Rung on
    // both axes because either can move on its own -- a window resize moves the
    // width, a new clip's aspect moves the height -- and the Rust side ignores a
    // target it already has.
    //
    // Only ever one of these exists: `clips.slint` mounts this under an `if` on
    // the row actually playing, so there is no second copy to fight over
    // `display_target`.
    init => {
        ClipVm.stage-size-changed(root.video-width, root.video-height);
    }
    changed video-width => {
        ClipVm.stage-size-changed(root.video-width, root.video-height);
    }
    changed video-height => {
        ClipVm.stage-size-changed(root.video-width, root.video-height);
    }

    if ClipVm.stage-has-frame: Image {
        width: 100%;
        height: 100%;
        image-fit: contain;
        source: ClipVm.stage-frame;
    }

    // ---------- gestures (round20 追記「ステージ挙動」) ----------
    // Centre tap = play/pause, left/right quarter = ∓10s, two quick centre taps
    // = full screen, centre hold = x2. None of that is decided here: the press
    // goes to Rust with its position inside the *picture*, and
    // `ui_state::playback`'s `stage_hit` / `stage_zone` / `stage_double_press` /
    // `stage_hold_rate` -- the review's own, tested there -- answer it.
    //
    // No `double-clicked`: slint fires it on the second *release*, a whole
    // press-and-hold after the user asked for full screen (task1010).
    stage-touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down || event.kind == PointerEventKind.move) {
                ClipVm.activity();
            }
            // A press on the picture is a press that is not in the comment
            // field, and this app's rule for that is discard (task3430). The
            // same line `ClipTile`'s own `touch` carries, for the same reason.
            if (event.kind == PointerEventKind.down
                && event.button == PointerEventButton.left
                && root.editing) {
                root.edit-cancelled();
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                ClipVm.stage-pressed(
                    self.mouse-x - root.video-x,
                    self.mouse-y - root.video-y,
                    root.video-width,
                    root.video-height,
                );
            }
            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                ClipVm.stage-released();
            }
        }
    }

    // ---------- the ±10s hover bands (`ReviewStage`'s, verbatim) ----------
    property <float> hover-ratio: (stage-touch.mouse-x - root.video-x) / root.video-width;
    property <bool> zone-hover-armed: stage-touch.has-hover
        && !stage-touch.pressed
        && root.video-width > 0
        && stage-touch.mouse-y >= root.video-y
        && stage-touch.mouse-y < root.video-y + root.video-height;

    Rectangle {
        x: root.video-x;
        y: root.video-y;
        width: Math.clamp(root.video-width * 0.25, 44px, 320px);
        height: root.video-height;
        opacity: (root.zone-hover-armed && root.hover-ratio >= 0 && root.hover-ratio < 0.25)
            ? 1.0 : 0.0;
        animate opacity { duration: 160ms; }
        background: @linear-gradient(90deg, #0000004d 0%, #00000000 100%);

        VerticalLayout {
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                alignment: center;
                AppIcon {
                    commands: Icons.seek;
                    stroke-color: #ffffffdb;
                    size: 20px;
                }
            }
            Text {
                text: ClipVm.zone-seconds;
                horizontal-alignment: center;
                font-size: Tokens.type-overline-size;
                font-weight: Tokens.type-overline-weight;
                color: #ffffffdb;
            }
        }
    }

    Rectangle {
        x: root.video-x + root.video-width - self.width;
        y: root.video-y;
        width: Math.clamp(root.video-width * 0.25, 44px, 320px);
        height: root.video-height;
        opacity: (root.zone-hover-armed && root.hover-ratio > 0.75 && root.hover-ratio < 1)
            ? 1.0 : 0.0;
        animate opacity { duration: 160ms; }
        background: @linear-gradient(90deg, #00000000 0%, #0000004d 100%);

        VerticalLayout {
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                alignment: center;
                AppIcon {
                    commands: Icons.seek-forward;
                    stroke-color: #ffffffdb;
                    size: 20px;
                }
            }
            Text {
                text: ClipVm.zone-seconds;
                horizontal-alignment: center;
                font-size: Tokens.type-overline-size;
                font-weight: Tokens.type-overline-weight;
                color: #ffffffdb;
            }
        }
    }

    // What holds the bar up (`controls_visible`'s `pinned`, Rust adds the
    // editor and the menu): the pointer resting on the bar, a seek drag, and
    // the key focus on any of the bar's controls (t260929-fcc6) -- so a Tab
    // into a hidden bar brings it up, and it stays while the focus is there.
    // One expression, so no path can write the global without the others.
    // Letting go counts as activity: the 3 s run from the moment the focus
    // (or the pointer) leaves, not from the last pointer move before the
    // Tab came in -- measured without it, the bar dropped within 0.8 s of
    // the focus leaving.
    property <bool> pin: bar-touch.has-hover || seek-touch.pressed
        || close-btn.key-focused || play-btn.key-focused
        || repeat-btn.key-focused || mute-btn.key-focused
        || reveal-btn.key-focused || full-btn.key-focused
        || note-keys.has-focus || seek-keys.has-focus || vol.key-focused;
    changed pin => {
        ClipVm.controls-pinned = self.pin;
        if (!self.pin) {
            ClipVm.activity();
        }
    }

    // The editor was opened from the comment row's key (Enter / Space), so
    // when it closes the focus goes back to the row rather than being lost
    // with the editor (the next Tab would start over from the top). One
    // opened by the pointer leaves the focus where it was (t260929-9dc3).
    // On a timer, not in the handler: the pane's own `keys` takes the focus on
    // the same false edge (`clips.slint`, task4190) and, focused here directly,
    // won the race -- measured, the next Tab went to the search field.
    property <bool> key-edit;
    property <bool> refocus;
    changed editing => {
        if (!root.editing && root.key-edit) {
            root.key-edit = false;
            root.refocus = true;
        }
    }
    Timer {
        interval: 1ms;
        running: root.refocus;
        triggered => {
            root.refocus = false;
            note-keys.focus();
        }
    }

    // ---------- ✕ (round20 §2-2: on the surface, not on the control row) ----
    // It goes out with the bar, which round20 allows because Esc and the click
    // outside stay: the exit is never actually lost.
    //
    // The DS ClipCard's close (t260928-6080 F5): the shared `IconBtn` sm
    // `stage` on the same veil plate as the card's 「…」, so its hover is the
    // IconBtn's (lighter, the glyph turning 90°), with the tooltip 「閉じる」
    // and its Esc. An invisible square in the corner must not swallow a
    // press meant for the picture, so while the bar is down the button's
    // pointer path is off (`pointer-input`) -- but it stays mounted and visible to
    // slint, so Tab still reaches it and brings the bar up (t260929-fcc6).
    // It used to be `visible: self.opacity > 0.001`, and that gate broke
    // slint 1.18's Tab walk through the whole expanded tile in *both*
    // directions -- forward the focus was dropped after 「フォルダを開く」,
    // so neither the bar nor the caption buttons were ever reached; backward
    // it was dropped after the play button -- even while the bar was up and
    // the gate true. Taking the gate off alone restored both walks
    // (evidence/6510-fcc6-clip-controls-focus, runs d1 / d2).
    close-plate := Rectangle {
        x: parent.width - self.width - 8px;
        y: 8px;
        width: close-btn.width;
        height: close-btn.height;
        border-radius: Tokens.radius-sm;
        background: Dark.stage-veil;
        opacity: ClipVm.controls-visible ? 1.0 : 0.0;
        animate opacity {
            duration: Tokens.duration-fast;
            easing: Motion.easing-standard;
        }

        // The pointer move that lands on the corner is itself activity and
        // raises the bar before its own press arrives, and a gate on the fade
        // does not hold: the old `visible: self.opacity > 0.001` (HEAD), the
        // same as `pointer-input`, and even `opacity > 0.99` each let a press
        // on the hidden corner close the clip 3/3 (t260929-fcc6 runs ht / t /
        // nt). A timer runs on the clock rather than on the frame: the ✕
        // takes presses 150 ms after the bar came up, which a hand aiming at
        // it never beats (the hidden-corner press then stays the picture's).
        property <bool> up: ClipVm.controls-visible;
        property <bool> live;
        changed up => {
            if (!self.up) {
                self.live = false;
            }
        }
        Timer {
            interval: 150ms;
            running: close-plate.up && !close-plate.live;
            triggered => {
                close-plate.live = true;
            }
        }

        close-btn := IconBtn {
            icon: Icons.close;
            label: ClipVm.close-label;
            variant: IconBtnVariant.stage;
            // Only once the bar has been up for a moment (`live` below).
            pointer-input: close-plate.live;
            clicked => {
                ClipVm.close-requested();
            }
        }

        // Under the button: above it is the window's edge in full screen.
        Tooltip {
            x: parent.width - self.width;
            y: parent.height + 6px;
            armed: close-btn.has-hover;
            label: ClipVm.close-label;
            shortcut: ["Esc"];
        }
    }

    // ---------- the one bottom overlay (mock's `.pbot`) ----------
    // One scrim carrying all three bands, stacked `.pcmt` -> `.pseek` ->
    // `.pctl`, with the mock's own 22px of top padding: the gradient has to
    // start well above the comment or the text sits on the picture's own
    // brightness.
    Rectangle {
        y: parent.height - self.height;
        width: 100%;
        height: bottom-bar.preferred-height;
        // The DS expanded ClipCard's shade runs to black 84% at the foot.
        background: @linear-gradient(180deg, #00000000 0%, #000000d6 100%);
        opacity: ClipVm.controls-visible ? 1.0 : 0.0;
        animate opacity { duration: 160ms; }

        // While the bar is down nothing in it is a hit target -- the picture
        // underneath takes the press, which is what makes "click to bring the
        // bar back" the same gesture as play/pause rather than a dead click.
        bar-touch := TouchArea {
            enabled: ClipVm.controls-visible;
            mouse-cursor: default;
            // The pointer resting anywhere on the bar pins it (task151's rule,
            // `controls_visible`'s `pinned`) -- `root.pin` above.
        }

        bottom-bar := VerticalLayout {
            padding-top: 22px;
            padding-left: 12px;
            padding-right: 12px;
            padding-bottom: 8px;
            spacing: 6px;

            // ---- `.pcmt`: the tile's own comment strip ----
            // The DS expanded ClipCard's `.lb-clip__note`: the comment at
            // 15px 600 (500 `on-stage-muted` for 「コメントを追加」), and the
            // whole line is the press that opens the editor, its pencil shown
            // on hover (t260927-bb89).
            // The row's Tab stop sits beside the layout, not in the
            // `if !root.editing` branch: `pin` has to read it, and it has to
            // outlive the editor so the focus can come back to it
            // (t260929-9dc3, `key-edit` below).
            Rectangle {
                height: 22px;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: stretch;

                    if !root.editing: Rectangle {
                        horizontal-stretch: 1;

                        note-touch := TouchArea {
                            mouse-cursor: text;
                            clicked => {
                                root.edit-requested();
                            }
                        }

                        HorizontalLayout {
                            padding-left: 4px;
                            spacing: 8px;
                            alignment: start;

                            Text {
                                vertical-alignment: center;
                                text: root.comment == "" ? root.add-comment : root.comment;
                                overflow: elide;
                                font-size: Tokens.type-title-3-size;
                                font-weight: root.comment == "" ? Tokens.type-label-weight : Tokens.type-title-3-weight;
                                color: root.comment == "" ? Dark.on-stage-muted : Dark.on-stage;
                            }

                            AppIcon {
                                y: (parent.height - self.height) / 2;
                                commands: Icons.pencil;
                                stroke-color: Dark.on-stage-muted;
                                size: 14px;
                                opacity: note-touch.has-hover || root.comment == "" ? 1 : 0;
                            }
                        }
                    }

                    if root.editing: InlineEdit {
                        horizontal-stretch: 1;
                        text: root.comment;
                        hint: "Enter";
                        init => {
                            self.begin-edit();
                        }
                        committed(value) => {
                            root.comment-committed(value);
                        }
                        cancelled => {
                            if (root.editing) {
                                root.edit-cancelled();
                            }
                        }
                    }

                    // No date here (t260928-6080 F15): the DS expanded card has
                    // none, and the tile it grew from already said when.
                }

                note-keys := PressFocus {
                    enabled: !root.editing;
                    pressed => {
                        root.key-edit = true;
                        root.edit-requested();
                    }
                }
            }

            // ---- the seek bar (DS `.lb-clip__seek`): a 4px track, the
            // `accent` fill, and a 12px white knob only while hovered or
            // dragged (t260927-bb89) ----
            // Not `ReviewTrackWrap`: that one carries the selection range, the
            // markers and the gap spans, none of which a finished clip has.
            Rectangle {
                height: 16px;

                Rectangle {
                    y: (parent.height - 4px) / 2;
                    height: 4px;
                    border-radius: 2px;
                    background: #ffffff3d;
                }

                Rectangle {
                    x: 0;
                    y: (parent.height - 4px) / 2;
                    width: parent.width * ClipVm.played-percent / 100;
                    height: 4px;
                    border-radius: 2px;
                    background: Tokens.accent;
                }

                // Faded in and out rather than mounted (t260928-6080 F16), with
                // the DS knob's `0 1px 4px` 40% shadow.
                Rectangle {
                    x: parent.width * ClipVm.played-percent / 100 - 6px;
                    y: (parent.height - 12px) / 2;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: #ffffff;
                    drop-shadow-offset-y: 1px;
                    drop-shadow-blur: 4px;
                    drop-shadow-color: #00000066;
                    opacity: seek-touch.has-hover || seek-touch.pressed || seek-keys.has-focus ? 1 : 0;
                    animate opacity {
                        duration: Tokens.duration-fast;
                        easing: Motion.easing-standard;
                    }
                }

                seek-touch := TouchArea {
                    mouse-cursor: pointer;
                    // A drag pins the bar as surely as a hover does, and the
                    // pointer can leave the 12px strip mid-drag (`root.pin` above).
                    pointer-event(event) => {
                        if ((event.kind == PointerEventKind.down
                                && event.button == PointerEventButton.left)
                            || (event.kind == PointerEventKind.move && self.pressed)) {
                            ClipVm.seek(max(0.0, min(1.0, self.mouse-x / self.width)));
                        }
                    }
                }

                // A Tab stop that takes no key (t260929-9dc3): ← → (and j / l)
                // go on to the pane's `clip_key_action`, which already seeks.
                seek-keys := PressFocus {
                    press-keys: false;
                }
            }

            // ---- `.pctl`: round20 §2-2's five, plus the repeat toggle the user
            // asked for on 2026-09-16 (t260916-0ee4), and no more ------------
            // The buttons are the shared `TransportBtn` at sm, which
            // t260928-5f3b drew as the IconBtn `stage`; the row is their height.
            HorizontalLayout {
                height: Tokens.size-control-sm;
                spacing: 6px;

                play-btn := TransportBtn {
                    size: ControlSize.sm;
                    icon: ClipVm.playing ? Icons.pause : Icons.play;
                    label: ClipVm.transport-tips[ClipVm.playing ? 2 : 1];
                    filled: !ClipVm.playing;
                    clicked => {
                        ClipVm.play-toggled();
                    }
                }

                // The shared `Timecode` sm on the stage (t260928-6080 F16,
                // t260928-13e9): mono 12 / 500, the position `on-stage`, the
                // total `on-stage-muted`, in either theme. Centred in the row:
                // the Timecode sits on its own bottom line.
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;

                    Timecode {
                        size: ControlSize.sm;
                        stage: true;
                        whole: ClipVm.position-text == "" ? "0:00" : ClipVm.position-text;
                        frac: " / " + (ClipVm.total-text == "" ? "0:00" : ClipVm.total-text);
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                // First of the right-hand group, which puts it left of full
                // screen -- where the review screen also keeps its own repeat,
                // among the right-hand controls rather than beside play. The
                // design mock has no loop button on `.pctl` at all, so this
                // placement is t260916-0ee4's own decision, not the mock's.
                repeat-btn := TransportBtn {
                    size: ControlSize.sm;
                    icon: Icons.repeat;
                    label: ClipVm.transport-tips[4];
                    on: ClipVm.repeat-enabled;
                    clicked => {
                        ClipVm.repeat-toggled();
                    }
                }

                mute-btn := TransportBtn {
                    size: ControlSize.sm;
                    icon: ClipVm.muted ? Icons.volume-muted : Icons.volume;
                    label: ClipVm.transport-tips[ClipVm.muted ? 10 : 9];
                    tint: ClipVm.muted ? Dark.on-stage-muted : Dark.on-stage;
                    clicked => {
                        ClipVm.mute-toggled();
                    }
                }

                vol := VolumeSlider {
                    ratio: ClipVm.volume-ratio;
                    muted: ClipVm.muted;
                    ratio-changed(value) => {
                        ClipVm.volume-changed(value);
                    }
                }

                // 「フォルダで表示」, left of full screen (t260928-6080 F2, the
                // DS ClipCard's expanded row).
                reveal-btn := TransportBtn {
                    size: ControlSize.sm;
                    icon: Icons.folder-open;
                    label: ClipVm.reveal-label;
                    clicked => {
                        ClipVm.reveal-requested();
                    }
                }

                full-btn := TransportBtn {
                    size: ControlSize.sm;
                    icon: ClipVm.fullscreen ? Icons.fullscreen-exit : Icons.fullscreen;
                    label: ClipVm.transport-tips[ClipVm.fullscreen ? 13 : 12];
                    clicked => {
                        ClipVm.fullscreen-toggled();
                    }
                }
            }
        }
    }
}
