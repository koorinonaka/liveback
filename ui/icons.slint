// Ported from src/components/Icon.tsx. Slint's `Path` takes SVG path data, so
// the `<path>` markup carries over verbatim; `<rect>` and `<circle>` had to be
// rewritten as path commands, which is the only place these differ from the
// React source.
export global Icons {
    // 24x24, stroke 1.5, round caps.
    // The rail's own play glyph: a triangle on a pedestal, so it reads as "the
    // review screen" rather than as the transport's `play` (which is filled and
    // has no pedestal -- keep the two apart).
    out property <string> review: "M4 20.5h16";
    // The triangle is filled (round7 section 2-1) -- pass it as `fill-commands`.
    out property <string> review-fill: "M9.6 5.2 18.4 11.1a1.1 1.1 0 0 1 0 1.8L9.6 18.8a1.1 1.1 0 0 1-1.7-.9V6.1a1.1 1.1 0 0 1 1.7-.9Z";
    out property <string> targets: "M8.5 5.5V5a1.5 1.5 0 0 1 1.5-1.5h9A1.5 1.5 0 0 1 20.5 5v9a1.5 1.5 0 0 1-1.5 1.5h-.5 M5.3 8.5H14.7A1.8 1.8 0 0 1 16.5 10.3V18.7A1.8 1.8 0 0 1 14.7 20.5H5.3A1.8 1.8 0 0 1 3.5 18.7V10.3A1.8 1.8 0 0 1 5.3 8.5Z M3.5 12.7h13";
    out property <string> sessions: "M4 4.5v15M20 4.5v15M4 19.5h16M4 11.8h16";
    // The two books are filled (round7 section 2-1) -- pass as `fill-commands`.
    out property <string> sessions-fill: "M7.3 11.3V7.6a.8.8 0 0 1 .8-.8h2.2a.8.8 0 0 1 .8.8v3.7Z M13.7 11.3V6.1a.8.8 0 0 1 .8-.8h2a.8.8 0 0 1 .8.8v5.2Z";
    // The rail's クリップ glyph (task2980): a film strip, i.e. the finished
    // file, as against `sessions`' books, which are the buffer it was cut from.
    // Kept stroke-only -- the strip's two sprocket rows are what identify it at
    // 22px, and a fill would close them up.
    out property <string> clips: "M5.5 4.5H18.5A1.5 1.5 0 0 1 20 6V18A1.5 1.5 0 0 1 18.5 19.5H5.5A1.5 1.5 0 0 1 4 18V6A1.5 1.5 0 0 1 5.5 4.5Z M8 4.5v15 M16 4.5v15 M4 8.8h4 M4 15.2h4 M16 8.8h4 M16 15.2h4";
    // The mock strokes the spokes at 2px and the core at 1.8px. One `Path` has
    // one stroke width, so the whole glyph is drawn at 2px -- 0.2px at 22px is
    // below the pixel grid, and the spokes are what the round asked to thicken.
    out property <string> settings: "M15.4 12A3.4 3.4 0 1 1 8.6 12A3.4 3.4 0 1 1 15.4 12Z M12 2.9v2.7M12 18.4v2.7M21.1 12h-2.7M5.6 12H2.9M18.4 5.6l-1.9 1.9M7.5 16.5l-1.9 1.9M18.4 18.4l-1.9-1.9M7.5 7.5 5.6 5.6";
    // The review screen's waiting glyph (round7 §2-6): the mock's dashed ring
    // (`stroke-dasharray="3.4 2.5"` on r=7.5) with an outlined r=2.6 centre.
    // slint's `Path` has no dash array, so the eight dashes are written out as
    // arcs. The centre used to be a filled Rectangle in `review.slint`; round7
    // outlines it, so it belongs to the glyph now.
    out property <string> empty-record: "M12 4.5A7.5 7.5 0 0 1 15.28 5.26M17.31 6.7A7.5 7.5 0 0 1 19.09 9.56M19.5 12.02A7.5 7.5 0 0 1 18.73 15.3M17.28 17.32A7.5 7.5 0 0 1 14.42 19.1M11.96 19.5A7.5 7.5 0 0 1 8.68 18.73M6.66 17.27A7.5 7.5 0 0 1 4.89 14.4M4.5 11.94A7.5 7.5 0 0 1 5.28 8.66M6.74 6.65A7.5 7.5 0 0 1 9.62 4.89 M14.6 12A2.6 2.6 0 1 1 9.4 12A2.6 2.6 0 1 1 14.6 12Z";
    // The history screen's empty glyph (task3800): the mock's clock
    // (`circle r=8` plus the two hands). `sessions`' books are the rail item
    // for that screen; an empty history is about time not having passed yet,
    // which is what the round asked the glyph to say.
    out property <string> clock: "M20 12A8 8 0 1 1 4 12A8 8 0 1 1 20 12Z M12 7.5V12l3 2";
    out property <string> search: "M16.5 10.5 A6 6 0 1 1 4.5 10.5 A6 6 0 1 1 16.5 10.5 Z M15 15l4.6 4.6";
    out property <string> close: "M6 6l12 12M18 6 6 18";
    out property <string> plus: "M12 5v14M5 12h14";
    out property <string> refresh: "M20.2 12a8.2 8.2 0 1 1-2.4-5.8 M20.4 4.6v4.4h-4.4";
    out property <string> info: "M20.5 12 A8.5 8.5 0 1 1 3.5 12 A8.5 8.5 0 1 1 20.5 12 Z M12 11v5.5 M12 7.6h.01";
    out property <string> warning: "M12 4.2 21.2 19.8H2.8Z M12 10v4.2 M12 17.4h.01";
    // Filled, not stroked -- pass it as `fill-color` (see `AppIcon`).
    out property <string> record: "M17 12 A5 5 0 1 1 7 12 A5 5 0 1 1 17 12 Z";
    out property <string> stop: "M8 6.5 H16 A1.5 1.5 0 0 1 17.5 8 V16 A1.5 1.5 0 0 1 16 17.5 H8 A1.5 1.5 0 0 1 6.5 16 V8 A1.5 1.5 0 0 1 8 6.5 Z";
    out property <string> caret: "M7 14.5 12 9.5l5 5";
    // slint can rotate neither a Path nor a component wrapping one, so the
    // drawer's open state swaps the glyph instead of turning it (round 4 §2-A3
    // asked for a 180 degree turn; the animation is what is given up).
    out property <string> caret-down: "M7 9.5 12 14.5l5-5";
    out property <string> folder: "M3.5 8V5.8a1.5 1.5 0 0 1 1.5-1.5h3.9l2 2.4h6.6a1.5 1.5 0 0 1 1.5 1.5V10 M3.5 10h17.2l-2.2 8.3a1.5 1.5 0 0 1-1.45 1.1H5.2a1.5 1.5 0 0 1-1.45-1.1Z";
    out property <string> discard: "M4.5 6.5h15 M9.5 6.5V5a1.2 1.2 0 0 1 1.2-1.2h2.6A1.2 1.2 0 0 1 14.5 5v1.5 M6.6 6.5l.9 12.2a1.5 1.5 0 0 0 1.5 1.4h6a1.5 1.5 0 0 0 1.5-1.4l.9-12.2 M10.4 10v6.4M13.6 10v6.4";
    out property <string> load: "M12 20.2V9.8 M7.6 14.2 12 9.8l4.4 4.4 M4.5 7.5V5.3a1.5 1.5 0 0 1 1.5-1.5h12a1.5 1.5 0 0 1 1.5 1.5v2.2";
    out property <string> recover: "M12 4.2a7.8 7.8 0 1 1-7.5 5.6 M4.2 4.2v4.4h4.4 M12 8.4V12l2.6 2";
    out property <string> gap: "M5 6.5 H19 A1.5 1.5 0 0 1 20.5 8 V16 A1.5 1.5 0 0 1 19 17.5 H5 A1.5 1.5 0 0 1 3.5 16 V8 A1.5 1.5 0 0 1 5 6.5 Z M6.6 17.5 12.4 6.5M11 17.5 16.8 6.5";
    out property <string> success: "M20.5 12 A8.5 8.5 0 1 1 3.5 12 A8.5 8.5 0 1 1 20.5 12 Z M8 12.3l2.7 2.7 5.3-5.6";
    // Filled, like `record` -- pass as `fill-color`.
    out property <string> play: "M8.5 4.5 19 12 8.5 19.5Z";
    out property <string> pause: "M9.5 5v14M14.5 5v14";
    out property <string> seek: "M11.5 7.5 5.5 12l6 4.5Z M19 7.5 13 12l6 4.5Z";
    // `seek` mirrored about the vertical axis: the stage's forward feedback.
    out property <string> seek-forward: "M12.5 7.5 18.5 12l-6 4.5Z M5 7.5 11 12l-6 4.5Z";
    out property <string> loading: "M20.2 12a8.2 8.2 0 1 1-2.4-5.8";
    // round 4 §4. `screenshot` is the camera (body + notch + lens outline): the
    // photo-frame alternative collapsed at 12px and its outline drifted toward
    // `gap`. `volume-muted` replaces the two waves with a cross rather than
    // striking the whole glyph through, so the silhouette itself changes.
    out property <string> screenshot: "M9 7.5 10.3 5.5h3.4L15 7.5 M5 7.5H19A1.5 1.5 0 0 1 20.5 9v8A1.5 1.5 0 0 1 19 18.5H5A1.5 1.5 0 0 1 3.5 17V9A1.5 1.5 0 0 1 5 7.5Z M15 12.8A3 3 0 1 1 9 12.8A3 3 0 1 1 15 12.8Z";
    out property <string> volume: "M11 5.5 6.9 9.5H4.7A1.2 1.2 0 0 0 3.5 10.7v2.6a1.2 1.2 0 0 0 1.2 1.2h2.2L11 18.5Z M14.6 9.7a3.4 3.4 0 0 1 0 4.6 M17.1 7.4a6.7 6.7 0 0 1 0 9.2";
    out property <string> volume-muted: "M11 5.5 6.9 9.5H4.7A1.2 1.2 0 0 0 3.5 10.7v2.6a1.2 1.2 0 0 0 1.2 1.2h2.2L11 18.5Z M15.3 9.8l4.9 4.4 M20.2 9.8l-4.9 4.4";
    out property <string> error: "M8.6 3.5h6.8l4.8 4.8v6.8l-4.8 4.8H8.6l-4.8-4.8V8.3Z M9.4 9.4l5.2 5.2M14.6 9.4l-5.2 5.2";

    // task151. Four corners, arrows pointing out of the frame (enter) and into
    // it (exit) -- the pair reads as one gesture reversed, which is what the
    // button does.
    out property <string> fullscreen: "M4 9V5.5A1.5 1.5 0 0 1 5.5 4H9 M15 4h3.5A1.5 1.5 0 0 1 20 5.5V9 M20 15v3.5a1.5 1.5 0 0 1-1.5 1.5H15 M9 20H5.5A1.5 1.5 0 0 1 4 18.5V15";
    out property <string> fullscreen-exit: "M9.5 4v3.5A1.5 1.5 0 0 1 8 9H4.5 M14.5 4v3.5A1.5 1.5 0 0 0 16 9h3.5 M14.5 20v-3.5a1.5 1.5 0 0 1 1.5-1.5h3.5 M9.5 20v-3.5A1.5 1.5 0 0 0 8 15H4.5";

    // task144. `view-list` is three rows of bullet + rule, `view-grid` is a
    // 2x2 of tiles: the two silhouettes differ at a glance, which is the whole
    // reason the view toggle earns glyphs. `select-all` is the marquee (dashed
    // frame is not expressible here, so it is a plain frame) with a check.
    out property <string> view-list: "M4.5 7h.01M4.5 12h.01M4.5 17h.01 M9 7h10.5M9 12h10.5M9 17h10.5";
    out property <string> view-grid: "M4.5 5.5 H10 A1 1 0 0 1 11 6.5 V10 A1 1 0 0 1 10 11 H4.5 A1 1 0 0 1 3.5 10 V6.5 A1 1 0 0 1 4.5 5.5 Z M14 5.5 H19.5 A1 1 0 0 1 20.5 6.5 V10 A1 1 0 0 1 19.5 11 H14 A1 1 0 0 1 13 10 V6.5 A1 1 0 0 1 14 5.5 Z M4.5 13 H10 A1 1 0 0 1 11 14 V17.5 A1 1 0 0 1 10 18.5 H4.5 A1 1 0 0 1 3.5 17.5 V14 A1 1 0 0 1 4.5 13 Z M14 13 H19.5 A1 1 0 0 1 20.5 14 V17.5 A1 1 0 0 1 19.5 18.5 H14 A1 1 0 0 1 13 17.5 V14 A1 1 0 0 1 14 13 Z";
    out property <string> select-all: "M5 3.5 H19 A1.5 1.5 0 0 1 20.5 5 V19 A1.5 1.5 0 0 1 19 20.5 H5 A1.5 1.5 0 0 1 3.5 19 V5 A1.5 1.5 0 0 1 5 3.5 Z M7.6 12.2l2.9 2.9 5.9-6.2";
    // `select-all` without its frame (task1130): the selected tile's badge is
    // the tick alone, on a filled primary disc that supplies the shape.
    out property <string> check: "M7.6 12.2l2.9 2.9 5.9-6.2";

    // round5 §8. Same family as everything above (24x24, stroke 1.5, round
    // caps/joins, no fill). `panel` is the frame with its right column ruled
    // off, so it reads as "a panel beside the content" rather than a window;
    // `monitor` earns its stand, which is the only thing separating it from
    // `panel` at 14px; `export` is the download arrow over its floor line,
    // deliberately the inverse of `load` (which points up out of a tray).
    out property <string> panel: "M5 4.5 H19 A1.5 1.5 0 0 1 20.5 6 V18 A1.5 1.5 0 0 1 19 19.5 H5 A1.5 1.5 0 0 1 3.5 18 V6 A1.5 1.5 0 0 1 5 4.5 Z M14.5 4.5v15";
    out property <string> monitor: "M4.5 4.5 H19.5 A1 1 0 0 1 20.5 5.5 V15 A1 1 0 0 1 19.5 16 H4.5 A1 1 0 0 1 3.5 15 V5.5 A1 1 0 0 1 4.5 4.5 Z M9.5 19.5h5 M12 16v3.5";
    // round21 §1-2 I1 (the 2026-09-14 revision replaced I3's monitor frame):
    // the rail's キャプチャ glyph is the REC disc -- an outlined ring with a
    // solid red centre. Two paths because the two carry different colours: the
    // ring takes `RailButton`'s tint like every other rail glyph, the centre is
    // `color-error` and rides on `AppIcon`'s `fill-commands` with an override.
    // `circle cx=12 cy=12 r=7.5` and `r=3`, written as two half-arcs each.
    out property <string> capture: "M19.5 12 A7.5 7.5 0 1 1 4.5 12 A7.5 7.5 0 1 1 19.5 12 Z";
    out property <string> capture-dot: "M15 12 A3 3 0 1 1 9 12 A3 3 0 1 1 15 12 Z";
    out property <string> export: "M12 4v10 M7.8 9.8 12 14l4.2-4.2 M4.5 17.5v1.2a1.3 1.3 0 0 0 1.3 1.3h12.4a1.3 1.3 0 0 0 1.3-1.3v-1.2";
    out property <string> pencil: "M16.2 4.6 19.4 7.8 8.7 18.5 4.5 19.5l1-4.2Z M14.4 6.4l3.2 3.2";
    out property <string> lock: "M6.5 10.5 H17.5 A1.5 1.5 0 0 1 19 12 V19 A1.5 1.5 0 0 1 17.5 20.5 H6.5 A1.5 1.5 0 0 1 5 19 V12 A1.5 1.5 0 0 1 6.5 10.5 Z M8 10.5V8a4 4 0 0 1 8 0v2.5 M12 14.4v2.6";
    // task186. The picker's `ウィンドウ` tab: one rounded frame with its title
    // bar ruled off. `targets` is two overlapping windows and reads as "a list
    // of them" at 16px, which is the wrong half of the pair -- the tab beside
    // it is a single monitor.
    out property <string> window: "M4.5 4.5 H19.5 A1.5 1.5 0 0 1 21 6 V18 A1.5 1.5 0 0 1 19.5 19.5 H4.5 A1.5 1.5 0 0 1 3 18 V6 A1.5 1.5 0 0 1 4.5 4.5 Z M3 8.8h18";
    // task183. The two-arrow loop, copied from the mock's transport svg: the
    // repeat chip became an icon toggle and this is the glyph it toggles.
    out property <string> repeat: "M17 4.5 20 7.5 17 10.5M20 7.5H7A3.5 3.5 0 0 0 3.5 11M7 19.5 4 16.5 7 13.5M4 16.5H17A3.5 3.5 0 0 0 20.5 13";
    // task310. 「規定値に戻す」. UE5's revert glyph, which is the Enter key's
    // arrow: down the right edge, round the corner, out to the left. Not
    // `refresh`/`recover` -- a circular arrow reads as "do it again", and this
    // says "put it back".
    out property <string> reset: "M18.5 5.5V11.5A2 2 0 0 1 16.5 13.5H6.5 M10.5 9.5 6.5 13.5 10.5 17.5";
    // round8 §2: the range panel's ±10s steppers. Double chevrons, verbatim
    // from the mock -- a single `«` would be the seek buttons the transport
    // already owns, and these move a boundary rather than the playhead.
    out property <string> step-back: "M11.5 6 5.5 12l6 6 M18.5 6l-6 6 6 6";
    out property <string> step-forward: "M12.5 6l6 6-6 6 M5.5 6l6 6-6 6";
    // task3050 / design round18 §4-6: 「再生位置に合わせる」. The playhead itself
    // -- a marker head whose stem drops onto the track's bottom rule. Explicitly
    // *not* a down arrow: design read that as ダウンロード.
    out property <string> playhead: "M7.5 4.5H16.5V9.5L12 14 7.5 9.5Z M12 14V17.5 M4.5 19.5H19.5";
    // task3050: the marker row's 「前後30秒を範囲に」. A span between two
    // brackets with the marker standing in the middle of it.
    //
    // task3870 takes design's ruling (round19 §4): the same two brackets, but
    // the marker in the middle is a filled dot rather than the full-height
    // rule -- 「角括弧に挟んだ点」. Verbatim from the round's SVG, with the
    // `<circle>` rewritten as two arcs the way `record` and `empty-record` are;
    // it goes in `marker-range-fill` because `AppIcon` draws the fill layer
    // with no stroke, and putting it on the stroked path would have filled the
    // open bracket subpaths as well.
    out property <string> marker-range: "M8 5.5H5.5V18.5H8 M16 5.5H18.5V18.5H16";
    out property <string> marker-range-fill: "M13.7 12A1.7 1.7 0 1 1 10.3 12A1.7 1.7 0 1 1 13.7 12Z";

    // The drop overlay's two glyphs (round7 §2-13), verbatim from the mock: a
    // document with the review triangle on it, and the same document struck
    // through. Both are outline -- the plate behind them carries the colour.
    out property <string> drop-file: "M6 3.5h7.5L18.5 8.5V19a1.5 1.5 0 0 1-1.5 1.5H6A1.5 1.5 0 0 1 4.5 19V5A1.5 1.5 0 0 1 6 3.5Z M13.5 3.5v5h5 M10 11.5l4.5 2.8-4.5 2.8Z";
    out property <string> drop-file-rejected: "M6 3.5h7.5L18.5 8.5V19a1.5 1.5 0 0 1-1.5 1.5H6A1.5 1.5 0 0 1 4.5 19V5A1.5 1.5 0 0 1 6 3.5Z M13.5 3.5v5h5 M9.5 12.5l5 5M14.5 12.5l-5 5";

    // 10x10, stroke 1, square caps: caption glyphs are their own family and
    // match the OS rather than the app. Rounding them would read as a web app
    // pretending to be a window.
    out property <string> caption-minimize: "M1 5h8";
    out property <string> caption-maximize: "M1 1 H9 V9 H1 Z";
    // Restore: the OS's two overlapping squares -- front pane plus the L of the
    // one behind it. Shown while maximized so the button says what it does.
    out property <string> caption-restore: "M1 3 H7 V9 H1 Z M3 3 V1 H9 V7 H7";
    out property <string> caption-close: "M1 1l8 8M9 1l-8 8";
}

export component AppIcon {
    in property <string> commands;
    // Drawn on top of `commands` with no stroke: the rail glyphs mix outline
    // and solid masses in one icon (round7 section 2-1), which a single `Path`
    // cannot do -- it carries one stroke and one fill for every subpath.
    in property <string> fill-commands;
    in property <color> stroke-color;
    // The fill normally *is* the stroke colour -- one glyph, one ink. `capture`
    // is the exception (round21 §1-2 I1): its centre is `color-error` while the
    // ring stays the rail's tint.
    in property <color> fill-commands-color: root.stroke-color;
    // Only the filled glyphs (`record`) set this; everything else is outline.
    in property <color> fill-color: transparent;
    in property <length> size: 22px;
    in property <length> weight: 1.5px;

    width: root.size;
    height: root.size;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.commands;
        stroke: root.stroke-color;
        stroke-width: root.weight;
        // Round caps, as in Icon.tsx: the `h.01` dots in `info`/`warning` are
        // zero-length segments and only exist as ink because of the cap.
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: root.fill-color;
    }

    if root.fill-commands != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.fill-commands;
        fill: root.fill-commands-color;
    }
}

export component CaptionIcon {
    in property <string> commands;
    in property <color> stroke-color;

    // 12px, not native Windows' 10px: the user read 10 as too small on this
    // 32px bar (2026-09-10). The viewbox stays 10 -- the commands are authored
    // in that space and the path just scales; `stroke-width` is applied after
    // the fit, so the hairline stays 1px.
    width: 12px;
    height: 12px;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: root.commands;
        stroke: root.stroke-color;
        stroke-width: 1px;
        fill: transparent;
    }
}
