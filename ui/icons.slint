    // ---------- caption buttons: the DS win-* set, 20 grid, drawn at 1px ------
    out property <string> caption-minimize: "M5 10h10";
    out property <string> caption-maximize: "M7 5.5H13A1.5 1.5 0 0 1 14.5 7V13A1.5 1.5 0 0 1 13 14.5H7A1.5 1.5 0 0 1 5.5 13V7A1.5 1.5 0 0 1 7 5.5Z";
    out property <string> caption-restore: "M6.75 7.5H11.25A1.25 1.25 0 0 1 12.5 8.75V13.25A1.25 1.25 0 0 1 11.25 14.5H6.75A1.25 1.25 0 0 1 5.5 13.25V8.75A1.25 1.25 0 0 1 6.75 7.5Z M7.5 5.5h5.25c.97 0 1.75.78 1.75 1.75v5.25";
    out property <string> caption-close: "M5.5 5.5 l9 9M14.5 5.5l-9 9";
}

// How an icon moves once when the control carrying it is hovered: the DS's
// `bundle.css` "Icon motion" keyframes, one value per `@keyframes lb-i-*`.
export enum IconMotion {
    none, pop, rise, sink, slide-out, dash, lid, snip, latch, shutter, wave, draw,
    turn, tilt, nudge-right, nudge-left, nudge-down, nudge-up, rewind, bob, flash,
}

export component AppIcon {
    in property <string> commands;
    in property <color> stroke-color;
    // Fills the stroked path too (the transport's filled play).
    in property <color> fill-color: transparent;
    in property <length> size: 20px;
    // The DS stroke is 1.5 at 20px and scales with the icon: 1.2px at 16px
    // (t260928-d906). Written against 20, not `grid`, so the 24-grid glyphs
    // below take the same weight as a DS glyph of the same size -- which is
    // what they drew at 20px before (1.5px), and what their neighbours draw.
    in property <length> weight: root.size * 1.5 / 20;
    // The viewbox. 20 for the DS set, 24 for the old glyphs kept as they were.
    in property <int> grid: root.grid-of(root.commands);
    // Hover (or focus) on the control that carries the icon. Every false ->
    // true edge plays `motion` once; dropping it snaps back to rest.
    in property <bool> active;
    in property <IconMotion> motion: root.motion-of(root.commands);

    width: root.size;
    height: root.size;

    property <string> solid: root.solid-of(root.commands);
    property <string> part-a: root.part-a-of(root.commands);
    property <string> part-a-solid: root.part-a-solid-of(root.commands);
    property <string> part-b: root.part-b-of(root.commands);
    property <bool> moves-part: root.part-a != "";
    property <color> solid-ink: root.fill-color != transparent ? root.fill-color : root.stroke-color;
    property <length> unit: root.size / root.grid;
    // The stroke-width compensation (header comment), in grid units.
    property <float> vb-inset: root.weight / root.unit / 2;
    property <float> vb-size: root.grid - root.weight / root.unit;
    property <float> origin-x: root.origin-x-of(root.commands);
    property <float> origin-y: root.origin-y-of(root.commands);

    // ---------- the motion clock ----------
    // `t` runs 0 -> 1 linearly each time the state is entered and snaps to 0
    // on leaving (KNOWLEDGE: a state's transition clock is fixed at the change,
    // so re-entering restarts it). Every shape below is at rest at both ends.
    // The DS eases each keyframe segment on its own (CSS applies the timing
    // function per segment), so the easing is applied per segment in `seg`,
    // not on `t`.
    property <float> t: 0;
    property <bool> playing: root.active && root.motion != IconMotion.none && !Tokens.reduce-motion;
    states [
        moving when root.playing: {
            t: 1;
            in {
                animate t { duration: root.duration-of(root.motion); easing: linear; }
            }
            out {
                animate t { duration: 0ms; }
            }
        }
    ]

    property <IconMotion> m: root.motion;
    property <float> p: root.t;
    property <float> snip-v: root.p < 0.5 ? root.bump(root.p * 2, 0.5) : root.bump(root.p * 2 - 1, 0.5);
    property <float> flash-v: root.p < 0.5 ? root.tent(root.p * 2) : root.tent(root.p * 2 - 1);
    // Translation, in grid units.
    property <float> dx:
        root.m == IconMotion.slide-out ? 1.5 * root.bump(root.p, 0.45)
        : root.m == IconMotion.dash ? 2.5 * root.bump(root.p, 0.45)
        : root.m == IconMotion.nudge-right ? 2 * root.bump(root.p, 0.45)
        : root.m == IconMotion.nudge-left ? -2 * root.bump(root.p, 0.45)
        : 0;
    property <float> dy:
        root.m == IconMotion.rise ? -2.5 * root.bump(root.p, 0.45)
        : root.m == IconMotion.sink ? 2 * root.bump(root.p, 0.45)
        : root.m == IconMotion.slide-out ? -1.5 * root.bump(root.p, 0.45)
        : root.m == IconMotion.lid ? -1.5 * root.bump(root.p, 0.4)
        : root.m == IconMotion.latch ? root.tri(root.p, 0.4, -2, 0.7, 0.5)
        : root.m == IconMotion.nudge-down ? 2 * root.bump(root.p, 0.45)
        : root.m == IconMotion.nudge-up ? -2 * root.bump(root.p, 0.45)
        : root.m == IconMotion.bob ? -1.5 * root.bump(root.p, 0.4)
        : 0;
    // Rotation in degrees, clockwise. `wave`'s skewY is a rotation here: slint
    // has no skew, and about the flag's hoist the two read the same.
    property <float> rot:
        root.m == IconMotion.lid ? -14 * root.bump(root.p, 0.4)
        : root.m == IconMotion.snip ? -12 * root.snip-v
        : root.m == IconMotion.wave ? root.tri(root.p, 0.3, 4, 0.65, -2)
        : root.m == IconMotion.turn ? 90 * root.seg(root.p, 0, 1)
        : root.m == IconMotion.tilt ? root.tri(root.p, 0.3, -12, 0.65, 6)
        : root.m == IconMotion.rewind ? -35 * root.bump(root.p, 0.45)
        : 0;
    property <float> sx:
        root.m == IconMotion.pop ? 1 + 0.14 * root.bump(root.p, 0.4)
        : root.m == IconMotion.shutter ? 1 - 0.4 * root.bump(root.p, 0.45)
        : root.m == IconMotion.wave ? 1 + root.tri(root.p, 0.3, -0.18, 0.65, 0.04)
        : 1;
    property <float> sy:
        root.m == IconMotion.pop ? 1 + 0.14 * root.bump(root.p, 0.4)
        : root.m == IconMotion.shutter ? 1 - 0.4 * root.bump(root.p, 0.45)
        : 1;
    property <float> ink: root.m == IconMotion.flash ? 1 - 0.65 * root.flash-v : 1;
    // `draw` (the DS's stroke-dashoffset) is a clip that widens left to right
    // across the tick: slint's `Path` has no dash. Full at rest.
    property <bool> drawing: root.m == IconMotion.draw && root.p > 0 && root.p < 1;
    property <float> draw-x0: root.commands == Icons.success ? 6.25 : 3.75;
    property <float> draw-x1: root.commands == Icons.success ? 14 : 16.25;
    property <length> drawn-width: root.drawing
        ? root.unit * (root.draw-x0 + (root.draw-x1 - root.draw-x0) * root.seg(root.p, 0, 1))
        : root.size;

    // `Motion.easing-standard` (cubic-bezier(0.2, 0, 0, 1)) as a Kumaraswamy
    // curve, 1 - (1 - x^1.45)^5.85: max |error| 0.054 against the bezier, with
    // `x` used once. A Newton solve of the bezier nests its argument and slint
    // inlines functions, which grew the generated app.rs from 12 MB to 93 MB.
    pure function ease(x: float) -> float { return 1 - pow(1 - pow(x, 1.45), 5.85); }
    // Eased progress through the keyframe segment [a, b].
    pure function seg(p: float, a: float, b: float) -> float {
        return root.ease(clamp((p - a) / (b - a), 0, 1));
    }
    // rest -> 1 at k -> rest.
    pure function bump(p: float, k: float) -> float {
        return p < k ? root.seg(p, 0, k) : 1 - root.seg(p, k, 1);
    }
    // rest -> v1 at k1 -> v2 at k2 -> rest.
    pure function tri(p: float, k1: float, v1: float, k2: float, v2: float) -> float {
        return p < k1 ? v1 * root.seg(p, 0, k1)
            : p < k2 ? v1 + (v2 - v1) * root.seg(p, k1, k2)
            : v2 * (1 - root.seg(p, k2, 1));
    }
    // rest -> 1 at 0.5 -> rest, linear (`flash` is the one linear keyframe set).
    pure function tent(u: float) -> float { return u < 0.5 ? u * 2 : 2 - u * 2; }
    pure function duration-of(m: IconMotion) -> duration {
        return m == IconMotion.pop || m == IconMotion.turn ? 320ms
            : m == IconMotion.shutter ? 380ms
            : m == IconMotion.nudge-right || m == IconMotion.nudge-left
                || m == IconMotion.nudge-down || m == IconMotion.nudge-up ? 360ms
            : m == IconMotion.latch || m == IconMotion.draw || m == IconMotion.bob
                || m == IconMotion.flash ? 420ms
            : m == IconMotion.lid || m == IconMotion.snip || m == IconMotion.rewind ? 520ms
            : m == IconMotion.wave ? 560ms
            : 460ms;
    }

    pure function grid-of(c: string) -> int {
        if (c == Icons.clock) { return 24; }
        if (c == Icons.gap) { return 24; }
        if (c == Icons.loading) { return 24; }
        if (c == Icons.reset) { return 24; }
        return 20;
    }

    pure function motion-of(c: string) -> IconMotion {
        if (c == Icons.capture) { return IconMotion.shutter; }
        if (c == Icons.sessions) { return IconMotion.rewind; }
        if (c == Icons.play) { return IconMotion.nudge-right; }
        if (c == Icons.go-live) { return IconMotion.dash; }
        if (c == Icons.repeat) { return IconMotion.rewind; }
        if (c == Icons.record) { return IconMotion.shutter; }
        if (c == Icons.marker) { return IconMotion.wave; }
        if (c == Icons.marker-fill) { return IconMotion.wave; }
        if (c == Icons.scissors) { return IconMotion.snip; }
        if (c == Icons.export) { return IconMotion.rise; }
        if (c == Icons.screenshot) { return IconMotion.shutter; }
        if (c == Icons.bolt) { return IconMotion.flash; }
        if (c == Icons.search) { return IconMotion.tilt; }
        if (c == Icons.plus) { return IconMotion.turn; }
        if (c == Icons.check) { return IconMotion.draw; }
        if (c == Icons.close) { return IconMotion.turn; }
        if (c == Icons.pencil) { return IconMotion.tilt; }
        if (c == Icons.discard) { return IconMotion.lid; }
        if (c == Icons.lock) { return IconMotion.latch; }
        if (c == Icons.unlock) { return IconMotion.latch; }
        if (c == Icons.folder) { return IconMotion.bob; }
        if (c == Icons.folder-open) { return IconMotion.bob; }
        if (c == Icons.external) { return IconMotion.slide-out; }
        if (c == Icons.import) { return IconMotion.sink; }
        if (c == Icons.success) { return IconMotion.draw; }
        if (c == Icons.caret-down) { return IconMotion.nudge-down; }
        if (c == Icons.chevron-up) { return IconMotion.nudge-up; }
        if (c == Icons.chevron-left) { return IconMotion.nudge-left; }
        if (c == Icons.caret) { return IconMotion.nudge-right; }
        return IconMotion.pop;
    }

    pure function solid-of(c: string) -> string {
        if (c == Icons.review) { return Icons.review-solid; }
        if (c == Icons.play) { return Icons.play-solid; }
        if (c == Icons.pause) { return Icons.pause-solid; }
        if (c == Icons.seek) { return Icons.seek-solid; }
        if (c == Icons.seek-forward) { return Icons.seek-forward-solid; }
        if (c == Icons.step-back) { return Icons.step-back-solid; }
        if (c == Icons.step-forward) { return Icons.step-forward-solid; }
        if (c == Icons.rate) { return Icons.rate-solid; }
        if (c == Icons.record) { return Icons.record-solid; }
        if (c == Icons.stop) { return Icons.stop-solid; }
        if (c == Icons.more) { return Icons.more-solid; }
        if (c == Icons.info) { return Icons.info-solid; }
        if (c == Icons.warning) { return Icons.warning-solid; }
        if (c == Icons.theme) { return Icons.theme-solid; }
        return "";
    }

    pure function part-a-of(c: string) -> string {
        if (c == Icons.capture) { return Icons.capture-a; }
        if (c == Icons.go-live) { return Icons.go-live-a; }
        if (c == Icons.marker) { return Icons.marker-a; }
        if (c == Icons.marker-fill) { return Icons.marker-fill-a; }
        if (c == Icons.export) { return Icons.export-a; }
        if (c == Icons.screenshot) { return Icons.screenshot-a; }
        if (c == Icons.discard) { return Icons.discard-a; }
        if (c == Icons.lock) { return Icons.lock-a; }
        if (c == Icons.unlock) { return Icons.unlock-a; }
        if (c == Icons.external) { return Icons.external-a; }
        if (c == Icons.import) { return Icons.import-a; }
        if (c == Icons.success) { return Icons.success-a; }
        return "";
    }

    pure function part-a-solid-of(c: string) -> string {
        if (c == Icons.capture) { return Icons.capture-a-solid; }
        if (c == Icons.marker-fill) { return Icons.marker-fill-a-solid; }
        return "";
    }

    pure function part-b-of(c: string) -> string {
        if (c == Icons.scissors) { return Icons.scissors-b; }
        return "";
    }

    pure function origin-x-of(c: string) -> float {
        if (c == Icons.marker) { return 5; }
        if (c == Icons.marker-fill) { return 5; }
        if (c == Icons.scissors) { return 11.24; }
        if (c == Icons.screenshot) { return 10; }
        if (c == Icons.discard) { return 3.5; }
        return root.grid / 2;
    }

    pure function origin-y-of(c: string) -> float {
        if (c == Icons.marker) { return 7.75; }
        if (c == Icons.marker-fill) { return 7.75; }
        if (c == Icons.scissors) { return 10; }
        if (c == Icons.screenshot) { return 10.75; }
        if (c == Icons.discard) { return 5.5; }
        return root.grid / 2;
    }

    // Transforms sit on children: on a component's root they are dropped
    // silently (KNOWLEDGE, `transform-scale`). A glyph with a moving part moves
    // only the part; any other glyph moves whole.
    Rectangle {
        x: root.moves-part ? 0 : root.unit * root.dx;
        y: root.moves-part ? 0 : root.unit * root.dy;
        width: root.size;
        height: root.size;
        opacity: root.ink;
        transform-origin: { x: root.unit * root.origin-x, y: root.unit * root.origin-y };
        transform-rotation: root.moves-part ? 0deg : root.rot * 1deg;
        transform-scale-x: root.moves-part ? 1 : root.sx;
        transform-scale-y: root.moves-part ? 1 : root.sy;

        Rectangle {
            x: 0;
            y: 0;
            width: root.moves-part ? root.size : root.drawn-width;
            height: root.size;
            clip: true;

            Path {
                x: 0;
                y: 0;
                width: root.size;
                height: root.size;
                viewbox-x: root.vb-inset;
                viewbox-y: root.vb-inset;
                viewbox-width: root.vb-size;
                viewbox-height: root.vb-size;
                commands: root.commands;
                stroke: root.stroke-color;
                stroke-width: root.weight;
                // Round caps: the `h.01` dots are zero-length segments and only
                // exist as ink because of the cap.
                stroke-line-cap: round;
                stroke-line-join: round;
                fill: root.fill-color;
            }

            if root.solid != "": Path {
                x: 0;
                y: 0;
                width: root.size;
                height: root.size;
                viewbox-x: root.vb-inset;
                viewbox-y: root.vb-inset;
                viewbox-width: root.vb-size;
                viewbox-height: root.vb-size;
                commands: root.solid;
                stroke: root.solid-ink;
                stroke-width: root.weight;
                stroke-line-cap: round;
                stroke-line-join: round;
                fill: root.solid-ink;
            }

        }

        if root.moves-part: Rectangle {
            x: root.unit * root.dx;
            y: root.unit * root.dy;
            width: root.size;
            height: root.size;
            transform-origin: { x: root.unit * root.origin-x, y: root.unit * root.origin-y };
            transform-rotation: root.rot * 1deg;
            transform-scale-x: root.sx;
            transform-scale-y: root.sy;

            Rectangle {
                x: 0;
                y: 0;
                width: root.drawn-width;
                height: root.size;
                clip: true;

                Path {
                    x: 0;
                    y: 0;
                    width: root.size;
                    height: root.size;
                    viewbox-x: root.vb-inset;
                    viewbox-y: root.vb-inset;
                    viewbox-width: root.vb-size;
                    viewbox-height: root.vb-size;
                    commands: root.part-a;
                    stroke: root.stroke-color;
                    stroke-width: root.weight;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                    fill: transparent;
                }

                if root.part-a-solid != "": Path {
                    x: 0;
                    y: 0;
                    width: root.size;
                    height: root.size;
                    viewbox-x: root.vb-inset;
                    viewbox-y: root.vb-inset;
                    viewbox-width: root.vb-size;
                    viewbox-height: root.vb-size;
                    commands: root.part-a-solid;
                    stroke: root.solid-ink;
                    stroke-width: root.weight;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                    fill: root.solid-ink;
                }
            }
        }
    }

    // The scissors' second blade closes the other way. A sibling of the
    // rectangle above, not its child: the scissors have no `-a` part, so that
    // rectangle turns the whole glyph by `rot`, and a child's `-rot` cancelled
    // it -- the lower blade never moved (t260928-d906).
    if root.part-b != "": Path {
        x: 0;
        y: 0;
        width: root.size;
        height: root.size;
        opacity: root.ink;
        viewbox-x: root.vb-inset;
        viewbox-y: root.vb-inset;
        viewbox-width: root.vb-size;
        viewbox-height: root.vb-size;
        transform-origin: { x: root.unit * root.origin-x, y: root.unit * root.origin-y };
        transform-rotation: -root.rot * 1deg;
        commands: root.part-b;
        stroke: root.stroke-color;
        stroke-width: root.weight;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
    }
}

// The caption buttons' glyphs: the DS win-* set, 1px like the Windows caption
// buttons. The 20px box puts the 10-unit glyph at 10px, where the old 12px box
// with a 10 viewbox drew it at 9.6px. The viewbox is narrowed by the 1px
// stroke for the same reason as `AppIcon`'s (header comment).
export component CaptionIcon {
    in property <string> commands;
    in property <color> stroke-color;

    width: 20px;
    height: 20px;

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0.5;
        viewbox-y: 0.5;
        viewbox-width: 19;
        viewbox-height: 19;
        commands: root.commands;
        stroke: root.stroke-color;
        stroke-width: 1px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
    }
}
