// The review timeline (round5 §4-B, task171; DS Timeline since
// t260927-77b8): an 18px ruler over a 36px lane. In the lane, a rounded
// groove with the played part in `accent`, seams where the recording has
// holes, the selection as an `accent-soft` band with its two handles, one-colour
// marker pins, the live edge in `live` with its lamp, and a playhead whose
// knob is always on screen.
//
// The same component draws on the stage (the band laid over the video, the
// `Dark` island) and under it (the band docked below the stage, following the
// theme). `dock` says how far between the two it is -- 0 floating, 1 docked --
// and every colour below is the docked one mixed with the floating one by it,
// so the part colours cross over with the band's ground while it slides.
// Everything stateful lives on the ReviewVm global; this file only draws it
// and forwards the same pointer callbacks the wiring already answers.

import { Dark, Tokens, Motion } from "tokens.slint";
import { TallyLamp } from "controls.slint";
import { ReviewVm } from "review_vm.slint";

export component ReviewTrackWrap inherits Rectangle {
    // Rung when a press lands on the track and key focus should return to
    // the pane's FocusScope.
    callback request-focus();
    // 0 = over the video, 1 = docked under it (`review.slint`'s `dock`).
    in property <float> dock;

    // DS: ruler 18 + lane 36.
    height: 54px;

    property <length> ruler-h: 18px;
    property <length> lane-y: root.ruler-h;
    // The lane is the slider, and its hover / drag is what thickens the groove.
    property <bool> active: touch.has-hover || ReviewVm.dragging;
    // DS `is-at-live`: following the live edge while it records.
    property <bool> at-live: ReviewVm.live-edge-visible && ReviewVm.live-following;

    // Docked colour, floating colour. Each argument is used once, so the
    // inlining a slint function gets costs nothing (KNOWLEDGE, t260927-0e84).
    pure function tone(docked: color, floating: color) -> color {
        return docked.mix(floating, root.dock);
    }

    // Declared first so everything drawn afterwards -- the markers and the
    // range band, which carry their own TouchAreas -- sits above it and wins
    // the hit test (task194-C). `x` is 0 and the width is the track's, so
    // `mouse-x / width` is the ratio the handlers already divide by.
    touch := TouchArea {
        mouse-cursor: pointer;

        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.request-focus();
                // Shift: a sweep that draws a new range (t260928-88a2).
                ReviewVm.track-pressed(touch.mouse-x / root.width, event.modifiers.shift);
            }
            if (event.kind == PointerEventKind.up) {
                ReviewVm.track-released(touch.mouse-x / root.width);
            }
            if (event.kind == PointerEventKind.move) {
                ReviewVm.track-moved(touch.mouse-x / root.width, touch.has-hover);
            }
            if (event.kind == PointerEventKind.cancel) {
                // `track-exited` alone left `dragging` stuck true, which
                // froze the playhead (pump ignores the engine position
                // while dragging) until the next press.
                ReviewVm.track-cancelled();
            }
        }

        scroll-event(event) => {
            if (ReviewVm.track-wheel(
                touch.mouse-x / root.width, event.delta-y / 1px,
                event.modifiers.control, event.modifiers.shift)) {
                return accept;
            }
            return reject;
        }

        double-clicked => {
            ReviewVm.track-double-clicked();
        }

        changed has-hover => {
            if (!self.has-hover) {
                ReviewVm.track-exited();
            }
        }
    }

    // ---------- ruler ----------
    // Ticks sit on the ruler's floor, 2px up; labels 5px right of their tick.
    for tick in ReviewVm.ruler-ticks: Rectangle {
        x: root.width * tick.percent / 100 - 0.5px;
        y: root.ruler-h - 2px - self.height;
        width: 1px;
        height: tick.major ? 8px : 4px;
        background: tick.major
            ? root.tone(Tokens.ink-faint, Dark.on-stage-muted)
            : root.tone(Tokens.line-strong, #ffffff33);

        if tick.label != "": Text {
            x: 5px;
            // t260928-970c: a label that would run into LIVE is dropped, or
            // the last one reads on as `0:30LIVE`. No LIVE (zoomed into the
            // past), no change.
            visible: !live.visible || parent.x + self.x + self.width <= live.x - 6px;
            y: parent.height + 1px - self.height;
            text: tick.label;
            font-family: Tokens.font-family-mono;
            // DS 10.5px, rounded: the README keeps to whole pixels.
            font-size: Tokens.type-overline-size;
            font-weight: Tokens.type-label-weight;
            color: root.tone(Tokens.ink-faint, Dark.on-stage-muted);
        }
    }

    // Only while the live edge is on the track (t260928-ac18): zoomed into
    // the past, the right end is not live.
    // `visible`, not `if`: the ruler labels above read its x and width.
    live := Text {
        visible: ReviewVm.live-edge-visible && ReviewVm.live-visible;
        x: root.width - 8px - self.width;
        y: root.ruler-h - 1px - self.height;
        text: "LIVE";
        font-family: Tokens.font-family-mono;
        font-size: Tokens.type-overline-size;
        font-weight: Tokens.type-overline-weight;
        letter-spacing: Tokens.type-overline-letter-spacing;
        color: root.tone(Tokens.live-text, Dark.live-text);
    }

    // ---------- lane ----------
    lane := Rectangle {
        y: root.lane-y;
        width: root.width;
        height: 36px;

        // Rust decides how each gap is drawn, and it needs the pixels to do
        // it. `init` as well as `changed`: the first paint of a freshly loaded
        // session used to run with a width of 0 (task380).
        init => {
            ReviewVm.track-resized(self.width / 1px);
        }

        changed width => {
            ReviewVm.track-resized(self.width / 1px);
        }

        // The groove: 6px at 15, 8px at 14 under the pointer or a drag.
        groove := Rectangle {
            y: root.active ? 14px : 15px;
            width: parent.width;
            height: root.active ? 8px : 6px;
            animate y, height {
                duration: Tokens.duration-fast;
                easing: Motion.easing-standard;
            }
            border-radius: self.height / 2;
            clip: true;
            background: root.tone(Tokens.line-strong, #ffffff33);

            // `.played`: what lies behind the playhead.
            Rectangle {
                x: 0;
                width: parent.width * ReviewVm.played-percent / 100;
                height: 100%;
                background: root.tone(Tokens.accent, Dark.accent);
            }

            // DS `.lb-tl__fade`: the old end dissolving into the ground while
            // the ring overwrites it (t260928-2f77). Over the played part,
            // under the seams.
            if ReviewVm.overwriting: Rectangle {
                x: 0;
                width: parent.width * 5%;
                height: 100%;
                background: @linear-gradient(90deg,
                    root.tone(Tokens.surface, #000000) 0%,
                    root.tone(Tokens.surface, #000000).with-alpha(0) 100%);
            }

            // ---------- seams ----------
            // The gap is cut out of the groove rather than painted over it,
            // so what shows through is the band's own ground.
            for g in ReviewVm.gaps: Rectangle {
                x: g.single
                    ? parent.width * g.left / 100 - 1px
                    : parent.width * g.left / 100;
                width: g.single ? 2px : max(2px, parent.width * g.width / 100);
                height: 100%;
                background: g.single
                    ? root.tone(Tokens.ink-faint, Dark.on-stage-muted)
                    : root.tone(Tokens.surface, #000000);
            }
        }

        // ---------- the selection (DS `.lb-tl__range`) ----------
        // `accent-soft` with a 1px `accent` edge each side, 3px in from the
        // lane's top and bottom; nothing outside it is dimmed any more.
        if ReviewVm.has-range: range := Rectangle {
            x: parent.width * ReviewVm.range-start-percent / 100;
            y: 3px;
            width: parent.width * (ReviewVm.range-end-percent - ReviewVm.range-start-percent) / 100;
            height: parent.height - 6px;
            border-radius: 3px;
            background: root.tone(Tokens.accent-soft, Dark.accent-soft);

            Rectangle {
                x: 0;
                width: 1px;
                background: root.tone(Tokens.accent, Dark.accent);
            }

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: root.tone(Tokens.accent, Dark.accent);
            }

            // The length, flush with the band's right end (t260928-88a2),
            // pushed back right when the band starts too near the track's
            // left edge to hold it.
            Rectangle {
                x: max(-parent.x, parent.width - self.width);
                y: -21px;
                width: range-label.preferred-width + 12px;
                height: 17px;
                border-radius: Tokens.radius-xs;
                background: root.tone(Tokens.accent, Dark.accent);

                range-label := Text {
                    text: ReviewVm.range-length-text + ReviewVm.range-length-frac;
                    font-family: Tokens.font-family-mono;
                    font-size: Tokens.type-key-size;
                    font-weight: Tokens.type-key-weight;
                    color: root.tone(Tokens.on-accent, Dark.on-accent);
                }
            }
        }

        // The two handles, 6x20 with a faint grip, live whenever there is a
        // range (t260927-7d08; the grab zones are further down).
        // `*-handle-visible` is whether the end is inside the viewport.
        if ReviewVm.has-range && ReviewVm.range-start-handle-visible: Rectangle {
            x: parent.width * ReviewVm.range-start-percent / 100 - 3px;
            y: (parent.height - 20px) / 2;
            width: 6px;
            height: 20px;
            border-radius: 3px;
            background: root.tone(Tokens.accent, Dark.accent);

            Rectangle {
                x: 2px;
                y: 6px;
                width: 2px;
                height: 8px;
                border-radius: 1px;
                background: root.tone(Tokens.on-accent, Dark.on-accent);
                opacity: 0.4;
            }
        }
        if ReviewVm.has-range && ReviewVm.range-end-handle-visible: Rectangle {
            x: parent.width * ReviewVm.range-end-percent / 100 - 3px;
            y: (parent.height - 20px) / 2;
            width: 6px;
            height: 20px;
            border-radius: 3px;
            background: root.tone(Tokens.accent, Dark.accent);

            Rectangle {
                x: 2px;
                y: 6px;
                width: 2px;
                height: 8px;
                border-radius: 1px;
                background: root.tone(Tokens.on-accent, Dark.on-accent);
                opacity: 0.4;
            }
        }

        // ---------- the live edge ----------
        // Red is the edge's line and its lamp and nothing else (DS: the
        // groove is never painted `live`), and only while it records (DS
        // `live`). The lamp stays lit -- the rail's record lamp is the one
        // thing on screen that blinks.
        if ReviewVm.live-visible && ReviewVm.live-edge-visible: Rectangle {
            x: ReviewVm.live-pinned
                ? parent.width - 1px
                : parent.width * ReviewVm.live-percent / 100 - 1px;
            y: 4px;
            width: 2px;
            height: parent.height - 8px;
            border-radius: 1px;
            background: root.tone(Tokens.live, Dark.live);

            TallyLamp {
                x: -3px;
                y: -8px;
            }
        }

        // ---------- markers ----------
        // One colour, a pin: a 2px stem at 60% under a diamond head. Above the
        // track's TouchArea so a click jumps to the marker instead of seeking
        // to wherever the pointer landed; the hit is 14px wide.
        for m in ReviewVm.markers: Rectangle {
            x: parent.width * m.left / 100 - 7px;
            width: 14px;
            height: parent.height;

                pin := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    ReviewVm.marker-clicked(m.row);
                }
                // A double click opens the panel on this row (t260928-88a2);
                // a single one only seeks.
                double-clicked => {
                    ReviewVm.marker-focus-row = m.row;
                    ReviewVm.marker-focus-token += 1;
                }
            }

            Rectangle {
                x: 6px;
                y: 8px;
                width: 2px;
                height: parent.height - 14px;
                border-radius: 1px;
                background: root.tone(Tokens.marker, Dark.marker);
                opacity: 0.6;
            }

            Rectangle {
                x: 2px;
                y: 0;
                width: 10px;
                height: 10px;
                border-radius: 2px;
                background: root.tone(Tokens.marker, Dark.marker);
                transform-rotation: 45deg;
                transform-scale: pin.has-hover ? 1.0 : 0.78;
                animate transform-scale {
                    duration: Tokens.duration-fast;
                    easing: Motion.easing-standard;
                }
            }

            // The name and the time, over the pin while it is hovered.
            if pin.has-hover: Rectangle {
                x: (parent.width - self.width) / 2;
                y: -26px - self.height;
                width: marker-label.preferred-width;
                height: 24px;
                border-radius: Tokens.radius-sm;
                background: root.tone(Tokens.marker, Dark.marker);
                drop-shadow-offset-y: Tokens.shadow-overlay-offset-y;
                drop-shadow-blur: Tokens.shadow-overlay-blur;
                drop-shadow-color: Tokens.shadow-overlay-color;

                marker-label := HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;

                    Text {
                        text: m.label == "" ? ReviewVm.marker-unnamed : m.label;
                        vertical-alignment: center;
                        font-size: Tokens.type-caption-size;
                        font-weight: Tokens.type-body-strong-weight;
                        color: root.tone(Tokens.on-marker, Dark.on-marker);
                    }

                    Text {
                        text: m.time;
                        vertical-alignment: center;
                        font-family: Tokens.font-family-mono;
                        font-size: Tokens.type-overline-size;
                        font-weight: Tokens.type-label-weight;
                        opacity: 0.75;
                        color: root.tone(Tokens.on-marker, Dark.on-marker);
                    }
                }
            }
        }

        // ---------- the range's two handles (round8 §2, t260927-7d08) ----------
        // Live whenever there is a range: the 確定ステップ that used to gate
        // them is gone (user ruling 2026-09-27, DS ReviewScreen 「範囲は
        // タイムラインの取っ手でいつでも詰められる」). Only the two ends take a
        // press -- the DS Timeline gives the handles `pointerDown` and nothing
        // else in the band -- so a press or a drag inside the selection is the
        // track's own seek and scrub, exactly as outside it. The band's middle
        // drag (a pan) went with the gate: on a fresh load the range is the
        // whole session, and a live middle zone would have turned every scrub
        // into a pan.
        //
        // Drawn after the markers so the ends win the overlap with a pin.
        if ReviewVm.has-range: sel := Rectangle {
            // Half the width of an end's grab zone. The zone *straddles* the
            // edge, so each end answers to 20px of track, 10px of it outside
            // the band -- where the pointer is when you aim at the handle,
            // which is drawn centred on the edge.
            property <length> edge: 10px;
            property <bool> moved;

            x: parent.width * ReviewVm.range-start-percent / 100;
            width: parent.width * (ReviewVm.range-end-percent - ReviewVm.range-start-percent) / 100;
            height: parent.height;

            for mode in [0, 1]: TouchArea {
                // The end's own x in the band, and its zone around it.
                x: (mode == 0 ? 0px : sel.width) - sel.edge;
                width: 2 * sel.edge;
                mouse-cursor: MouseCursor.ew-resize;

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        sel.moved = false;
                        // task3160: the edge is settled, so Rust can pause
                        // and know which end it will be following.
                        ReviewVm.range-drag-changed(true, mode);
                    }
                    if (event.kind == PointerEventKind.move && self.pressed) {
                        sel.moved = true;
                        // Shift: the playhead rides the handle (t260928-88a2).
                        ReviewVm.handle-moved(mode,
                            (sel.x + self.x + self.mouse-x) / lane.width,
                            event.modifiers.shift);
                    }
                    // task3160. `-1` for a gesture that never moved, so the
                    // press-through below is the only thing that seeks. A
                    // cancelled pointer never sends `up`, so it lands here too.
                    if (event.kind == PointerEventKind.up
                        || event.kind == PointerEventKind.cancel) {
                        ReviewVm.range-drag-changed(false,
                            sel.moved ? mode : -1);
                    }
                    if (event.kind == PointerEventKind.up && !sel.moved) {
                        // Press-through: the same pair the track's own
                        // TouchArea sends.
                        ReviewVm.track-pressed((sel.x + self.x + self.mouse-x) / lane.width, false);
                        ReviewVm.track-released((sel.x + self.x + self.mouse-x) / lane.width);
                    }
                }
            }
        }
    }

    // ---------- the playhead ----------
    // A 2px `ink` line from the ruler's top to 4px above the lane's floor,
    // and a 14px knob that is always there (DS: not hover-only any more).
    // Pointer-transparent: nothing here has a TouchArea.
    if ReviewVm.playhead-visible: Rectangle {
        x: root.width * ReviewVm.playhead-percent / 100 - 1px;
        y: 0;
        width: 2px;
        height: root.lane-y + 36px - 4px;
        border-radius: 1px;
        background: root.tone(Tokens.ink, Dark.on-stage);

        // Caught up with the live edge: a 4px `live-soft` ring.
        if root.at-live: Rectangle {
            x: (parent.width - self.width) / 2;
            y: root.lane-y + 12px - 4px;
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: root.tone(Tokens.live-soft, Dark.live-soft);
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: root.lane-y + 12px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: root.tone(Tokens.ink, Dark.on-stage);
            drop-shadow-offset-y: Tokens.shadow-raised-offset-y;
            drop-shadow-blur: Tokens.shadow-raised-blur;
            drop-shadow-color: Tokens.shadow-raised-color;
            transform-scale: ReviewVm.dragging ? 1.15 : 1.0;
            animate transform-scale {
                duration: Tokens.duration-fast;
                easing: Motion.easing-standard;
            }
        }
    }

    // ---------- hover: a 1px line, the time and the preview ----------
    // The line stands where the pointer is; only the time and the preview
    // are kept on the track, each by its own x (t260928-ac18, review 06 F4).
    if ReviewVm.hover-visible && !ReviewVm.dragging: Rectangle {
        x: root.width * ReviewVm.hover-anchor / 100;
        y: 0;
        width: 1px;
        height: root.lane-y + 36px - 4px;
        background: root.tone(Tokens.ink-muted, Dark.on-stage-muted);
        opacity: 0.9;

        // 176px at 16:9, 30px over the line's top (DS `.lb-tl__preview`).
        Rectangle {
            x: Math.clamp(-self.width / 2, -parent.x, root.width - parent.x - self.width);
            y: -30px - self.height;
            width: 176px;
            height: 99px;
            border-radius: Tokens.radius-sm;
            border-width: 1px;
            border-color: Tokens.line-strong;
            background: Tokens.stage;
            clip: true;
            drop-shadow-offset-y: Tokens.shadow-overlay-offset-y;
            drop-shadow-blur: Tokens.shadow-overlay-blur;
            drop-shadow-color: Tokens.shadow-overlay-color;

            // No thumbnail yet (segment not finalized / write failed): the
            // bare stage. The flag drives opacity rather than existence
            // (task183, the conditional-child quirk).
            Image {
                width: 100%;
                height: 100%;
                image-fit: cover;
                source: ReviewVm.hover-thumbnail;
                opacity: ReviewVm.hover-has-thumbnail ? 1.0 : 0.0;
            }
        }

        Rectangle {
            x: Math.clamp(-self.width / 2, -parent.x, root.width - parent.x - self.width);
            y: -4px - self.height;
            width: hover-time.preferred-width + 12px;
            height: 20px;
            border-radius: Tokens.radius-xs;
            border-width: 1px;
            border-color: Tokens.line-strong;
            background: Tokens.overlay;
            drop-shadow-offset-y: Tokens.shadow-overlay-offset-y;
            drop-shadow-blur: Tokens.shadow-overlay-blur;
            drop-shadow-color: Tokens.shadow-overlay-color;

            hover-time := Text {
                text: ReviewVm.hover-time;
                font-family: Tokens.font-family-mono;
                font-size: Tokens.type-overline-size;
                font-weight: Tokens.type-label-weight;
                color: Tokens.ink;
            }
        }
    }
}
