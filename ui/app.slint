// Bundled so the app renders the same on machines without Noto Sans JP
// installed (round7 section 3). 400 / 600 / 700, OFL-1.1 -- assets/fonts/OFL.txt.
import "../assets/fonts/NotoSansJP-Regular.ttf";
import "../assets/fonts/NotoSansJP-SemiBold.ttf";
import "../assets/fonts/NotoSansJP-Bold.ttf";
import { Tokens } from "tokens.slint";
import { Icons, AppIcon, CaptionIcon } from "icons.slint";
import { TargetTile, TileMedia } from "targets.slint";
import { PickerModal } from "picker_modal.slint";
import { SessionsPane, SessionRow, SessionLabels } from "sessions.slint";
import { ClipsPane, ClipRow, ClipLabels } from "clips.slint";
import { SettingsPane, SettingsLabels, SettingsVm } from "settings.slint";
import { AutoCaptureEntry } from "settings_vm.slint";
import { ReviewPane, ReviewEmpty, ReviewVm, TrackSpan, GapSpan, MarkerSpan, MarkerRow } from "review.slint";
import { ClipVm } from "clip_vm.slint";
import { PillVariant, Pill, Btn, RuleV, Toast, ToastVariant, MenuEntry, InlineEditVm } from "controls.slint";
import { TrayIcon } from "tray.slint";
import { DropOverlay, DropVm } from "drop_overlay.slint";
import { CaptionButton, RailButton } from "chrome.slint";

// `Icons` is re-exported so the context menu's model, which is built in Rust,
// can read the same glyph data the .slint side draws with (task184).
export { TargetTile, TileMedia, SessionRow, SessionLabels, ClipRow, ClipLabels, MenuEntry, PillVariant, SettingsLabels, SettingsVm, AutoCaptureEntry, ReviewVm, ClipVm, TrackSpan, GapSpan, MarkerSpan, MarkerRow, TrayIcon, Icons, DropVm, Tokens }

// The window shell: title bar, rail, panes, and the toast in the corner
// (task169, round5 §3). Screens 124-129 fill the pane; everything else here is
// the frame they sit in.
//
// The rail is back and the pane headers are gone: the rail says where you are,
// so a title repeated at the top of every pane said it twice. There is no
// status bar -- see `chrome.slint` for why, and the `Toast` below for what
// replaced it.


export component AppWindow inherits Window {
    title: "Liveback";
    // The OS window icon (taskbar thumbnail preview, Alt+Tab switcher). Winit
    // sets no HICON unless `Window.icon` is given, and the exe resource build.rs
    // embeds is not picked up for this frameless window (task2480).
    icon: @image-url("../assets/app-icon/liveback-32.png");
    // Matches the Tauri version's `decorations: false` + hand-built title bar.
    no-frame: true;
    // Zero while maximized. The corners are just the two bands crossing (slint
    // 1.17.1 `i-slint-backend-winit/drag_resize_window.rs::get_resize_direction`
    // -- there is no separate, larger corner zone), and at the top-right that
    // square lands on the close button: a click at the very screen corner
    // resizes instead of closing. chrome-overrides.css records the same corner
    // being eaten in the WebView build (task094); that build squared off its
    // rounded shell for it, this one gives up the resize handles, since a
    // maximized window has nothing to drag. Full screen has no edge to drag
    // either, and a resize border there would eat clicks on the video (task152).
    resize-border-width: (root.maximized || root.any-fullscreen) ? 0px : root.resize-band-width;
    // **Logical** pixels, as a `length` should be (task4120, re-unitised for
    // slint 1.18). 1.17.1's winit backend compared this number against
    // `PhysicalPosition`/`PhysicalSize` without converting it, so task4120 had
    // Rust pre-scale it by the dpi; 1.18 does that multiply itself
    // (`drag_resize_window.rs`: `border_width.get() * window.scale_factor()`),
    // and the pre-scaling left over from 1.17.1 squared the factor -- 18
    // physical px at 150% where 12 was meant. Rust still sets it, now with
    // `ui_state::shell::resize_band_slint_px`, so the one place that knows the
    // band's width stays in Rust and the `resize band set` log line can name
    // both units. The default is the same 8, so the band is right even if that
    // setter never runs.
    in property <length> resize-band-width: 8px;
    default-font-family: Tokens.font-family;
    default-font-size: Tokens.type-body-size;
    // Transparent: the full-window rectangle below carries the window ground
    // (`Tokens.chrome-rail`, 55 % / light 60 %) and the pane panel the one
    // deliberate layer over it (round25 §1, t260919-ee8c). A third layer here
    // would push both toward opaque (t260916-ebdb).
    background: transparent;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 720px;
    min-height: 480px;

    // The shell's "something is playing full screen" flag (task3510). The three
    // places below that fold the chrome away used to name `ReviewVm.fullscreen`
    // directly; the clip player is a second thing that can take the display, and
    // the window chrome does not care which one did. One property so a third
    // never has to find all three sites again.
    property <bool> any-fullscreen: ReviewVm.fullscreen || ClipVm.fullscreen;

    // The pane panel (round25 §4-2, mock `.pane` / `.hist` / `.clips` /
    // `.setwrap`, t260919-ee8c): margins measured from the client edge (the
    // mock's `.win` border has no in-client counterpart -- DWM draws the
    // frame outside the client, `desktop.rs` `set_window_border_color`), so
    // 8 / 8 / 0 top / right / left. The bottom is 8 under 確認 and 32 under the
    // other three, whose 32px holds the count line (`.clipfoot`). Full screen
    // drops the margins, the frame and the corners with them (`.win.fs .pane`).
    // The mock's values, not the MD's 10px (the MD declares the mock right).
    property <length> panel-top: root.any-fullscreen ? 0px : 8px;
    property <length> panel-right: root.any-fullscreen ? 0px : 8px;
    property <length> panel-bottom:
        root.any-fullscreen ? 0px : root.active-pane == 0 ? 8px : 32px;
    property <length> panel-border: root.any-fullscreen ? 0px : 1px;
    property <length> panel-radius: root.any-fullscreen ? 0px : 7px;

    // Whether the title bar is out (round22 / task4370's latch, see `tblane`).
    // Lives here rather than in `tblane` because the panel reads it too, and
    // an id inside an `if` is invisible to siblings outside it. The sensors
    // that set it and the 0.3s grace `Timer` that clears it stay in `tblane`:
    // they read `tbhot` / `tbhover`, which are inside the `if` (t260919-fd3d).
    property <bool> titlebar-out: false;
    // Reset on *entering* full screen, not on leaving it. `tblane` (and its
    // `init`) is torn down while full screen and rebuilt on the way out --
    // resetting there used to mean: any-fullscreen flips false, panel-drop
    // reads a still-true titlebar-out and drops the panel for a frame, then
    // the freshly (re)created `tblane.init` clears it and the panel snaps
    // back up. Clearing it here instead, the moment full screen starts,
    // means it is already false by the time full screen ends, so panel-drop
    // never has a stale true to read (follow-up of t260919-fd3d).
    changed any-fullscreen => {
        if (self.any-fullscreen) {
            self.titlebar-out = false;
        }
    }
    // round25 §4-1 (t260919-fd3d): while the bar is out the panel's top edge
    // -- frame, top corners, ground -- steps down by the bar's height, so the
    // bar (no fill and, since 2026-09-19, no bottom hairline) sits on window
    // ground and the panel's frame starts right under it: 8 -> 32, the bar's
    // band as tall as the 32px count-line band at the bottom (the user,
    // 2026-09-19: 「タイトルバーの高さ＝フッターの高さくらい」, which dropped the
    // 8px gap round25 had under the bar). The pane inside does not move; the panel only clips
    // its top off (the counter-shift is on the pane's box below). Same
    // duration, curve and trigger as `tb`'s `y`, so the two move as one.
    property <length> panel-drop:
        (root.titlebar-out && !root.any-fullscreen) ? Tokens.titlebar-height - root.panel-top : 0px;
    animate panel-drop {
        duration: Tokens.titlebar-slide-duration;
        easing: Tokens.motion-curve;
    }

    // task4320. The scrollbar lane of every `AppScroll` that reaches the client's
    // right edge has to step in by the width of the band, or the resize band eats
    // the press before the thumb sees it (task4120 measured 3 of the thumb's 4
    // columns inside the band at dpi=96). Same condition as `resize-border-width`
    // above, on purpose: where that one is 0 there is no band, and a lane that
    // stepped in anyway would just be floating for no reason.
    //
    // Pushed into the global on `changed`/`init` rather than bound from there:
    // the panes that need it cannot see this window's properties, and a global
    // property takes no binding from outside itself. Same shape as
    // `InlineEditVm.panel-x` in `review.slint`.
    //
    // round25 (t260919-ee8c) put the panes on a panel with `panel-right` of
    // window ground and a `panel-border` frame to its right, so an AppScroll's
    // lane now ends that far inside the client's right edge. Only what is
    // left of the band past that still has to be stepped over: with 8 + 1 =
    // 9 >= the 8px band it is 0, and it only comes back if the band grows or
    // the margin shrinks.
    property <length> band-inset:
        (root.maximized || root.any-fullscreen)
            ? 0px
            : Math.max(0px, Tokens.resize-band-logical - (root.panel-right + root.panel-border));
    changed band-inset => {
        Tokens.resize-band-inset = self.band-inset;
    }
    init => {
        Tokens.resize-band-inset = self.band-inset;
    }

    // `ui_state::shell::Pane` as an int: 0 確認 / 1 履歴 / 2 設定 / 3 クリップ.
    // 対象 is not one of these -- it is a modal that opens over whichever pane
    // is showing. Note that this is *not* the rail order (task2980): クリップ
    // sits under 履歴 in the rail but took the free pane index, because the 2
    // below is written out by hand twice and moving 設定 would break both
    // without failing.
    in property <int> active-pane: 0;
    in property <bool> picker-open: false;
    // Which rail item draws as `current`, from `shell::rail_current`. Not
    // derived here: while the picker is open it holds the mark, and that rule
    // belongs next to the one that decides what a rail press does.
    in property <int> rail-current: 0;
    // Leaving the settings pane while a hotkey field is armed has to disarm it
    // explicitly (task160): the pane is a conditional element, so switching away
    // destroys the FocusScope without ever reporting the lost focus, and the
    // global hotkeys would stay unregistered. Verified on the machine -- the
    // chord stopped firing until this ran.
    changed active-pane => {
        if (self.active-pane != 2 && SettingsVm.armed != 0) {
            SettingsVm.hk-blurred(SettingsVm.armed);
        }
    }
    // 確認 is the default pane; this only decides whether it has something to
    // show or falls back to its empty state.
    in property <bool> session-loaded: false;
    in property <string> recording-label;
    // Read back by Rust so it can lay the session grid out the same way the pane
    // does and resolve a pointer position to a row (task125). The history pane
    // fills the content column now, which is the window minus the rail.
    out property <length> pane-width: root.width - Tokens.rail-width;
    // The target picker's panel width (round21 §2-1 `min(700px, 100% - 120px)`,
    // no floor since t260913-ec28). Owned here and passed into `PickerModal`
    // rather than computed inside it, because `tbhot` (the title bar's hot
    // zone) has to step around the panel and cannot name an id inside the
    // picker's `if` block (t260917-099c). `root.width` is the picker's own
    // width: it is laid `width: 100%` on the window-filling ground.
    property <length> picker-dialog-width: Math.min(700px, root.width - 120px);

    // ---------- toast (task169, round5 §3-C) ----------
    // Empty title = nothing showing. Timing and "one at a time, latest wins"
    // live in `ui_state::toast`; this side only paints.
    in property <string> toast-title;
    in property <string> toast-detail;
    in property <string> toast-action;
    // `ui_state::toast::ToastVariant` as an int: 0 info / 1 success / 2 error.
    in property <int> toast-variant: 0;
    callback toast-dismissed();
    callback toast-action-clicked();

    in property <string> rail-review-label;
    in property <string> rail-capture-label;
    in property <string> rail-sessions-label;
    in property <string> rail-clips-label;
    in property <string> rail-settings-label;
    // True while `LIVEBACK_BUFFER_ROOT` is set -- an agent or test run, whose
    // recordings and clips go to the override rather than to the user's own
    // folders (task3910). The rail is repainted and takes a badge, because the
    // window is otherwise identical to the everyday one and gets used as it:
    // on 2026-09-12 a sweep-launched instance recorded 23GB of the user's own
    // FFXIV into `%TEMP%` before anyone noticed. Rust writes it once at
    // start-up; nothing can change it while the process lives.
    in property <bool> agent-run;

    // ---------- target picker (task124) ----------
    in property <[TargetTile]> targets;
    in property <string> targets-error-text;
    in property <bool> targets-error-dismissible;
    in property <string> targets-error-dismiss-label;
    in property <string> targets-empty-text;
    in property <bool> targets-empty-is-filter;
    // task2030 判断2: the threshold warning bar's two halves -- the count in
    // 600 weight, the rest in on-surface-variant. Both empty means "below the
    // threshold", which is what the bar's `if` reads.
    in property <string> targets-warning-count;
    in property <string> targets-warning-text;
    // Not the picker's alone: the settings screen's buffer-root guards read
    // this too (`settings_page.rs`), which is why it outlived the title bar's
    // stop button (round8 §1).
    in property <bool> capturing;
    in property <string> search-placeholder;
    in property <string> clear-label;
    in property <string> stop-label;
    // round5 §5 / §11: the modal's own strings. W-6 heading, W-7 / W-8 tabs,
    // W-11 primary badge, W-13 hover button. W-12 is `recording-label` above.
    in property <[string]> picker-tab-labels;
    in property <int> picker-tab;
    in property <string> picker-primary-label;
    in property <string> picker-capture-label;
    in property <string> picker-stop-label;
    in property <string> picker-capture-title;
    in property <string> picker-stop-title;

    callback targets-search-changed(string);
    callback targets-error-dismissed();
    callback target-clicked(string);
    callback picker-opened();
    callback picker-tab-changed(int);
    // `stop-capture()` used to sit here: the picker's "stop everything" door.
    // Task2030 判断5 leaves exactly one of those, in the tray -- the LIVE tile
    // stops its own capture through `target-clicked` now.

    // ---------- session history (task125 / round5 §6) ----------
    in property <[SessionRow]> sessions;
    in property <bool> sessions-thumbnail-view;
    in property <string> sessions-error-text;
    in property <string> sessions-empty-text;
    // The empty state's second line, and which of the two nothings it is
    // (task3800): only "no sessions at all" hides the toolbar.
    in property <string> sessions-empty-sub-text;
    in property <bool> sessions-no-sessions;
    in property <string> sessions-footer-visible-text;
    in property <string> sessions-footer-selected-text;
    in property <int> sessions-editing-row: -1;
    in property <bool> sessions-editing-note;
    in property <[MenuEntry]> sessions-menu-entries;
    in property <bool> sessions-menu-open;
    in property <string> sessions-confirm-title;
    in property <string> sessions-confirm-lead;
    in property <string> sessions-confirm-protected;
    // ---------- clips (task2980) ----------
    in property <[ClipRow]> clips;
    in property <string> clips-empty-text;
    // "There are clips, the search matched none of them" (task3820), which is
    // a different screen from `clips-empty-text`'s "the folder is empty": one
    // keeps the toolbar, the other does not.
    in property <string> clips-filter-empty-text;
    in property <string> clips-footer-text;
    in property <[MenuEntry]> clips-menu-entries;
    in property <bool> clips-menu-open;
    // Which clip row the context menu belongs to, or -1 (task3350). Separate
    // from `clips-menu-open` because the tile needs to know *which* one, so it
    // can say on the picture that this is the tile the menu is acting on.
    in property <int> clips-menu-row: -1;
    // Which clip row has its comment editor open, or -1 (task2990).
    in property <int> clips-editing-row: -1;
    // task3020: which calendar span the grid's date headings cover. Week
    // unless the user says month; not a stored setting.
    in property <bool> clips-month-grouping;
    // Which clip tile is drawn large, or -1 (task3880, round20 §2-1 B案).
    // Raised by a single click on a tile and closed by another click or Esc
    // (task3890); -1 when nothing is expanded.
    in property <int> clips-expanded-row: -1;
    // How many grid lines the clip placement uses, footprint included
    // (`ui_state::clips::line_count`). The pane counts its `content-height`
    // from this rather than from the last tile's own line, which is wrong the
    // moment a footprint pushes tiles into the holes beside it.
    in property <int> clips-grid-lines: 0;
    // The clip screen's selection (t260916-5568).
    in property <bool> clips-marquee-active;
    in property <int> clips-selection-count;
    in property <string> clips-confirm-title;
    in property <string> clips-confirm-lead;
    in property <string> clips-confirm-ok;

    in property <string> loaded-title;
    // The loaded recording's app icon for the title bar (2026-09-20); empty
    // when there is none to show.
    in property <image> loaded-icon;

    // ---------- the inline-edit overlay (task3640) ----------
    // Is any of the five inline editors open? One expression, in one place, and
    // every site folds into it -- the hole task3640 closes came from counting
    // the places a press could land, so the fix must not be a second list to
    // keep in step. The overlay below hangs on this.
    //
    // The two review states are read only while 確認 is the pane that is
    // showing: `ReviewVm` is a global, nothing resets a global when the pane
    // that filled it is destroyed, and leaving 確認 mid-rename would otherwise
    // leave the overlay standing over a pane with no editor in it.
    property <bool> inline-edit-open: root.sessions-editing-row >= 0
        || root.clips-editing-row >= 0
        || ((root.active-pane == 0 && root.session-loaded)
            && (ReviewVm.marker-editing || ReviewVm.clip-editing));

    // ---------- the one exception to it (task3860, user ruling 2026-09-09) ----------
    // True while the 確認 screen's 確定ステップ is the open editor and nothing
    // else is. In that one state the overlay below swaps its four-rectangle
    // frame for a six-rectangle one that leaves *two* holes: the track and the
    // panel's range block, on top of the field's own rect.
    //
    // Why: round19 §1 puts the range edit inside the confirm step -- task3860
    // deletes the 「範囲を編集」 toggle that used to own it -- so with the
    // frame as it stands there would be no way to move a boundary at all while
    // the step is open. The user chose this over exempting the step from the
    // overlay entirely, so the five other editors keep the 2026-09-08 ruling
    // untouched, and so does this one everywhere outside those two holes.
    //
    // Every editor flag is checked, not just the review pair: two editors open
    // at once is not a state this app produces, and if one ever appeared the
    // safe answer is the plain frame rather than a hole cut for the wrong one.
    property <bool> review-confirm-hole: root.inline-edit-open
        && ReviewVm.clip-editing
        && !ReviewVm.marker-editing
        && root.sessions-editing-row < 0
        && root.clips-editing-row < 0;

    // The panel band's edges, clamped to the panel's own visible rect. Held
    // here rather than inside the `if` below because an id declared in an `if`
    // cannot be read from a sibling, and both bands are read twice.
    property <length> confirm-band-top:
        Math.max(InlineEditVm.range-y, InlineEditVm.panel-y);
    property <length> confirm-band-bottom: Math.max(root.confirm-band-top,
        Math.min(InlineEditVm.field-y + InlineEditVm.field-h,
                 InlineEditVm.panel-y + InlineEditVm.panel-h));

    // Bumped on every press the overlay takes, and handed to `ReviewPane` as
    // its `dismiss-token`. The marker rename is the one editor whose state is
    // neither an `AppWindow` property nor a `ReviewVm` one that Rust owns, and
    // an element inside an `if` cannot be reached from out here -- so the ask
    // travels down as a binding instead.
    property <int> review-dismiss-token;

    // What a press on the overlay does: end whichever edit is open, through the
    // path that edit already had. Nothing here invents a new way to close an
    // editor -- `sessions-edit-cancelled` and `clips-edit-cancelled` are the
    // same `close_editor()` calls the panes' own ground areas raise.
    //
    // Each branch is guarded by its own flag so a press cannot fire four
    // no-op callbacks into Rust for the one editor that is actually open.
    function close-inline-edit() {
        if (root.sessions-editing-row >= 0) {
            root.sessions-edit-cancelled();
        }
        if (root.clips-editing-row >= 0) {
            root.clips-edit-cancelled();
        }
        if (ReviewVm.clip-editing) {
            ReviewVm.clip-cancelled();
        }
        if (ReviewVm.marker-editing) {
            root.review-dismiss-token += 1;
        }
    }

    callback sessions-pressed(length, length, length, length, int, bool, bool);
    callback sessions-marquee(length, length, length, length, length, length, int);
    callback sessions-marquee-ended();
    callback sessions-row-activated(length, length, length, length, int);
    callback sessions-row-menu-requested(length, length, length, length, int);
    callback sessions-menu-selected(int);
    callback sessions-menu-dismissed();
    callback sessions-search-changed(string);
    callback sessions-note-edit-selected();
    callback sessions-discard-selected();
    callback sessions-select-all();
    callback sessions-note-edit-requested(int);
    callback sessions-note-committed(int, string);
    callback sessions-edit-cancelled();
    /// The open inline editor's text, on every keystroke (task1340).
    callback sessions-edit-draft-changed(string);
    callback sessions-protect-toggled(int);
    // task2030 判断5: stop the recording this LIVE row is, and only it.
    callback sessions-stop-requested(int);
    callback sessions-set-view(bool);
    callback sessions-confirm-accepted();
    callback sessions-confirm-cancelled();
    callback sessions-visible-range-changed(int, int);

    callback titlebar-pressed();
    callback minimize-clicked();
    callback maximize-clicked();
    callback close-clicked();
    callback clips-row-menu-requested(int);
    callback clips-row-edit-requested(int);
    callback clips-grouping-changed(bool);
    // task3880, raised since task3890 by the tile's click, the expanded tile's
    // own click, and Esc. The handler behind it was already wired in Rust,
    // which is what kept 3890 to a `.slint` change.
    callback clips-row-expand-toggled(int);
    callback clips-search-changed(string);
    callback clips-menu-selected(int);
    callback clips-menu-dismissed();
    callback clips-visible-range-changed(int, int);
    callback clips-comment-committed(string);
    callback clips-edit-cancelled();
    callback clips-tile-pressed(int, length, length, length, length, bool, bool);
    callback clips-ground-pressed(length, length, length, length, bool, bool);
    callback clips-pointer-moved(length, length);
    callback clips-pointer-released();
    callback clips-delete-selected();
    callback clips-select-all();
    callback clips-selection-cleared();
    callback clips-confirm-accepted();
    callback clips-confirm-cancelled();

    // A rail item was pressed (the int is its index, 0..4, and not its place on
    // screen since キャプチャ (1) moved to the top, task t260913-b43e -- `rail_action`
    // decides whether that is a pane or the picker); and the two ways out of
    // the picker: Escape and a click outside the flyout (round21 §2-1 dropped
    // the close button).
    callback rail-clicked(int);
    callback picker-closed();

    // ---------- body: the rail, whichever pane it selected, and the bar ------
    // The picker floats above all of them (it is a modal over *any* pane), and
    // the toast floats above that, in the corner.
    //
    // This used to be the second half of a root `VerticalLayout` whose first
    // half was the title bar. round22 (task4370) made the bar an overlay inside
    // here instead, which left that layout with a single child, so it is gone
    // and this fills the window directly -- and the rail, which only ever lived
    // in the `HorizontalLayout` below, reaches the window's top edge as a
    // result. Written out rather than left to the default so the removal of the
    // layout is not load-bearing.
    Rectangle {
        width: 100%;
        height: 100%;
        // The window ground (round25 §4-1, t260919-ee8c): one `chrome-rail`
        // layer under the whole client, so the rail and the air around the
        // pane panel read as one continuous glass. The rail is transparent
        // over it and the panel is the one deliberate layer on top
        // (`Tokens.chrome-content`'s comment).
        background: Tokens.chrome-rail;

        // The glass (round25 §4-5, mock `.win`): a 135deg sheen, white 7 % at
        // the top-left fading to 2 % at 38 % and gone by 60 %, and a 1px inner
        // rim -- top 9 %, left 4 %, right 3 %, none at the bottom (the mock's
        // `inset` box-shadows; its outer shadows are DWM's to draw). Declared
        // before the layout so the rail's glyphs and the panel draw over them.
        // Shown maximized too -- part of the ground -- but not in full screen,
        // where the stage is the whole display.
        //
        // The rim sits one pixel in, not on the client's edge: the DWM frame
        // (`desktop.rs` `set_window_border_color`, #3a4048) is drawn *over* the
        // client's outermost pixel on this no-frame window, not outside it --
        // measured 2026-09-19 on the RTX 4070 / 1080p desk at dpi 96, client row 0 /
        // column 0 / the
        // last column read exactly #3a4048 with the rim underneath them
        // (t260919-ee8c evidence `measurements.txt`). The mock's `inset` rim is
        // likewise inside `.win`'s 1px border. `rim` is that pixel, as a length.
        property <length> rim: 1phx;
        if !root.any-fullscreen: Rectangle {
            background: @linear-gradient(135deg, #ffffff12 0%, #ffffff05 38%, #ffffff00 60%);
        }
        if !root.any-fullscreen: Rectangle {
            x: parent.rim;
            y: parent.rim;
            width: parent.width - 2 * parent.rim;
            height: 1px;
            background: #ffffff17;
        }
        if !root.any-fullscreen: Rectangle {
            x: parent.rim;
            y: parent.rim;
            width: 1px;
            height: parent.height - 2 * parent.rim;
            background: #ffffff0a;
        }
        if !root.any-fullscreen: Rectangle {
            x: parent.width - parent.rim - 1px;
            y: parent.rim;
            width: 1px;
            height: parent.height - 2 * parent.rim;
            background: #ffffff08;
        }

        HorizontalLayout {
            // Full screen takes the rail with it, the same way it takes the
            // title bar: the review pane gets the whole display (task152).
            if !root.any-fullscreen: Rectangle {
                width: Tokens.rail-width;
                // The agent-run mark (2026-09-13, the user): the rail is the
                // one chrome that is always on screen -- the title bar folds
                // itself away (task4370) -- so the whole strip changes colour
                // rather than growing a corner dot.
                // The user ruled on 2026-09-13 that the ground be a plainly
                // different colour -- a yellow -- rather than the warning
                // orange it borrowed, which read as one more accent. The two
                // tones live in `chrome-rail-agent` (t260913-c4db): pale in
                // light, olive in dark, because the rail's own glyphs and
                // labels flip with the theme. Every label on this ground is
                // >= 4.5:1; both the capture label and unselected
                // `RailButton` are on-surface-variant, whose tightest is
                // dark 4.85 (light 6.46) -- no label here is drawn in
                // primary (t260915-99d3; 4.98/5.61 is primary's own ratio
                // against this ground, for reference only).
                // Otherwise transparent: the window ground under it is
                // already `chrome-rail`, and a second copy here would stack
                // (round25 §4-1, t260919-ee8c).
                background: root.agent-run
                    ? Tokens.chrome-rail-agent
                    : transparent;

                // round21 §1-3: the "you are here" mark is one pill the rail
                // shares, sliding to whichever item `rail-current` names, the
                // way `SegmentTabs`' `indicator` does -- declared before the
                // layout so it paints under the buttons. It does not hide while
                // the picker is up (the round's `opacity:0`): the user ruled on
                // 2026-09-13 that it rises to キャプチャ instead, and
                // `rail_current` already reports 1 then (task t260913-17e1).
                // The ground goes up with it, the accent bar does not (user
                // ruling 2026-09-14) -- see the bar's own comment below.
                // No `absolute-position` (task148): y is counted from the
                // layout's own constants below, so they have to move together.
                Rectangle {
                    // `rail-current` is the index, not the place on screen:
                    // キャプチャ (1) heads the rail, then 確認 (0), 履歴 (2),
                    // クリップ (3); 設定 (4) sits at the foot.
                    property <int> slot: root.rail-current == 1
                        ? 0
                        : root.rail-current == 0 ? 1 : root.rail-current;
                    x: 4px;
                    // Top rows: padding, then one 54px button and a spacing
                    // per row -- plus the hairline (1px) and its own spacing
                    // between キャプチャ and everything under it. 設定 is
                    // counted from the bottom, so the stretch and the AGENT
                    // mark above it do not enter.
                    property <length> top-y: Tokens.space-2
                        + self.slot * (self.height + Tokens.space-1)
                        + (self.slot >= 1 ? 1px + Tokens.space-1 : 0px);
                    y: self.top-y;
                    width: 68px;
                    height: 54px;
                    border-radius: Tokens.shape-m;
                    background: Tokens.chrome-selected;

                    // One state per place, each sliding in, rather than a plain
                    // `animate y` (task t260913-0fbd). A plain `animate` runs on
                    // *every* change of y, so with 設定 current a maximize or
                    // restore moved the button at once and left the pill
                    // sliding after it for 260ms (measured: 32px behind 60ms
                    // after maximize). A transition's clock starts at the
                    // *state* change (i-slint-core `AnimatedBindingCallable`
                    // takes the state's `change_time` as `start_time`), so a
                    // height change long after the pill arrived finds the
                    // animation already over and lands at once, while a change
                    // of place still slides. Every place needs its own state:
                    // two places sharing one would be no state change, and the
                    // move between them would jump.
                    states [
                        at-capture when root.rail-current == 1: {
                            y: self.top-y;
                            in {
                                animate y {
                                    duration: 260ms;
                                    easing: Tokens.motion-curve;
                                }
                            }
                        }
                        at-review when root.rail-current == 0: {
                            y: self.top-y;
                            in {
                                animate y {
                                    duration: 260ms;
                                    easing: Tokens.motion-curve;
                                }
                            }
                        }
                        at-sessions when root.rail-current == 2: {
                            y: self.top-y;
                            in {
                                animate y {
                                    duration: 260ms;
                                    easing: Tokens.motion-curve;
                                }
                            }
                        }
                        at-clips when root.rail-current == 3: {
                            y: self.top-y;
                            in {
                                animate y {
                                    duration: 260ms;
                                    easing: Tokens.motion-curve;
                                }
                            }
                        }
                        at-settings when root.rail-current == 4: {
                            y: parent.height - Tokens.space-2 - self.height;
                            in {
                                animate y {
                                    duration: 260ms;
                                    easing: Tokens.motion-curve;
                                }
                            }
                        }
                    ]

                    // The round's `::before`: left -4px, top 13px, 2x28px.
                    // Not under キャプチャ (user ruling 2026-09-14): the pill
                    // brings its ground up there, but the accent bar is the
                    // tab grammar's "you are here", and the picker is not a
                    // place you are.
                    Rectangle {
                        visible: root.rail-current != 1;
                        x: -4px;
                        y: 13px;
                        width: 2px;
                        height: 28px;
                        background: Tokens.color-primary;
                    }
                }

                VerticalLayout {
                    padding-top: Tokens.space-2;
                    padding-bottom: Tokens.space-2;
                    spacing: Tokens.space-1;

                    // round21 §1-1: キャプチャ heads the rail, ruled off from
                    // the tabs under it. It still fires index 1 -- the order
                    // on screen is not the index, and `shell::rail_action` /
                    // `rail_current` keep 1 = the picker (task t260913-b43e).
                    //
                    // An ordinary `RailButton`, not a dress of its own (user
                    // ruling 2026-09-14, which withdrew the round's D7 raised
                    // card the same way the round had already withdrawn D10):
                    // what says "this one opens something" is the rule under it
                    // and the REC glyph, not a frame, a ground or a shadow.
                    HorizontalLayout {
                        alignment: center;
                        RailButton {
                            commands: Icons.capture;
                            fill-commands: Icons.capture-dot;
                            fill-commands-color: Tokens.color-rec-dot;
                            label: root.rail-capture-label;
                            current: root.rail-current == 1;
                            clicked => {
                                root.rail-clicked(1);
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 44px;
                            height: 1px;
                            background: Tokens.chrome-hairline;
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        RailButton {
                            commands: Icons.review;
                            fill-commands: Icons.review-fill;
                            label: root.rail-review-label;
                            current: root.rail-current == 0;
                            clicked => {
                                root.rail-clicked(0);
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        RailButton {
                            commands: Icons.sessions;
                            fill-commands: Icons.sessions-fill;
                            label: root.rail-sessions-label;
                            current: root.rail-current == 2;
                            clicked => {
                                root.rail-clicked(2);
                            }
                        }
                    }

                    // クリップ under 履歴 (task2980): the buffer, then what
                    // was cut out of it and kept.
                    HorizontalLayout {
                        alignment: center;
                        RailButton {
                            commands: Icons.clips;
                            label: root.rail-clips-label;
                            current: root.rail-current == 3;
                            clicked => {
                                root.rail-clicked(3);
                            }
                        }
                    }

                    // Settings sits at the foot, away from the four that
                    // are about the recording itself.
                    Rectangle { vertical-stretch: 1; }

                    // Deliberately not translated and deliberately not the
                    // folder: it is a mark for whoever is looking at the
                    // window, and the path it points at is one click away in
                    // 設定 (the buffer row resolves the override since 2026-09-13).
                    if root.agent-run: Text {
                        text: "AGENT";
                        horizontal-alignment: center;
                        font-size: 9px;
                        font-weight: 700;
                        letter-spacing: 0.5px;
                        // The badge wears the other theme's rail tone, so it
                        // reads at 11.73:1 on the ground either way.
                        color: Tokens.on-chrome-rail-agent;
                    }

                    HorizontalLayout {
                        alignment: center;
                        RailButton {
                            commands: Icons.settings;
                            weight: 2px;
                            label: root.rail-settings-label;
                            current: root.rail-current == 4;
                            clicked => {
                                root.rail-clicked(4);
                            }
                        }
                    }
                }

                // No divider on the right edge any more: round25 §4-5 dropped
                // it -- the panel's own frame is the edge now.

                // The rail's piece of the export block-out (task2130).
                if ReviewVm.export-busy: Rectangle {
                    background: #05070a8c;

                    TouchArea { }
                }
            }

            // The panel's margin box: no ground of its own, the window
            // ground shows through the margins and the count-line band.
            Rectangle {
                horizontal-stretch: 1;

                // The old in-pane footer used to close an open context menu
                // when a click landed on it (it never cleared selection --
                // t260919-ee8c's "no TouchArea" note below misread that as
                // the whole behavior). Restored here as its own area, sized
                // to the whole margin box: `panel`'s own subtree (the pane's
                // full-cover dismiss area, KNOWLEDGE "clip" note) claims
                // every point inside it first, so this is only ever reached
                // in the margins and the band outside `panel` (follow-up of
                // t260919-ee8c). `pointer-event`, not `clicked`, to close on
                // press like the pane's own dismiss areas do.
                if root.sessions-menu-open || root.clips-menu-open: TouchArea {
                    width: 100%;
                    height: 100%;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            if (root.sessions-menu-open) {
                                root.sessions-menu-dismissed();
                            }
                            if (root.clips-menu-open) {
                                root.clips-menu-dismissed();
                            }
                        }
                    }
                }

                panel := Rectangle {
                    x: 0;
                    y: root.panel-top + root.panel-drop;
                    width: parent.width - root.panel-right;
                    height: parent.height - root.panel-top - root.panel-bottom - root.panel-drop;
                    border-radius: root.panel-radius;
                    border-width: root.panel-border;
                    border-color: Tokens.chrome-panel-border;
                    background: Tokens.chrome-content;

                    // The pane sits inside the 1px frame, clipped by a
                    // rectangle of its own rather than by `panel`: `clip` on an
                    // element that also has a border cuts its children in by
                    // the border's width (KNOWLEDGE.md, t260916-a2a3), so the
                    // frame and the clip live on two elements. The radius is
                    // the frame's inner one, so the review pane's opaque
                    // right-hand detail panel loses its top- and bottom-right
                    // corners to the curve along with everything else.
                    Rectangle {
                        x: root.panel-border;
                        y: root.panel-border;
                        width: parent.width - 2 * root.panel-border;
                        height: parent.height - 2 * root.panel-border;
                        border-radius: Math.max(0px, root.panel-radius - root.panel-border);
                        clip: true;

                        // The pane itself does not move when the bar is out: this box
                        // steps back up by exactly what the panel stepped down, so its
                        // top stays at y 9 and the panel only cuts `panel-drop` off it
                        // (round25 §4-1: clip, never re-lay-out, t260919-fd3d).
                        Rectangle {
                            y: -root.panel-drop;
                            height: parent.height + root.panel-drop;

                            if root.active-pane == 0 && root.session-loaded: ReviewPane {
                                // Hands the review pane's FocusScope its key focus back
                                // when the picker closes: while it is open the modal's
                                // own FocusScope holds it, and slint drops focus rather
                                // than returning it on its own.
                                overlay-open: root.picker-open;
                                // task3640. Every bump is the overlay saying a press
                                // landed outside the marker rename field; the pane
                                // clears its own `editing-marker` on it.
                                dismiss-token: root.review-dismiss-token;
                            }

                            // round7 §2-6: a black stage, a waiting glyph and two
                            // lines. No click target -- the way in is the rail.
                            if root.active-pane == 0 && !root.session-loaded: ReviewEmpty { }

                            if root.active-pane == 1: SessionsPane {
                                rows: root.sessions;
                                thumbnail-view: root.sessions-thumbnail-view;
                                error-text: root.sessions-error-text;
                                empty-text: root.sessions-empty-text;
                                empty-sub-text: root.sessions-empty-sub-text;
                                no-sessions: root.sessions-no-sessions;
                                editing-row: root.sessions-editing-row;
                                editing-note: root.sessions-editing-note;
                                menu-entries: root.sessions-menu-entries;
                                menu-open: root.sessions-menu-open;
                                confirm-title: root.sessions-confirm-title;
                                confirm-lead: root.sessions-confirm-lead;
                                confirm-protected: root.sessions-confirm-protected;
                                pressed(x, y, top, cell, cols, shift, ctrl) => {
                                    root.sessions-pressed(x, y, top, cell, cols, shift, ctrl);
                                }
                                marquee(x1, y1, x2, y2, top, cell, cols) => {
                                    root.sessions-marquee(x1, y1, x2, y2, top, cell, cols);
                                }
                                marquee-ended => {
                                    root.sessions-marquee-ended();
                                }
                                row-activated(x, y, top, cell, cols) => {
                                    root.sessions-row-activated(x, y, top, cell, cols);
                                }
                                row-menu-requested(x, y, top, cell, cols) => {
                                    root.sessions-row-menu-requested(x, y, top, cell, cols);
                                }
                                menu-selected(index) => {
                                    root.sessions-menu-selected(index);
                                }
                                menu-dismissed => {
                                    root.sessions-menu-dismissed();
                                }
                                search-changed(query) => {
                                    root.sessions-search-changed(query);
                                }
                                discard-selected => {
                                    root.sessions-discard-selected();
                                }
                                select-all => {
                                    root.sessions-select-all();
                                }
                                note-edit-selected => {
                                    root.sessions-note-edit-selected();
                                }
                                note-edit-requested(row) => {
                                    root.sessions-note-edit-requested(row);
                                }
                                note-committed(row, note) => {
                                    root.sessions-note-committed(row, note);
                                }
                                edit-draft-changed(value) => {
                                    root.sessions-edit-draft-changed(value);
                                }
                                edit-cancelled => {
                                    root.sessions-edit-cancelled();
                                }
                                protect-toggled(row) => {
                                    root.sessions-protect-toggled(row);
                                }
                                stop-requested(row) => {
                                    root.sessions-stop-requested(row);
                                }
                                set-view(thumbnail) => {
                                    root.sessions-set-view(thumbnail);
                                }
                                confirm-accepted => {
                                    root.sessions-confirm-accepted();
                                }
                                confirm-cancelled => {
                                    root.sessions-confirm-cancelled();
                                }
                                visible-range-changed(first, count) => {
                                    root.sessions-visible-range-changed(first, count);
                                }
                            }

                            if root.active-pane == 2: SettingsPane { }

                            if root.active-pane == 3: ClipsPane {
                                rows: root.clips;
                                empty-text: root.clips-empty-text;
                                filter-empty-text: root.clips-filter-empty-text;
                                menu-entries: root.clips-menu-entries;
                                menu-open: root.clips-menu-open;
                                menu-row: root.clips-menu-row;
                                editing-row: root.clips-editing-row;
                                month-grouping: root.clips-month-grouping;
                                expanded-row: root.clips-expanded-row;
                                grid-lines: root.clips-grid-lines;
                                marquee-active: root.clips-marquee-active;
                                selection-count: root.clips-selection-count;
                                confirm-title: root.clips-confirm-title;
                                confirm-lead: root.clips-confirm-lead;
                                confirm-ok: root.clips-confirm-ok;
                                tile-pressed(index, x, y, cell-w, cell-h, shift, ctrl) => {
                                    root.clips-tile-pressed(index, x, y, cell-w, cell-h, shift, ctrl);
                                }
                                ground-pressed(x, y, cell-w, cell-h, shift, ctrl) => {
                                    root.clips-ground-pressed(x, y, cell-w, cell-h, shift, ctrl);
                                }
                                pointer-moved(x, y) => {
                                    root.clips-pointer-moved(x, y);
                                }
                                pointer-released => {
                                    root.clips-pointer-released();
                                }
                                delete-selected => {
                                    root.clips-delete-selected();
                                }
                                select-all => {
                                    root.clips-select-all();
                                }
                                selection-cleared => {
                                    root.clips-selection-cleared();
                                }
                                confirm-accepted => {
                                    root.clips-confirm-accepted();
                                }
                                confirm-cancelled => {
                                    root.clips-confirm-cancelled();
                                }
                                grouping-changed(month) => {
                                    root.clips-grouping-changed(month);
                                }
                                row-expand-toggled(index) => {
                                    root.clips-row-expand-toggled(index);
                                }
                                search-changed(query) => {
                                    root.clips-search-changed(query);
                                }
                                row-edit-requested(index) => {
                                    root.clips-row-edit-requested(index);
                                }
                                comment-committed(value) => {
                                    root.clips-comment-committed(value);
                                }
                                edit-cancelled => {
                                    root.clips-edit-cancelled();
                                }
                                row-menu-requested(index) => {
                                    root.clips-row-menu-requested(index);
                                }
                                menu-selected(index) => {
                                    root.clips-menu-selected(index);
                                }
                                menu-dismissed => {
                                    root.clips-menu-dismissed();
                                }
                                visible-range-changed(first, count) => {
                                    root.clips-visible-range-changed(first, count);
                                }
                            }
                        }
                    }
                }

                // ---------- the count line (round25 §4-2, mock `.clipfoot`) --
                // Outside the panel, on the window ground in the 32px band
                // under it: no fill and no rule, 26px tall in the band's middle
                // (the mock's `bottom:-29px` = 3px air above and below), 14px
                // side padding, 11px on-surface-variant. It used to be each
                // pane's own 32px `chrome-sidebar` strip with a hairline on top
                // (task242 / task3330); the gates come along unchanged.
                //
                // 履歴: gated like the toolbar -- absent with no sessions at
                // all, present when a search merely matched none. "0 件を表示
                // （0 B）" under the empty state is a tally of nothing, and the
                // mock has no history footer in any state -- its `empty` state
                // drops the list and the toolbar and leaves only the empty
                // block (`liveback-mock.html` `data-when="histempty"`). The
                // left half is the selection and is absent, not blank, with
                // nothing selected. `no-sessions`, not `empty-text`, for the
                // reason on `SessionsPane.no-sessions`.
                //
                // クリップ: gated on the same emptiness as the 週/月 switch --
                // the mock's `.clipfoot` carries `data-when="cliplist"` like
                // `.cliptools`, so at 0 clips `.clipempty` is `flex:1` over
                // the whole pane (task3330). `empty-text` only: a search that
                // matches nothing sets `filter-empty-text` instead, so the
                // tally stays while the query is up (task3820).
                //
                // No TouchArea of its own: the band is window ground like
                // the margins around the panel, and a press here is caught
                // by the margin box's own dismiss area above when a context
                // menu is open (follow-up of t260919-ee8c). Otherwise a
                // press here does nothing, same as the margins.
                if !root.any-fullscreen
                        && ((root.active-pane == 1 && !root.sessions-no-sessions)
                            || (root.active-pane == 3 && root.clips-empty-text == "")):
                    HorizontalLayout {
                        x: 0;
                        y: parent.height - root.panel-bottom + 3px;
                        width: parent.width - root.panel-right;
                        height: 26px;
                        padding-left: 14px;
                        padding-right: 14px;

                        Text {
                            text: root.active-pane == 1 ? root.sessions-footer-selected-text : "";
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            font-size: 11px;
                            color: Tokens.color-on-surface-variant;
                        }

                        Text {
                            text: root.active-pane == 1
                                ? root.sessions-footer-visible-text
                                : root.clips-footer-text;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            font-size: 11px;
                            color: Tokens.color-on-surface-variant;
                        }
                    }
            }
        }

        // ---------- target picker modal (task169 / task170) ----------
        // Absolutely-positioned sibling of the pane layout, so opening it
        // never re-solves the layout underneath. Its click-catcher stops at
        // the rail's right edge, so the rail stays live while it is open: a
        // rail item still switches the pane -- `show_pane` closes the picker on
        // the way. The title bar stays live only right of the panel: over the
        // panel's band its hot zone steps aside while the picker is open
        // (t260916-3e57 collapsed it whole; t260917-099c narrowed that to the
        // panel, see `tbhot` below), because the panel sits at y 9 and its top
        // 11px fell inside the 20px zone -- pointing at the flyout's own top
        // edge slid the bar out over it. Right of the panel the zone is back,
        // so the bar still slides out there and ─ □ ✕ stay reachable with the
        // picker open. The panel's width is `picker-dialog-width` at the root,
        // passed in so the zone and the panel read one formula.
        // The flyout itself is `picker_modal.slint` -- anchored beside the キャプチャ
        // (round21 §2-1), with a transparent click-catcher behind it rather
        // than a scrim, and not the generic overlay shell.
        if root.picker-open: PickerModal {
            width: 100%;
            height: 100%;
            dialog-width: root.picker-dialog-width;
            tiles: root.targets;
            tab-labels: root.picker-tab-labels;
            tab: root.picker-tab;
            error-text: root.targets-error-text;
            error-dismissible: root.targets-error-dismissible;
            error-dismiss-label: root.targets-error-dismiss-label;
            empty-text: root.targets-empty-text;
            empty-is-filter: root.targets-empty-is-filter;
            search-placeholder: root.search-placeholder;
            clear-label: root.clear-label;
            recording-label: root.recording-label;
            primary-label: root.picker-primary-label;
            capture-label: root.picker-capture-label;
            stop-label: root.picker-stop-label;
            capture-title: root.picker-capture-title;
            stop-title: root.picker-stop-title;
            opened => {
                root.picker-opened();
            }
            closed => {
                root.picker-closed();
            }
            tab-changed(index) => {
                root.picker-tab-changed(index);
            }
            search-changed(query) => {
                root.targets-search-changed(query);
            }
            error-dismissed => {
                root.targets-error-dismissed();
            }
            tile-clicked(id) => {
                root.target-clicked(id);
            }
        }

        // ---------- title bar: collapsed unless hovered (round22, task4370) --
        // Hidden in full screen (task152), along with the pane header and the
        // status bar: the review pane takes the whole display.
        //
        // round22 (`.agents/docs/design/round22-titlebar-collapse.md`, mock
        // `.tb` / `.tbhot`) took the bar out of the window's vertical stack and
        // made it an overlay that slides down from the top edge only while the
        // pointer is up there. Two consequences fall out of the move rather
        // than out of any new code: the rail is now full height (it is the only
        // thing left in the body's `HorizontalLayout`), and the pane below does
        // not reflow when the bar comes and goes.
        //
        // Declared after the picker, not before it (the mock's `.tb` 7 <
        // `.scrim` 20 no longer holds), so the bar draws over the picker while
        // it is out. The round22-era ask for the bar to slide out during target
        // selection too (this line landed 2026-09-14) holds again, but only
        // right of the panel: once the flyout moved up to y 9 and started
        // overlapping the hot zone, the user ruled on 2026-09-16 (t260916-3e57)
        // to keep the bar down over it, and on 2026-09-17 narrowed that to the
        // panel's rect alone (t260917-099c) -- while `picker-open`, `tbhot`
        // starts at the panel's right edge instead of the rail's. So a press
        // in the top 20px over the panel (and the 12px gap left of it, which
        // one TouchArea cannot keep) reaches the picker's catcher or the panel
        // itself; a press there right of the panel is eaten by `tbhot` again,
        // as it was before 3e57, with only the 20..32px band getting through
        // to the catcher. The toast and the drop overlay still draw over the
        // bar.
        //
        // `x` is `rail-width`, not `rail-width + 1px`. The mock's `.tb` says
        // `left:77px` and the task read that as 76 + a border, but the mock is
        // `box-sizing:border-box`, so its `.rail` is 76px *including* its
        // `border-right`. The rail has had no divider of its own since round25
        // §4-5 (t260919-ee8c: the panel's frame is the edge), so the lane
        // simply starts where the rail ends, at the panel's own x.
        if !root.any-fullscreen: tblane := Rectangle {
            // The lane the bar and its hot zone share: everything right of the
            // rail. No background and no touch area of its own -- it exists so
            // that `tbhot` and `tb` can be named from one another (an id inside
            // an `if` is invisible to siblings outside it -- which is also why
            // `hovered` and the grace `Timer` below live here and not on the
            // window).
            //
            // Whether a sensor currently has the pointer.
            property <bool> hovered: tbhot.has-hover || tbhover.has-hover;

            // `root.titlebar-out`: whether the bar is out. Read by the bar's
            // `y`, the hot zone's height and, since t260919-fd3d, the panel's
            // top edge (`panel-drop`). **Latched**, not `hovered` itself: the mock's
            // 0.3s exit delay used to live on the `out` transition, where it
            // parks the bar at whatever height it had reached when the pointer
            // left -- a flick across the top edge froze it half out for 0.3s
            // before it retracted (ユーザー報告 2026-09-13
            // 「一瞬ホバーして一瞬で離れると中途半端な位置で止まってしまう」).
            //
            // Moving the 0.3s here makes it a grace on the *state* instead of a
            // pause in the *motion*: the bar always finishes the slide it
            // started, re-entering inside the grace is free, and nothing ever
            // stops between the two ends. Reading `tb.y` in the transition's
            // `delay` would express this directly and is not available -- slint
            // calls it a binding loop (`tb.y -> delay -> tb.y`).
            //
            // Recreated on leaving full screen (the `if` above). No `init`
            // reset here any more: `root`'s own `changed any-fullscreen`
            // already cleared `titlebar-out` the moment full screen started,
            // so by the time this is rebuilt it is already retracted --
            // resetting it again here, after the rebuild, was one frame too
            // late and caused a drop-then-snap flicker on the way out
            // (follow-up of t260919-fd3d).
            changed hovered => {
                if (self.hovered) {
                    root.titlebar-out = true;
                }
            }

            // The grace. Only ever runs in the 0.3s after the pointer leaves, so
            // it costs nothing at rest -- which matters here, see KNOWLEDGE
            // 「装飾が1つでも動いていると静止画面でも present が出続ける」.
            Timer {
                interval: Tokens.titlebar-collapse-delay;
                running: root.titlebar-out && !tblane.hovered;
                triggered => {
                    root.titlebar-out = false;
                }
            }

            x: Tokens.rail-width;
            y: 0px;
            width: parent.width - Tokens.rail-width;
            // Bar-height, no clip. The lane used to be 48px taller and
            // clipping, to keep the bar's drop shadow off the rail (2026-09-16);
            // round25 §4-1 took the shadow away with the bar's fill
            // (t260919-fd3d). A retracted bar sits at y < 0, where the window's
            // own edge cuts it.
            height: Tokens.titlebar-height;

            // The hot zone, under the bar (declared first = lower z, mock
            // `.tbhot` z 6 against `.tb` z 7).
            //
            // 12px was the mock's number and **measured to be enough** (task4370
            // Step 3); `Tokens.titlebar-hot-zone` moved to 20px on 2026-09-13
            // (see its own comment in `tokens.slint`), one step out from that 12.
            // The task suspected the window's resize band -- 8 logical
            // px at dpi=96, `resize-band-width` -- would swallow the hover the
            // way it swallows presses (task4120, task4320) and leave 4px of
            // usable zone (at the original 12px). It does not: `i-slint-backend-winit-1.17.1`
            // `event_loop.rs:378` computes the resize direction from
            // `CursorMoved` and then stores the move in `pending_mouse_move`
            // unconditionally; only the *press* is swallowed, at `:431`. Measured
            // on the machine against the shipped bar: hovering the close button
            // at y=3 (inside the band) gives `IDC_HAND` and the hovered glyph
            // colour, exactly as y=10/16/20 do, while y=48 gives `IDC_ARROW` and
            // the resting colour. Evidence:
            // `.agents/tasks/evidence/4370-titlebar-collapse/`.
            //
            // This `TouchArea` does eat presses in its 20px -- the top 8 of
            // which the resize band was eating already, so the new cost is the
            // 12px between them (and the whole 20 while maximized, where there
            // is no band). Accepted: once the bar is out it covers all 32px, so
            // the only press that can fall through is one aimed during the
            // 0.24s slide.
            //
            // Two heights, not one (ユーザー報告 2026-09-13
            // 「たまにアニメーションがひっかかる」). `titlebar-hot-zone` is only
            // what it takes to *start* the reveal; the moment the bar is out it
            // becomes the bar's full height. Otherwise the band between the zone
            // (20px) and the bar belongs to no sensor for as long as the slide
            // lasts -- and a pointer that arrives at the top and keeps drifting
            // down, which is the ordinary way to reach ─ □ ✕, lands in it. The
            // state then drops mid-slide and the `out` transition's
            // `titlebar-collapse-delay` holds the bar frozen half out for 0.3s
            // before it retracts. That freeze is the 「ひっかかる」.
            //
            // Following the bar's *animated* bottom edge (`titlebar-height +
            // tb.y`) does not fix it: early in the slide that edge is still
            // above the pointer, which is exactly when the gap is widest. The
            // sensor has to jump to the bar's final rect on the first hover
            // frame, so `titlebar-out` is read here rather than any geometry.
            //
            // No binding loop: `has-hover` is set by the input system, not by a
            // binding, so `titlebar-out -> tbhot.height -> has-hover` is not a cycle
            // the compiler can see, and at runtime it is plain hysteresis --
            // the zone only ever grows while the pointer is already inside it.
            // While the target picker is open the zone starts at the panel's
            // right edge (t260917-099c; t260916-3e57 had collapsed it whole).
            // The flyout's panel sits at y 9, so its top 11px fell inside this
            // zone: arriving on the flyout's own top edge slid the bar out over
            // it (root/t260913-7ea7 measured 52 `barGlyphs` there against 0
            // parked). Only the panel's band is taken out -- right of it the
            // bar still slides out. The 12px gap between the rail and the panel
            // goes with the band: one TouchArea is one rect, and two would give
            // `titlebar-out`'s hysteresis two entrances. `x` is in `tblane`'s frame,
            // which already starts at the rail, so the panel's right edge is
            // `picker-rail-gap + picker-dialog-width` here, not `rail-width + …`.
            // The picker opens from a rail press, left of `tblane`, so
            // `tbhot.has-hover` is already false when it opens; a `titlebar-out`
            // still in its 0.3s grace simply retracts.
            tbhot := TouchArea {
                x: root.picker-open ? Tokens.picker-rail-gap + root.picker-dialog-width : 0px;
                y: 0px;
                width: parent.width - self.x;
                height: root.titlebar-out ? Tokens.titlebar-height : Tokens.titlebar-hot-zone;
            }

            // The bar itself: no fill and no shadow (round25 §4-1,
            // t260919-fd3d) -- only its glyphs, on the window ground the panel
            // steps down to uncover. Parked one pixel above the window when
            // retracted (the mock's `translateY(calc(-100% - 1px))`).
            //
            // A plain `animate`, not `states`: the states block existed to
            // animate the shadow alongside `y` in both directions, and with the
            // shadow gone the two directions are the same animation. The 0.3s
            // the mock writes as `transition-delay:.3s` is `titlebar-out`'s
            // grace, not a delay here. Same duration, curve and trigger as
            // `panel-drop`, so the bar and the panel's top edge move as one.
            tb := Rectangle {
                y: root.titlebar-out ? 0px : -(Tokens.titlebar-height + 1px);
                height: Tokens.titlebar-height;
                animate y {
                    duration: Tokens.titlebar-slide-duration;
                    easing: Tokens.motion-curve;
                }

                // One hover sensor for the whole bar, as an **ancestor** of
                // everything in it rather than a sibling. A sibling cannot do
                // this job: `CaptionButton` declares its own `TouchArea` later in z-order and wins
                // the hit test, so a sibling's `has-hover` goes false the
                // moment the pointer reaches X -- and the bar would retract
                // 0.3s later, taking the button the user was aiming at with it.
                // An ancestor does not have that problem:
                // `i-slint-core-1.17.1/items/input_items.rs` sets
                // `has_hover` in `input_event_filter_before_children`, which
                // runs down the whole chain before any child sees the event,
                // and returns `ForwardAndInterceptGrab` so the children still
                // get it. Presses are untouched: this area declares no
                // handlers, and its `input_event` is only reached when no
                // descendant took the event -- which never happens, since the
                // drag area below covers the bar.
                tbhover := TouchArea {
                    // Drag first, buttons on top: the caption buttons declare their own
                    // TouchArea later in z-order and win the hit test where they overlap.
                    TouchArea {
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                root.titlebar-pressed();
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-left: Tokens.space-3;
                        spacing: Tokens.space-2;

                        // Only 確認 with a session loaded names anything here: the
                        // recorded app's own icon and the session's name (the user,
                        // 2026-09-20). Every other pane leaves the bar to ─ □ ✕ -- no
                        // app icon, no "Liveback". The icon is absent, not a
                        // placeholder, when the recording has no executable (a
                        // monitor) or its image could not be found (`review.rs`
                        // `title_icon`). Plain text, no TouchArea: a press here is the
                        // drag above (the rename that lived here went 2026-09-19).
                        if root.active-pane == 0 && root.loaded-title != "" && root.loaded-icon.width > 0: Image {
                            source: root.loaded-icon;
                            width: 16px;
                            height: 16px;
                            // +1px: measured 2026-09-20 on a PrintWindow of the bar,
                            // the 16px box centred at y 16 while the 13px caps beside
                            // it centred at ~16.5 (Noto Sans JP's line box sits the
                            // Latin caps a touch low), so the icon read high.
                            y: (parent.height - self.height) / 2 + 1px;
                        }

                        if root.active-pane == 0 && root.loaded-title != "": Text {
                            text: root.loaded-title;
                            vertical-alignment: center;
                            overflow: elide;
                            font-size: 13px;
                            font-weight: 600;
                            color: Tokens.color-on-surface;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        // round8 §1: nothing but ─ □ ✕ lives at this end any more.
                        // The stop button that task810 put here is gone -- one slip
                        // beside the close box was too much to ask of it -- and the
                        // verb moved onto the stage as the LIVE capsule.
                        minimize-btn := CaptionButton {
                            commands: Icons.caption-minimize;
                            clicked => {
                                root.minimize-clicked();
                            }
                        }

                        CaptionButton {
                            commands: root.maximized ? Icons.caption-restore : Icons.caption-maximize;
                            clicked => {
                                root.maximize-clicked();
                            }
                        }

                        close-btn := CaptionButton {
                            commands: Icons.caption-close;
                            danger: true;
                            clicked => {
                                root.close-clicked();
                            }
                        }
                    }

                    // The export block-out reaches the title bar too (task2130): the
                    // mock dims the whole window. Last child, so it takes the drag area
                    // and the caption buttons it covers with it. The other two pieces
                    // are the rail's, below, and the review pane's -- see `review.slint`
                    // for why the cover is laid in pieces instead of one sheet.
                    //
                    // Minimize and close are deliberately left outside the cover
                    // (user decision 2026-08-28, a departure from the mock): a multi-GB
                    // export would otherwise hold the window hostage for its whole run,
                    // and the progress row's own ✕ is already the way to stop it. They
                    // are left *undimmed* on purpose -- bright reads as live, and a
                    // dimmed button that still works is the live-but-invisible target
                    // task194-B warned about, wearing the other mask. Everything else,
                    // maximize and the drag strip included, stays blocked.
                    if ReviewVm.export-busy: Rectangle {
                        x: 0;
                        width: minimize-btn.x;
                        background: #05070a8c;

                        TouchArea { }
                    }

                    // Runs from the minimize button all the way to the close button, so
                    // the layout `spacing` on either side of maximize cannot leak a
                    // window drag through an 8px seam.
                    if ReviewVm.export-busy: Rectangle {
                        x: minimize-btn.x + minimize-btn.width;
                        width: close-btn.x - (minimize-btn.x + minimize-btn.width);
                        background: #05070a8c;

                        TouchArea { }
                    }
                }
            }
        }

        // The stop confirmation that used to stand here is gone (task2030
        // 判断4 / round9 §1-5). Every stop -- capsule, history LIVE row,
        // picker LIVE tile, tray -- is immediate: what has been recorded is
        // kept, so it destroys nothing, and a mis-click costs one click to
        // undo. The stop toast is the feedback instead. The discard
        // confirmation in `sessions.slint` is a different dialog and stays.

        // ---------- threshold warning bar (task2030 判断2) ----------
        // A bar, not a gate: it says how many captures are running once
        // that reaches N and blocks nothing -- no button, no scrim, and
        // every control underneath it stays live. Declared before the toast
        // so a toast still draws over it, and gated on `if` rather than
        // opacity so there is no invisible strip taking clicks.
        //
        // On the target-selection screen only (round9 §1-2): warning where
        // the count is raised is the whole point, and it is bound to
        // `picker-open` for exactly that reason.
        if root.picker-open && root.targets-warning-count != "": Rectangle {
            y: parent.height - self.height;
            width: 100%;
            height: warn_row.preferred-height;
            background: Tokens.color-surface-container-high;
            // z-order is declaration order in slint; the picker modal above
            // is declared earlier, so this lands on top of it.
            warn_rule := Rectangle {
                y: 0;
                width: 100%;
                height: 1px;
                background: Tokens.chrome-hairline-strong;
            }

            warn_row := HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 12px;

                AppIcon {
                    commands: Icons.warning;
                    stroke-color: Tokens.color-warning;
                    size: 16px;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: root.targets-warning-count;
                    vertical-alignment: center;
                    font-size: 12px;
                    font-weight: 600;
                    color: Tokens.color-on-surface;
                }

                Text {
                    text: root.targets-warning-text;
                    vertical-alignment: center;
                    font-size: 12px;
                    color: Tokens.color-on-surface-variant;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }

        // ---------- toast (round5 3-C) ----------
        // Last child of the body, so it draws over the picker too: a failure
        // raised by something the modal did has to be visible from inside
        // it. Bottom-right, 20 / 18 from the edges.
        if root.toast-title != "": Toast {
            x: parent.width - self.width - 20px;
            y: parent.height - self.height - 18px;
            title: root.toast-title;
            detail: root.toast-detail;
            action: root.toast-action;
            variant: root.toast-variant == 2
                ? ToastVariant.error
                : root.toast-variant == 1
                    ? ToastVariant.success
                    : root.toast-variant == 3 ? ToastVariant.warning : ToastVariant.info;
            dismissed => {
                root.toast-dismissed();
            }
            action-clicked => {
                root.toast-action-clicked();
            }
        }
    }

    // ---------- the inline-edit overlay (task3640) ----------
    // While any inline edit is open, everything but the field itself is covered
    // by these four rectangles, and the first press on them ends the edit and
    // goes no further. **Being eaten is the ruling, not a defect** (user
    // decision 2026-09-08, 案 B of three): pressing a button while an editor is
    // open costs two clicks, the first to close and the second to act. Do not
    // "fix" that by letting the press through, and do not add an exception for
    // a widget that looks harmless -- either one puts the hole back.
    //
    // What the hole is for. Before this, a press ended an edit two ways: the
    // field blurred, or a pane's ground `TouchArea` caught it. A `Btn` /
    // `IconBtn` / `Switch` is on neither path -- a `TouchArea` takes no key
    // focus, and it swallows the press before any ground area under it sees it
    // -- so the editor simply stayed open behind whatever was clicked
    // (task3430's V2, measured on the machine). Counting those places and
    // patching each was 案 A, and it was rejected for the same reason: the next
    // widget puts the hole back.
    //
    // Four rectangles rather than one sheet with a hit test: a `TouchArea` that
    // is hit hides everything under it, so a single sheet would take the
    // presses *inside* the field too, and caret placement and drag-select would
    // die with them (task3430's V3). The frame leaves the field's own rect
    // genuinely uncovered, so it keeps its clicks without anyone forwarding
    // them.
    //
    // Laid at the window root, so `InlineEditVm`'s window coordinates are this
    // element's coordinates and nothing is subtracted from them -- the
    // subtraction is what put `settings.slint`'s language popup 294px off its
    // box.
    // 2026-09-09 (task3860), appended: `review-confirm-hole` above takes the
    // 確認 screen's 確定ステップ out of this frame and into the one below it.
    // Everything written above still describes this block and the four other
    // editors that keep using it.
    if root.inline-edit-open && !root.review-confirm-hole: Rectangle {
        width: 100%;
        height: 100%;

        // Above the field's y.
        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: Math.max(0px, InlineEditVm.field-y);
            TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.close-inline-edit();
                    }
                }
            }
        }

        // Below it.
        Rectangle {
            x: 0;
            y: InlineEditVm.field-y + InlineEditVm.field-h;
            width: 100%;
            height: Math.max(0px,
                root.height - (InlineEditVm.field-y + InlineEditVm.field-h));
            TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.close-inline-edit();
                    }
                }
            }
        }

        // Left of it, on the field's own band only -- the two above already
        // own everything off that band.
        Rectangle {
            x: 0;
            y: InlineEditVm.field-y;
            width: Math.max(0px, InlineEditVm.field-x);
            height: InlineEditVm.field-h;
            TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.close-inline-edit();
                    }
                }
            }
        }

        // Right of it.
        Rectangle {
            x: InlineEditVm.field-x + InlineEditVm.field-w;
            y: InlineEditVm.field-y;
            width: Math.max(0px,
                root.width - (InlineEditVm.field-x + InlineEditVm.field-w));
            height: InlineEditVm.field-h;
            TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.close-inline-edit();
                    }
                }
            }
        }
    }

    // ---------- the confirm step's widened hole (task3860) ----------
    // The same cover as above, cut for two live regions instead of one. It is
    // a separate `if` rather than more geometry inside that one: an id in an
    // `if` cannot be reached from a sibling, the two blocks share nothing but
    // `close-inline-edit()`, and keeping the five-editor frame literally
    // untouched is what makes "the 2026-09-08 ruling is unchanged for them"
    // checkable by reading rather than by tracing bindings.
    //
    // Built as two columns split at `panel-x`, because the two holes sit one
    // per column and a column split needs no assumption about how their y
    // ranges line up:
    //
    //   left  [0, panel-x]  -- everything but the track's band: 4 rectangles,
    //                          the same frame shape as above.
    //   right [panel-x, W]  -- everything but the range band: 2 rectangles,
    //                          since that band spans the panel's full width.
    //
    // The field's own rect needs no third hole: it is inside the range band by
    // construction (`review.slint` measures the band from the range block's
    // top to the field's bottom).
    //
    // Degenerate cases fall out rather than being special-cased. Panel shut →
    // `panel-x` is the window width, the right column is 0px wide and the left
    // one covers the window. Control bar not rendered → `review.slint` pushes
    // a zero track rect, the "above" rectangle collapses and the "below" one
    // covers the whole column from y=0.
    if root.review-confirm-hole: Rectangle {
        width: 100%;
        height: 100%;

        // --- stage column: above the track band.
        Rectangle {
            x: 0;
            y: 0;
            width: Math.max(0px, InlineEditVm.panel-x);
            height: Math.max(0px, InlineEditVm.track-y);
            TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.close-inline-edit();
                    }
                }
            }
        }

        // --- stage column: below it.
        Rectangle {
            x: 0;
            y: InlineEditVm.track-y + InlineEditVm.track-h;
            width: Math.max(0px, InlineEditVm.panel-x);
            height: Math.max(0px,
                root.height - (InlineEditVm.track-y + InlineEditVm.track-h));
            TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.close-inline-edit();
                    }
                }
            }
        }

        // --- stage column: left of it, on the band only. The letterbox beside
        // a track narrower than the stage belongs here, not in the hole: a
        // press there would otherwise reach the stage's own tap-to-play area
        // with the editor still open.
        Rectangle {
            x: 0;
            y: InlineEditVm.track-y;
            width: Math.max(0px, InlineEditVm.track-x);
            height: InlineEditVm.track-h;
            TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.close-inline-edit();
                    }
                }
            }
        }

        // --- stage column: right of it, up to the panel's edge.
        Rectangle {
            x: InlineEditVm.track-x + InlineEditVm.track-w;
            y: InlineEditVm.track-y;
            width: Math.max(0px,
                InlineEditVm.panel-x - (InlineEditVm.track-x + InlineEditVm.track-w));
            height: InlineEditVm.track-h;
            TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.close-inline-edit();
                    }
                }
            }
        }

        // --- panel column: above the range band.
        Rectangle {
            x: InlineEditVm.panel-x;
            y: 0;
            width: Math.max(0px, root.width - InlineEditVm.panel-x);
            height: Math.max(0px, root.confirm-band-top);
            TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.close-inline-edit();
                    }
                }
            }
        }

        // --- panel column: below it. The 指定フォルダに書き出し button lives
        // here and stays covered, which costs nothing: 裁定6 disables it while
        // the field is open anyway.
        Rectangle {
            x: InlineEditVm.panel-x;
            y: root.confirm-band-bottom;
            width: Math.max(0px, root.width - InlineEditVm.panel-x);
            height: Math.max(0px, root.height - root.confirm-band-bottom);
            TouchArea {
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.close-inline-edit();
                    }
                }
            }
        }
    }

    // ---------- .lvb drop (task870, round7 §2-13) ----------
    // Outside the layout above, and the last thing in the window, so it covers
    // the title bar too: the drop is taken anywhere on the window (task600), so
    // the mark that announces it has to reach as far.
    if DropVm.active: DropOverlay {
        width: 100%;
        height: 100%;
    }

}
